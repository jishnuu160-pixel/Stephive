<header class="navbar">
   <div class="logo">StepHyve</div>
    <nav class="nav-links" id="mainNavLinks">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/shop/men">Men</a>
        <a href="/shop/women">Women</a>
        <a href="/about">About</a>
    </nav>
    <div class="icons">
        <form action="/shop" method="GET" class="search-form">
            <input 
                type="text" 
                name="search" 
                placeholder="Search..." 
                value="{{searchValue}}"
                class="search-input"
            >
            <button type="submit" class="search-submit-btn">
                <img class="nav-icons" src="/icons/search (2).png" alt="Search">
            </button>
        </form>

        <img class="nav-icons" src="/icons/wishlist.png">
        
       <a href="/user/cart" class="cart-anchor-wrapper">
    <img class="nav-icons" src="/icons/cart.png">
    {{#if user}}
        {{#if globalCartCount}}
            <span class="cart-badge-count">{{globalCartCount}}</span>
        {{/if}}
    {{/if}}
</a>
      {{#if user}}
      <a href="/user/profile">
          <img class="nav-icons" src="/icons/user.png">
      </a>
      {{/if}}
    </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll("#mainNavLinks a");

    navLinks.forEach(link => {
        const hrefAttr = link.getAttribute("href");

        if (currentPath === hrefAttr) {
            link.classList.add("active-nav-link");
        } 
        else if (hrefAttr === "/shop" && currentPath.startsWith("/details")) {
            link.classList.add("active-nav-link");
        }
    });
});
</script>