<header class="navbar">
   <div class="logo">StepHyve</div>
    <nav class="nav-links" id="mainNavLinks">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/shop/men">Men</a>
        <a href="/shop/women">Women</a>
        <a href="/user/about">About</a>
    </nav>
    <div class="icons">
        <form action="/shop" method="GET" class="search-form">
            <input 
                type="text" 
                name="search" 
                placeholder="Search..." 
                value="{{searchValue}}"
                class="search-input"
            >
            <button type="submit" class="search-submit-btn">
                <img class="nav-icons" src="/icons/search (2).png" alt="Search">
            </button>
        </form>

        <!-- WISHLIST ICON: Redirects to login if guest, otherwise opens wishlist -->
        {{#if user}}
            <a href="/wishlist" class="wishlist-anchor-wrapper" style="position: relative; display: inline-block;">
        {{else}}
            <a href="/user/login" class="wishlist-anchor-wrapper" style="position: relative; display: inline-block;">
        {{/if}}
            <img class="nav-icons" src="/icons/wishlist.png" alt="Wishlist">
            <span id="globalWishlistBadge"
                  class="wishlist-badge-count"
                  style="display: {{#if user}}{{#if globalWishlistCount}}flex{{else}}none{{/if}}{{else}}none{{/if}};">
                {{globalWishlistCount}}
            </span>
        </a>
        
        <!-- CART ICON: Redirects to login if guest, otherwise opens cart -->
        {{#if user}}
            <a href="/cart" class="cart-anchor-wrapper" style="position: relative; display: inline-block;">
        {{else}}
            <a href="/user/login" class="cart-anchor-wrapper" style="position: relative; display: inline-block;">
        {{/if}}
            <img class="nav-icons" src="/icons/cart.png" alt="Cart">
            <!-- Fixed variable from globalCartCount to cartCount to align with middleware -->
            <span id="globalCartBadge" class="cart-badge-count" 
                  style="display: {{#if user}}{{#if cartCount}}flex{{else}}none{{/if}}{{else}}none{{/if}};">
                {{cartCount}}
            </span>
        </a>

        {{#if user}}
        <a href="/user/profile">
            <img class="nav-icons" src="/icons/user.png" alt="Profile">
        </a>
        {{/if}}
    </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll("#mainNavLinks a");

    navLinks.forEach(link => {
        const hrefAttr = link.getAttribute("href");

        if (currentPath === hrefAttr) {
            link.classList.add("active-nav-link");
        } 
        else if (hrefAttr === "/shop" && currentPath.startsWith("/details")) {
            link.classList.add("active-nav-link");
        }
    });
});

async function updateQuantity(productId, newQty, size = "M", variantId = null) {
    try {
        const response = await fetch('/user/cart/update-quantity', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                productId, 
                targetQuantity: newQty, 
                size: size,
                variantId: variantId
            })
        });

        if (response.status === 401 || response.status === 403) {
            window.location.href = "/user/login?error=session_expired";
            return;
        }

        const result = await response.json();

        if (result.success) {
            const totalElement = document.getElementById(`total-${productId}`);
            if (totalElement) totalElement.innerText = result.newProductTotal;
            
            if (window.updateGlobalCartCount) {
                window.updateGlobalCartCount(result.newGlobalCartCount || result.cartCount);
            }
        } else {
            alert(result.message || "Failed to alter cart count metric quantity.");
        }
    } catch (err) {
        console.error("Critical error while updating cart metrics:", err);
    }
}

window.updateGlobalCartCount = function(newCount) {
    const badge = document.getElementById('globalCartBadge');
    if (badge) {
        const count = Number(newCount) || 0;
        badge.innerText = count;
        badge.style.display = count > 0 ? 'flex' : 'none';
    }
};

window.updateGlobalWishlistCount = function(newCount) {
    const badge = document.getElementById("globalWishlistBadge");
    if (badge) {
        const count = Number(newCount) || 0;
        badge.innerText = count;
        badge.style.display = count > 0 ? "flex" : "none";
    }
};
</script>