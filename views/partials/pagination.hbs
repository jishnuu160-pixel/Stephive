<nav class="pagination-container">
    {{#if hasPrevPage}}
        <a href="/shop{{addParams queryParams prevPage}}" class="page-btn">« Previous</a>
    {{/if}}

    <span class="current-page">Page {{currentPage}} of {{totalPages}}</span>

    {{#if hasNextPage}}
        <a href="/shop{{addParams queryParams nextPage}}" class="page-btn">Next »</a>
    {{/if}}
</nav>