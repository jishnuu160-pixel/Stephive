<div class="product-card-gender">      
     <button class="wishlist-btn {{#if isWishlisted}}active{{/if}}" data-product-id="{{this._id}}">
           {{#if isWishlisted}}
                <i class="fa-solid fa-heart"></i>
           {{else}}
                <i class="fa-regular fa-heart"></i>
           {{/if}}
        </button>
    <div class="product-image">
        {{#if this.variants.[0].images.[0]}}
            <img src="{{this.variants.[0].images.[0]}}" alt="{{this.productName}}">
        {{else if this.productImage.[0]}}
            <img src="{{this.productImage.[0]}}" alt="{{this.productName}}">
        {{else}}
            <img src="/images/default-shoe.png" alt="Product Image">
        {{/if}}
    </div>
    
    <div class="product-info">
        <h3>{{this.productName}}</h3>
        <p class="product-card-desc">
            {{#if this.description}} {{this.description}}
            {{else if this.Category.name}} {{this.Category.name}} Fit
            {{else}} Premium Collection {{/if}}
        </p>    
    
        <div class="product-action-block">
            <!-- Pricing Section: Shows offer pricing ONLY when hasOffer is true -->
            <div class="product-pricing">
                {{#if this.hasOffer}}
                    <span class="offer-price" style="font-weight: 700; color: #111011; margin-right: 8px;">₹{{this.salePrice}}</span>
                    <span class="regular-price" style="text-decoration: line-through; color: #9ca3af; font-size: 0.9rem;">₹{{this.regularPrice}}</span>
                {{else}}
                    <span class="regular-price" style="font-weight: 700;">₹{{this.regularPrice}}</span>
                {{/if}}
            </div>

            <a href="/details/{{this._id}}" class="rec-discover-btn">
                <button type="button">DISCOVER MORE</button>
            </a>
        </div>
    </div>
</div>

<script>
    document.querySelector(".wishlist-btn").addEventListener("click", async function(){
    const btn = this;
    const productId = btn.dataset.productId;

    try {
        const response = await fetch("/wishlist/toggle", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId })
        });

        const data = await response.json();

        if (data.success) {
            btn.classList.toggle("active");
            const icon = btn.querySelector("i");
            const isNowActive = btn.classList.contains("active");

            if (isNowActive) {
                icon.classList.replace("fa-regular", "fa-solid");
                showToast("Added to wishlist", "success");
            } else {
                icon.classList.replace("fa-solid", "fa-regular");
                showToast("Removed from wishlist", "info");
            }

            if (window.updateGlobalWishlistCount) {
                window.updateGlobalWishlistCount(data.newCount);
            }
        }
    } catch (err) {
        console.error(err);
        showToast("Something went wrong", "error");
    }
});
 
</script>