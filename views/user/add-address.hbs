<div class="profile-page-container">
    <div class="profile-wrapper">

        <nav class="breadcrumb-container">
            <p class="breadcrumb">
                <a href="/user/profile">My Account</a>
                <span>/</span>
                <a href="/user/address">My Addresses</a>
                <span>/</span>
                <strong>Add New Address</strong>
            </p>
        </nav>

        <div class="profile-layout">

            {{> userSide}}

            <main class="profile-main">

                <div class="page-header">
                    <h1>Add New Address</h1>
                </div>

                <div class="address-form-wrapper">

                    {{#if error}}
                        <div class="form-error">
                            {{error}}
                        </div>
                    {{/if}}

                    <form action="/user/add-address" method="POST">

                        <div class="form-row">
  
                            <div class="form-group">
                                <label>Full Name</label>
                                <input
                                    type="text"
                                    name="fullName"
                                    value="{{formData.fullName}}"
                                >
                                   {{#if errors.fullName}}
                                    <span class="field-error">
                                      {{errors.fullName}}
                                    </span>
                                   {{/if}}
                            </div>

                            <div class="form-group">
                                <label>Mobile Number</label>
                                <input
                                    type="text"
                                    name="phone"
                                    value="{{formData.phone}}"
                                >
                                 {{#if errors.phone}}
                                      <span class="field-error">
                                       {{errors.phone}}
                                  </span>
                             {{/if}}
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Address Line 1</label>
                            <input
                                type="text"
                                name="street"
                                value="{{formData.street}}"
                            >
                             {{#if errors.street}}
                             <span class="field-error">
                               {{errors.street}}
                            </span>
                            {{/if}}
                        </div>

                        <div class="form-group">
                            <label>Address Line 2 (Optional)</label>
                            <input
                                type="text"
                                name="apartment"
                                value="{{formData.apartment}}"
                            >
                        </div>

                        <div class="form-row three-col">
                            <div class="form-group">
                                <label>City</label>
                                <input
                                    type="text"
                                    name="city"
                                    value="{{formData.city}}"
                                >
                                 {{#if errors.city}}
                                 <span class="field-error">
                                  {{errors.city}}
                                 </span>
                            {{/if}}
                            </div>

                            <div class="form-group">
                                <label>State</label>
                                <input
                                    type="text"
                                    name="state"
                                    value="{{formData.state}}"
                                >
                                 {{#if errors.state}}
                                 <span class="field-error">
                                  {{errors.state}}
                                 </span>
                             {{/if}}
                            </div>

                            <div class="form-group">
                                <label>Pincode</label>
                                <input
                                    type="text"
                                    name="pincode"
                                    value="{{formData.pincode}}"
                                >
                                {{#if errors.pincode}}
                              <span class="field-error">
                                {{errors.pincode}}
                                  </span>
                            {{/if}}
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Address Type</label>

                            <div class="type-selection">
                                <label class="type-chip">
                                    <input
                                        type="radio"
                                        name="label"
                                        value="Home"
                                        {{#unless formData.label}}checked{{/unless}}
                                        {{#if (eq formData.label "Home")}}checked{{/if}}
                                    >
                                    <span>Home</span>
                                </label>

                                <label class="type-chip">
                                    <input
                                        type="radio"
                                        name="label"
                                        value="Office"
                                        {{#if (eq formData.label "Office")}}checked{{/if}}
                                    >
                                    <span>Office</span>
                                </label>

                                <label class="type-chip">
                                    <input
                                        type="radio"
                                        name="label"
                                        value="Other"
                                        {{#if (eq formData.label "Other")}}checked{{/if}}
                                    >
                                    <span>Other</span>
                                </label>
                            </div>
                        </div>

                        <div class="default-check">
                            <input
                                type="checkbox"
                                id="isDefault"
                                name="isDefault"
                                {{#if formData.isDefault}}checked{{/if}}
                            >
                            <label for="isDefault">
                                Make this my default address
                            </label>
                        </div>

                        <div class="form-actions">
                            <a href="/user/address" class="btn-cancel">
                                Cancel
                            </a>

                            <button type="submit" class="btn-address-save">
                                Save Address
                            </button>
                        </div>

                    </form>
                </div>

            </main>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('input', function () {
        const error = this.parentElement.querySelector('.field-error');

        if (error) {
            error.remove();
        }
    });
});
</script>