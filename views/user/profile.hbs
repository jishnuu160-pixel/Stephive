<div class="profile-page-container">
    <div class="profile-wrapper">
        <nav class="breadcrumb-container">
            <p class="breadcrumb">My Account <span class="divider">/</span> <strong>Profile</strong></p>
        </nav>
        
        <div class="profile-layout">
            
            {{> userSide}} 

            <main class="profile-main">
                
                <section class="profile-card profile-info-summary">
                    <div class="avatar-edit-container">
                        <form action="/user/update-avatar" method="POST" enctype="multipart/form-data" id="avatarForm">


                       <div class="avatar-border">
                         <img src="{{user.profileImage}}?v={{timestamp}}" id="profile-preview"
  class="user-icon sidebar-avatar" 
  >
                                 
                            <label for="avatar-upload" class="camera-btn">
                                <i class="fa-solid fa-camera"></i>
                                <input type="file" id="avatar-upload" name="profileImage" hidden accept="image/*">
                            </label>
                        </div>
                        </form>
                    </div>
                    <div class="summary-text">
                        <h2>{{user.fullName}}</h2>
                        <p class="user-email-label">{{user.email}}</p>
                    </div>
                </section>

                <section class="profile-card profile-details">
                    <div class="card-header">
                        <h3><img src="/icons/information-icon.png" class="section-icon"> Personal Information</h3>
                    </div>
                    
                    <form id="profile-form" action="/user/update-profile" method="POST" class="form-grid">
                        <div class="input-group">
                            <label>FULL NAME</label>
                            <input type="text" name="fullName" value="{{user.fullName}}" disabled>
                        </div>

                        <div class="input-group">
                            <label>EMAIL ADDRESS</label>
                            <input type="email" value="{{user.email}}" readonly class="readonly-input">
                        </div>

                        <div class="input-group">
                            <label>PHONE NUMBER</label>
                            <input type="text" name="phone" value="{{user.phoneNumber}}" disabled>
                        </div>

                        <div class="input-group">
                            <label>GENDER</label>
                            <select id="genderSelect" name="gender" class="custom-select" disabled>
                                {{#unless user.gender}}
                                    <option value="" disabled selected>Not Specified</option>
                                {{/unless}}
                                <option value="Male" {{#if (eq user.gender 'Male')}}selected{{/if}}>Male</option>
                                <option value="Female" {{#if (eq user.gender 'Female')}}selected{{/if}}>Female</option>
                                <option value="Other" {{#if (eq user.gender 'Other')}}selected{{/if}}>Other</option>
                            </select>
                        </div>
                        
                        <div class="input-group">
                            <label>REFERRAL CODE</label>
                            <div class="referral-wrapper">
                                <input type="text" name="referralCode" value="{{user.referralCode}}" readonly class="readonly-input referral-input">
                            </div>
                        </div>
                    
                        <div class="form-footer">
                            <a href="/user/edit-profile" class="btn-outline"><img src="/icons/edit-profile.png" class="edit-profile">Edit Profile</a>
                            <a href="/user/send-email-change-otp" class="btn-outline"><img src="/icons/email.png" class="edit-profile"> Change Email</a>
                        </div>
                    </form>
                </section>

            </main> 
        </div>
    </div>
</div>

<div id="cropperModal" class="crop-modal-overlay" style="display: none;">
    <div class="crop-modal-content">
        <h3>Crop Profile Picture</h3>
        <div class="crop-area" style="width: 100%; max-height: 350px; background: #f1f5f9;">
            <img id="image-to-crop" src="" style="max-width: 100%; display: block;">
        </div>
        <div class="crop-modal-actions">
            <button type="button" id="cancelCropBtn" class="btn-cancel">Cancel</button>
            <button type="button" id="saveCropBtn" class="btn-save">Crop & Save</button>
        </div>
    </div>
</div>


{{#if success}}
<div class="flash success">{{success}}</div>
{{/if}}

{{#if error}}
<div class="flash error">{{error}}</div>
{{/if}}


<script>
    document.getElementById("avatar-upload").addEventListener("change", async function () {

    const formData = new FormData(document.getElementById("avatarForm"));

    const res = await fetch("/user/update-avatar", {
        method: "POST",
        body: formData
    });

    const data = await res.json();

    if (data.success) {

        const img = document.getElementById("profile-preview");

        img.src = data.profileImage + "?t=" + Date.now();

        showFlash("success", data.message);

    } else {
        showFlash("error", data.message);
    }
});
</script>

<style>
/* 🟢 Modal Background Overlay */
.crop-modal-overlay {
    position: fixed;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    background: rgba(0, 0, 0, 0.75) !important; /* Slightly darker glass effect */
    display: flex; 
    align-items: center; 
    justify-content: center;
    z-index: 99999 !important; /* Keep it above all headers/sidebars */
}

/* 🟢 Modal Content Box Card */
.crop-modal-content {
    background: #ffffff !important; /* Strict solid white background card */
    color: #1e293b !important;    /* Dark slate text color for readability */
    padding: 20px; 
    border-radius: 12px;
    max-width: 400px; 
    height: 430px;
    width: 90%; 
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.crop-modal-content h3 {
    margin-top: 0;
    margin-bottom: 16px;
    font-size: 18px;
    font-weight: 600;
    color: #0f172a !important;
}

/* 🟢 The Canvas Frame Container where the photo sits */
.crop-area { 
    max-height: 280px; 
    height: 280px;
    width: 100%; 
    overflow: hidden; 
    background: #f8fafc !important; /* Ultra-light grey inside background mesh */
    border: 1px solid #e2e8f0;
    border-radius: 8px; 
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Ensure the image scales neatly within the layout grid */
.crop-area img { 
    max-width: 100%; 
    max-height: 100%; 
    display: block; 
}

/* Action Control Buttons Layout */
.crop-modal-actions { 
    display: flex; 
    justify-content: flex-end; 
    gap: 12px; 
    margin-top: 20px; 
}

.btn-cancel { 
    background: #f1f5f9 !important; 
    color: #475569 !important; 
    border: 1px solid #cbd5e1 !important; 
    padding: 8px 10px;
    border-radius: 6px; 
    font-weight: 500;
    font-size: 12px;
    cursor: pointer; 
    transition: background 0.2s;
}
.btn-cancel:hover {
    background: #e2e8f0 !important;
}

.btn-save { 
    background: #004d40 !important; /* Premium dark teal branding theme */
    color: #ffffff !important; 
    border: none !important; 
    padding: 8px 10px; 
    border-radius: 6px;
    font-size: 12px; 
    font-weight: 500;
    cursor: pointer; 
    transition: background 0.2s;
}
.btn-save:hover {
    background: #00332c !important;
}
</style>

