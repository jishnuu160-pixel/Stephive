


<!-- Hero Section -->
<section class="hero">

    <!-- Login Box -->
    <div class="signin-box">
        <h2>Sign in to your account</h2>
        <h6>Enter valid email to proceed.</h6>
        
         {{#if error}}
          <p style="color:red">{{error}}</p>
        {{/if}}

        {{#if success}}
        <p style="color:green">{{success}}</p>
       {{/if}}
        <form action="/user/login" method="post">
        <label>Email</label>
        <input type="email" name="email" placeholder="Email Address">

        <div class="password-container">
            <label>Password</label>
            <input type="password" name="password" id="password" placeholder="Password">
            <i class="fas fa-eye" id="togglePassword"></i>
        </div>

        <a href="#" class="forgot">forgot?</a>

        <button class="signin-btn">Sign In</button>

        <p class="signup-text">
            Don’t have an account? <a href="/signup">Sign up</a>
        </p>

        <div class="continue-text">OR CONTINUE WITH</div>

        <button class="google-btn">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" class="google-icon"></i> Google
        </button>
        </form>
    </div>

    <!-- Right Text -->
    <div class="right">
        <h1>Join the movement, one step at a time.</h1>
        <p>Your next pair of kicks awaits.</p>
    </div>

</section>


<script>
const togglePassword = document.getElementById("togglePassword");
const password = document.getElementById("password");

togglePassword.addEventListener("click", () => {
    const type = password.type === "password" ? "text" : "password";
    password.type = type;
    togglePassword.classList.toggle("fa-eye-slash");
});

    if (window.location.search) {
        window.history.replaceState({}, document.title, "/user/login");
    }

</script>