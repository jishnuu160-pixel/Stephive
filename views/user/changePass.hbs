<section class="reset-hero">
    <div class="reset-box">
        <h2>CHANGE PASSWORD</h2>
        <p>Enter your current password and choose a new password.</p>

        <div id="js-error-message" style="color: #ff4d4d; text-align: center; margin-bottom: 10px; display: none; font-size: 0.9rem;">
        </div>

        {{#if error}}
            <p class="server-error" style="color: #ff4d4d; text-align: center; margin-bottom: 10px;">
              {{error}}
            </p>
        {{/if}}

        <form action="/user/changepass" method="POST" id="changePasswordForm" novalidate>
            <label>CURRENT PASSWORD</label>
            <div class="input-box">
                <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter current password">
                 <span class="eye" data-target="currentPassword"> 👁</span>
            </div>

            <label>NEW PASSWORD</label>
            <div class="input-box">
                <input type="password" name="password" id="password" placeholder="Enter new password" >
                 <span class="eye" data-target="password"> 👁 </span>
            </div>


            <label>CONFIRM NEW PASSWORD</label>
            <div class="input-box">
                <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm new password">
                 <span class="eye" data-target="confirmPassword"> 👁</span>
            </div>


            <button type="submit" class="update-btn">
                UPDATE PASSWORD
            </button>

            <a href="/user/profile" class="back-link">
                ← BACK TO PROFILE
            </a>
        </form>
    </div>
</section>


<script>
document.addEventListener('DOMContentLoaded', () => {

    const form = document.getElementById('changePasswordForm');
    const currentPassword =document.getElementById('currentPassword');
    const password =document.getElementById('password');
    const confirmPassword =document.getElementById('confirmPassword');
    const errorMessage =document.getElementById('js-error-message');
    const eyes = document.querySelectorAll('.eye');

    eyes.forEach((eye) => {
        eye.addEventListener('click', () => {

            const targetId = eye.dataset.target;
            const input = document.getElementById(targetId);

            if (input.type === 'password') {
                input.type = 'text';
                eye.textContent = '👁';
            } else {
                input.type = 'password';
                eye.textContent = '👁';
            }

        });

    });


    form.addEventListener('submit', (e) => {

        const currentPasswordValue =currentPassword.value.trim();
        const passwordValue = password.value.trim();
        const confirmPasswordValue = confirmPassword.value.trim();

        errorMessage.textContent = '';
        errorMessage.style.display = 'none';

        if (!currentPasswordValue ||!passwordValue ||!confirmPasswordValue
        ) {
            e.preventDefault();

            errorMessage.textContent ='Please fill in all password fields.';
            errorMessage.style.display = 'block';

            return;
        }


        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,}$/;

        if (!passwordRegex.test(passwordValue)) {
            e.preventDefault();

            errorMessage.textContent ='New password must be at least 8 characters and include uppercase, lowercase, number, and symbol.';
            errorMessage.style.display = 'block';

            password.focus();
            return;
        }


        if (currentPasswordValue === passwordValue) {
            e.preventDefault();

            errorMessage.textContent ='New password cannot be the same as your current password.';
            errorMessage.style.display = 'block';

            password.focus();
            return;
        }


        if (passwordValue !== confirmPasswordValue) {
            e.preventDefault();

            errorMessage.textContent ='New password and confirm password do not match.';
            errorMessage.style.display = 'block';

            confirmPassword.focus();

            return;
        }

    });

    const eyes = document.querySelectorAll('.eye');

eyes.forEach((eye) => {

    eye.addEventListener('click', () => {

        const targetId = eye.dataset.target;
        const input = document.getElementById(targetId);

        if (input.type === 'password') {
            input.type = 'text';
            eye.textContent = '👁';
        } else {
            input.type = 'password';
            eye.textContent = '👁';
        }
    });
});
});
</script>