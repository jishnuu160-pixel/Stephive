<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Arial', sans-serif; padding: 40px; }
        .invoice-box { border: 1px solid #eee; padding: 20px; max-width: 800px; margin: auto; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        .total-row { font-weight: bold; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <h2>Invoice #{{order.orderId}}</h2>
        <p><strong>Customer:</strong> {{order.user_id.fullName}}</p>
        <p><strong>Shipping Address:</strong><br>
           {{order.deliveryAddress.fullName}}<br>
           {{order.deliveryAddress.addressLine1}},<br>{{order.deliveryAddress.state}}
            {{order.deliveryAddress.city}} - {{order.deliveryAddress.pincode}}<br>
            <p><strong>MobileNumber:</strong> {{order.deliveryAddress.mobileNumber}}
        </p>

        <table>
            <tr><th>Product</th><th>Size</th><th>Qty</th><th>Price</th><th>Total</th></tr>
            {{#each order.items}}
            <tr>
                <td>{{this.productName}}</td>
                <td>{{this.size}}</td>
                <td>{{this.quantity}}</td>
                <td>₹{{this.price}}</td>
                <td>₹{{multiply this.price this.quantity}}</td>
            </tr>
            {{/each}}
        </table>

        <div style="text-align: right;">
            <p>Subtotal: ₹{{order.subtotal}}</p>
            <p>Discount: -₹{{order.discount}}</p>
            <p>Tax: ₹{{order.tax}}</p>
            <h3>Final Amount: ₹{{order.finalAmount}}</h3>
            <p>Payment Method: {{order.paymentMethod}}</p>
        </div>
    </div>
</body>
</html>