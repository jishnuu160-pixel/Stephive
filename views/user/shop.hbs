<div class="shop-container">
    {{#if searchValue}}
     <p><a href="/shop" class="back-to-shop">⬅ Back to Shop</a></p>
        <header class="hero-section">
            <div class="hero-content">
                <h1>Search Results For "{{searchValue}}"</h1>
            </div>
        </header>
    {{else}}
        <header class="hero-section">
            <div class="hero-content">
                <h1>Shop the latest Sneakers</h1>
                <p>Discover Your Next Favorite Pair</p>
            </div>
        </header>
    {{/if}}

    <div class="shop-main-layout">
        <aside class="sidebar-wrapper">
            {{> filter-sidebar}}
        </aside>

        <main class="products-main">
            {{#if searchValue}}
                <div class="search-results-page">
                    <div class="products-wrapper-grid-search">
                        {{#each products}}
                            {{> product-card}}
                        {{else}}
                            <div class="no-products">
                                <p>No sneakers found matching "{{searchValue}}"</p>
                            </div>
                        {{/each}}
                    </div>
                    {{> pagination currentPage=currentPage totalPages=totalPages hasPrevPage=hasPrevPage hasNextPage=hasNextPage queryParams=queryParams}}
                </div>
            {{else}}
                <div class="products-wrapper-grid-shop">
                    {{#each products}}
                        {{> product-card}}
                    {{else}}
                        <p class="no-products">No products available.</p>
                    {{/each}}
                </div>
                {{> pagination currentPage=currentPage totalPages=totalPages hasPrevPage=hasPrevPage hasNextPage=hasNextPage queryParams=queryParams}}
            {{/if}}
        </main>
    </div>

    {{#unless searchValue}}
        <section class="best-sellers">
            <h3>Latest Shoes</h3>
            <div class="best-sellers-shelf-grid">
                {{#each latestSellers}}
                    {{> product-card}}
                {{else}}
                    <p>No products available right now.</p>
                {{/each}}
            </div>       
        </section>
    {{/unless}}
</div>

