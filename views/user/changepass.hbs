<section class="reset-hero">

    <div class="reset-box">
         <form action="/user/reset-password" method="POST" id="changePasswordForm">
    <input type="hidden" name="email" value="{{email}}">

        <h2>SET NEW PASSWORD</h2>
        <p>Enter your new credentials to access your vault.</p>

        <!-- New Password -->
        <label>NEW PASSWORD</label>
        <div class="input-box">
            <input type="password" name="password" placeholder="Enter password">
            <span class="eye">👁</span>
        </div>

        <!-- Confirm Password -->
        <label>CONFIRM PASSWORD</label>
        <div class="input-box">
            <input type="password" name="confirmPassword" placeholder="Confirm password">
            <span class="eye">👁</span>
        </div>

        <button type="submit" class="update-btn">UPDATE PASSWORD</button>
  </form>
        <a href="{{#if isLoggedIn}}/user/profile{{else}}/user/login{{/if}}" class="back-link">
    ← BACK TO {{#if isLoggedIn}}PROFILE{{else}}LOGIN{{/if}}
</a>

    </div>

</section>


