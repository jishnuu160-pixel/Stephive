<div class="profile-page-container">
    <div class="profile-wrapper">
        <nav class="breadcrumb-container">
            <p class="breadcrumb">My Account <span class="divider">/</span> <strong>My Addresses</strong></p>
        </nav>

        <div class="profile-layout">
            
            {{> userSide}} 

            <main class="profile-main">
                <div class="page-header">
                    <div class="header-titles">
                        <h1>My Addresses</h1>
                        <p>Manage your saved delivery addresses</p>
                    </div>

                    
                    <a href="/user/add-address" class="btn-add-address">
                      + Add New Address
                    </a>
                </div>

                <div class="address-container">
                    {{#each user.addresses}}
                        <div class="address-card">
                            <div class="card-header">
                                <span class="badge-label">{{this.label}}</span>
                                
                                <div class="action-icons">
                                    <a href="/user/edit-address/{{this._id}}">
    <img src="/icons/edit.png"
         alt="edit"
         class="icon-small">
</a>
                                        
                                    
                                    <a href="/user/delete-address/{{this._id}}" class="delete-address">
                                      <img src="/icons/delete.png" alt="delete" class="icon-small">
                                  </a>
                                </div>
                            </div>

                            <div class="card-content">
                                <h3>{{this.fullName}}</h3>
                                <p>{{this.street}}</p>
                                {{#if this.apartment}}<p>{{this.apartment}}</p>{{/if}}
                                <p>{{this.city}}, {{this.state}} - {{this.pincode}}</p>
                            </div>

                            <div class="card-footer">
                                <div class="phone-info">
                                    <img src="/icons/phone.png" alt="phone" class="icon-tiny">
                                    <span>{{this.phone}}</span>
                                </div>
                                {{#if this.isDefault}}
                                    <span class="default-badge">Default</span>
                                {{/if}}
                            </div>
                        </div>
                    {{else}}
                        <div class="no-address">
                            <p>No addresses found. Click "Add New Address" to get started.</p>
                        </div>
                    {{/each}}
                </div>
            </main>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('.delete-address').forEach(link => {

    link.addEventListener('click', function(e) {

        e.preventDefault();

        const url = this.href;

        Swal.fire({
            title: 'Delete Address?',
            text: 'Are you sure you want to delete this address?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#dc2626'
        }).then((result) => {

            if (result.isConfirmed) {
                window.location.href = url;
            }

        });

    });

});
</script>