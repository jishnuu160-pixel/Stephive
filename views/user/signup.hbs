<section class="signup-section">
  <div class="signup-container">
    
    <div class="signup-card">
      <h2>Create Your Account</h2>
      <p class="subtitle">Experience the future of technology today.</p>

   {{#if error_msg}}
   <p class="server-error" style="color: #ff4d4d; text-align: center; margin-bottom: 10px;">{{error_msg}}</p>
   {{else if error}}
   <p class="server-error" style="color: #ff4d4d; text-align: center; margin-bottom: 10px;">{{error}}</p>
   {{/if}}
      <div id="js-error-message" style="color: #ff4d4d; text-align: center; margin-bottom: 10px; display: none; font-size: 0.9rem;"></div>

      <form action="/user/signup" id="signupForm" method="post" novalidate>

        <div class="form-row-s">
          <div class="form-group-s">
            <label>Full Name <span class="star">*</span></label>
            <input type="text" id="fullName" name="fullName" value="{{formData.fullName}}">
            <small id="fullNameError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.fullName}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.fullName}}
            </small>          
            </div>

          <div class="form-group-s">
            <label>Email Address <span class="star">*</span></label>
            <input type="email" id="email" name="email" value="{{formData.email}}">
            <small id="emailError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.email}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.email}}
            </small>          
          </div>
        </div>

        <div class="form-row-s">
          <div class="form-group-s">
            <label>Phone Number <span class="star">*</span> </label>
            <input type="text" id="phoneNumber" name="phoneNumber" value="{{formData.phoneNumber}}">
            <small id="phoneError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.phoneNumber}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.phoneNumber}}
            </small>          
            </div>

          <div class="form-group-s">
            <label>Referral Code</label>
            <input type="text" id="referralCode" name="referralCode" value="{{formData.referralCode}}">
            <small id="referralError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.referralCode}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.referralCode}}
            </small>          
          </div>
        </div>

        <div class="form-row-s">
          <div class="form-group-s">
            <label>Password <span class="star">*</span></label>
            <div class="password-containers">
<input type="password" id="password" name="password" value="{{formData.password}}">
              <i class="fas fa-eye" id="togglePassword1"></i>
            </div>
           <small id="passwordError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.password}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.password}}
            </small>          
            </div>

          <div class="form-group-s">
            <label>Confirm Password <span class="star">*</span></label>
            <div class="password-containers">
<input type="password" id="confirmPassword" name="confirmPassword" value="{{formData.confirmPassword}}">              <i class="fas fa-eye" id="togglePassword2"></i>
            </div>
           <small id="confirmPasswordError" class="field-error" style="color: #ff4d4d; font-size: 0.8rem; {{#if validationErrors.confirmPassword}}display: block;{{else}}display: none;{{/if}}">
              {{validationErrors.confirmPassword}}
            </small>          
          </div>
        </div>

        <button type="submit" class="btn-primary">
          Create Account  →
        </button>

        <div class="divider">OR CONTINUE WITH</div>

        <a href="/user/auth/google" class="google-btn">
          <img src="/images/google.png" alt="Google"> Google
        </a>

        <p class="login-text">
          Already have an account? <a href="/user/login">Login</a>
        </p>

      </form>
    </div>

    <!-- Image -->
    <div class="signup-image">
      <img src="/images/signup-img.jpg" alt="Shoe">
    </div>

  </div>
</section>