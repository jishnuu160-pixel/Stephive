<section class="forgot-hero">
    <div class="forgot-box">
        <div id="jsError" class="error-toast" style="display: none; color: white; background: #ff4d4d; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;"></div>

        {{#if error}}
            <p class="server-error" style="color: #ff4d4d; text-align: center; margin-bottom: 10px;">{{error}}</p>
        {{/if}}

        <form id="forgotForm" action="/user/forgot-password" method="POST">
            <h2>Forgot your password?</h2>
            <p>
                Precision security is our heritage. Enter your email
                and we’ll transmit instructions to restore access.
            </p>

            <label for="email">Email Address</label>
            <div class="input-box">
                <input type="email" name="email" id="email" placeholder="Enter your email">
                <span>@</span>
            </div>

            <button type="submit" class="verify-btn">VERIFY EMAIL →</button>

            <a href="/user/login" class="forgot-back-link">← RETURN TO LOGIN</a>
        </form>
    </div>
</section>