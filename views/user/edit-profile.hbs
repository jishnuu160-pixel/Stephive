
<div class="edit-profile-container">
    <div class="edit-card">
        <h3>Personal Information</h3>
        <form action="/user/update-profile" method="POST">
            <div class="form-group">
                <label>FULL NAME</label>
                <input type="text" name="fullName" value="{{user.fullName}}">
            </div>
            
            <div class="form-group">
                <label>PHONE NUMBER</label>
                <input type="text" name="phoneNumber" value="{{user.phoneNumber}}">
            </div>

            <div class="form-group">
                <label>GENDER</label>
                <div class="gender-selection">
                    <label class="gender-radio">
                        <input type="radio" name="gender" value="Male" {{#if (eq user.gender 'Male')}}checked{{/if}}>
                        <span>Male</span>
                    </label>
                    <label class="gender-radio">
                        {{!-- CHANGE: value="female" to value="Female" --}}
                        <input type="radio" name="gender" value="Female" {{#if (eq user.gender 'Female')}}checked{{/if}}>
                        <span>Female</span>
                    </label>
                </div>
            </div>

            <div class="modal-actions">
                <button type="submit" class="btn-save">Save Changes</button>
                <a href="/user/profile" class="btn-cancel">Cancel</a>
                 <a href="/user/update-password-init" class="btn-profile-action">
                    <img src="/icons/lock.png" class="btn-icon"> Update Password
                </a>
            </div>
        </form>
    </div>
</div>