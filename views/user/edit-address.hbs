<div class="profile-page-container">
    <div class="profile-wrapper">

        <nav class="breadcrumb-container">
            <p class="breadcrumb">
                <a href="/user/profile">My Account</a>
                <span>/</span>
                <a href="/user/address">My Addresses</a>
                <span>/</span>
                <strong>Edit Address</strong>
            </p>
        </nav>

        <div class="profile-layout">
            {{> userSide}}
            <main class="profile-main">

                <div class="page-header">
                    <h1>Edit Address</h1>
                </div>

                <div class="address-form-wrapper">

                    {{#if error}}
                        <div class="form-error">
                            {{error}}
                        </div>
                    {{/if}}

                    <form action="/user/edit-address/{{address._id}}" method="POST">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="fullName" value="{{address.fullName}}">
                                {{#if errors.fullName}}
                                    <span class="field-error">
                                        {{errors.fullName}}
                                    </span>
                                {{/if}}
                            </div>

                            <div class="form-group">
                                <label>Mobile Number</label>
                                <input type="text" name="phone" value="{{address.phone}}">
                                {{#if errors.phone}}
                                    <span class="field-error">
                                        {{errors.phone}}
                                    </span>
                                {{/if}}
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Address Line 1</label>
                            <input type="text" name="street" value="{{address.street}}">
                            {{#if errors.street}}
                                <span class="field-error">
                                    {{errors.street}}
                                </span>
                            {{/if}}
                        </div>

                        <div class="form-group">
                            <label>Address Line 2 (Optional)</label>
                            <input type="text" name="apartment" value="{{address.apartment}}">
                        </div>

                        <div class="form-row three-col">
                            <div class="form-group">
                                <label>City</label>
                                <input type="text" name="city" value="{{address.city}}">
                                {{#if errors.city}}
                                    <span class="field-error">
                                        {{errors.city}}
                                    </span>
                                {{/if}}
                            </div>

                            <div class="form-group">
                                <label>State</label>
                                <input type="text" name="state" value="{{address.state}}">
                                {{#if errors.state}}
                                    <span class="field-error">
                                        {{errors.state}}
                                    </span>
                                {{/if}}
                            </div>

                            <div class="form-group">
                                <label>Pincode</label>
                                <input type="text" name="pincode" value="{{address.pincode}}">
                                {{#if errors.pincode}}
                                    <span class="field-error">
                                        {{errors.pincode}}
                                    </span>
                                {{/if}}
                            </div>

                        </div>

                        <div class="form-group">
                            <label>Address Type</label>
                            <div class="type-selection">
                                <label class="type-chip">
                                    <input type="radio" name="label" value="Home"
                                        {{#if (eq address.label "Home")}}checked{{/if}}
                                    >
                                    <span>Home</span>
                                </label>

                                <label class="type-chip">
                                    <input type="radio" name="label" value="Office"
                                        {{#if (eq address.label "Office")}}checked{{/if}}
                                    >
                                    <span>Office</span>
                                </label>

                                <label class="type-chip">
                                    <input type="radio" name="label" value="Other"
                                        {{#if (eq address.label "Other")}}checked{{/if}}
                                    >
                                    <span>Other</span>
                                </label>

                            </div>
                        </div>

                        <div class="default-check">
                            <input type="checkbox" id="isDefault" name="isDefault"
                                {{#if address.isDefault}}checked{{/if}}
                            >
                            <label for="isDefault">
                                Make this my default address
                            </label>
                        </div>

                        <div class="form-actions">
                            <a href="/user/address" class="btn-cancel">
                                Cancel
                            </a>

                            <button type="submit" class="btn-address-save">
                                Update Address
                            </button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('input', function () {
        const error = this.parentElement.querySelector('.field-error');

        if (error) {
            error.remove();
        }
    });
});
</script>