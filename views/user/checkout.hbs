<div id="checkout-view-scoped">
  <div class="checkout-container"> 
    <div class="stepper">
      <div class="step completed">
        <span class="step-num">1</span>
        <span class="step-label">Cart</span>
      </div>
      <div class="step-line active"></div>
      <div class="step active">
        <span class="step-num">2</span>
        <span class="step-label">Checkout</span>
      </div>
      <div class="step-line"></div>
      <div class="step disabled">
        <span class="step-num">3</span>
        <span class="step-label">Payment</span>
      </div>
    </div>

    <div class="main-layout">
      
      <div class="left-column">
        <div class="card delivery-card">
  <h2 class="card-title">Delivery Address</h2>
  
  {{#each addresses}}
  <div class="address-box {{#if isDefault}}selected{{/if}}">
    <div class="address-header">
       <label class="radio-container">
        <input type="radio" name="selectedAddress" value="{{this._id}}" {{#if isDefault}}checked{{/if}}>
        <span class="radio-checkmark"></span>
       
        <div class="address-details">
        <span class="user-name">{{this.fullName}}</span>
          <p>{{this.street}}</p>
          <p>{{this.apartment}}, <br>{{this.city}}, {{this.state}} - {{this.pincode}}</p>
          <p class="phone-number">Mobile: {{this.phone}}</p>
    </div>
      </label>
      
      <div class="address-actions">
        <a href="/user/edit-address/{{this._id}}" class="btn-edit">Edit</a>
      </div>
    </div>
    </div>
{{else}}
    <p>No addresses found. Please add an address to proceed.</p>
  {{/each}}



 <a href="/user/add-address" class="btn-add-address-checkout">
                      + Add New Address
  </a>
 
</div>
      </div>

      <div class="right-column">
        
        <div class="card summary-card">
          <h2 class="card-title">Order Summary</h2>
          
          <div class="cart-items">
            {{#each cartItems}}
            <div class="item-row">
              <div class="item-img-wrapper">
                {{#if this.productId.variants.[0].images.[0]}}
                <img src="{{this.productId.variants.[0].images.[0]}}" 
                     alt="{{this.productId.productName}}"  style="width: 40px; height: 40px; border-radius: 5px; object-fit: cover;">
            {{else}}
                <div class="no-image-placeholder">No Image</div>
            {{/if}}
              </div>
              <div class="item-info">
                <h4 class="item-name">{{this.productId.productName}}</h4>
                <p class="item-qty">Qty: {{this.quantity}}</p>
              </div>
              <div class="item-price">₹{{this.itemSubtotal}}</div>
            </div>
            {{/each}}
          </div>

<div class="coupon-section">
    <div class="coupon-input-group">
        <input type="text" id="couponCodeInput" placeholder="Enter coupon code" class="coupon-input">
        <button class="btn-apply" onclick="applyCoupon()">APPLY</button>
    </div>
    <a href="javascript:void(0)" class="view-coupons-link" onclick="openCouponModal()">VIEW AVAILABLE COUPONS</a>
</div>

<div id="couponModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h3>Available Coupons</h3>
        <div id="couponList"></div>
        <button onclick="closeCouponModal()">Close</button>
    </div>
</div>

          <div class="price-breakdown">
            <div class="price-row">
              <span>Subtotal</span>
              <span id="subtotal-display">₹{{pricing.subtotal}}</span>
            </div>
            <div class="price-row">
              <span>Shipping</span>
              <span class="free-text">{{pricing.shipping}}</span>
            </div>
            <div class="price-row">
              <span>Tax (10%)</span>
              <span id="tax-display">₹{{pricing.tax}}</span>
            </div>
            <div class="price-row">
             <span>Discount</span>
               <span id="discount-display">-₹{{pricing.discount}}</span>
            </div>
          </div>

          <div class="total-row">
            <span>Total Amount</span>
            <span id="total-display" class="total-price">₹{{pricing.total}}</span>
          </div>
        </div>

        <div class="card payment-card">
          <div class="payment-title-group">
            <span class="payment-step-badge">2</span>
            <h2 class="card-title">Payment Method</h2>
          </div>
          
          <div class="payment-options">
            <label class="payment-option selected">
              <input type="radio" name="payment_method" value="razorpay" checked>
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
               <div class="payment-text">
                 <span class="method-title">Razorpay (Cards/UPI/NetBanking)</span>
               </div>
              </div>
            </label>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="wallet">
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12a2 2 0 0 0 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4v-6z"/></svg>
                <div class="payment-text">
                  <span class="method-title">Wallet</span>
                  <p class="method-desc">Pay securely using your wallet balance (Balance: Rs. 0.00)</p>
                </div>
              </div>
            </label>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="cod">
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <div class="payment-text">
                 <span class="method-title">Cash on Delivery Available</span>
                  <p class="method-desc">Pay at your doorstep</p>
                </div>
              </div>
            </label>
          </div>
        </div>

        <div class="action-group">
          <button class="btn-place-order">
            Place Order 
            <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="/cart" class="back-to-cart">← Back to Cart</a>
        </div>
      </div>
    </div>
  </div>
</div>







<script>
    document.addEventListener('DOMContentLoaded', () => {
        const applyBtn = document.querySelector('.btn-apply');
        if (applyBtn) applyBtn.addEventListener('click', applyCoupon);

        const placeOrderBtn = document.querySelector('.btn-place-order');
        if (placeOrderBtn) placeOrderBtn.addEventListener('click', handlePlaceOrder);
    });

async function handlePlaceOrder() {
    const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked')?.value;
    const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value;
    
    if (!selectedAddress) return showToast("Please select a delivery address", "error");
    if (!paymentMethod) return showToast("Please select a payment method", "error");

    try {
        if (paymentMethod === 'cod') {
            const response = await fetch('/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ addressId: selectedAddress, paymentMethod: 'cod' })
            });
            const data = await response.json();

            console.log("COD server reponse:",data);
            
            if (data.success && data.orderId) {
                window.location.href = `/order-confirmation/${data.orderId}`;
            } else {
              console.error("Server success but orderId missing:", data);
                showToast(data.message || "COD Order failed", "error");
            }
        } 
    else if (paymentMethod === 'wallet') {
        const response = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            addressId: selectedAddress, 
            paymentMethod: 'wallet' 
        })
    });
    const data = await response.json();

    if (data.success) {
        window.location.href = `/order-confirmation/${data.orderId}`;
    } else {
        showToast(data.message || "Wallet payment failed", "error");
    }
}else if (paymentMethod === 'razorpay') {
            const response = await fetch('/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                addressId: selectedAddress,
                paymentMethod: 'razorpay'
              }) 
            });
            const data = await response.json();

            console.log("Razorpay Session Data:", data);

            const options = {
                key: data.key,
                amount: data.amount, 
                order_id: data.razorpayOrderId,
                handler: async function (response) {
   

   
            const verifyRes = await fetch('/payment/verify-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature
             })
         });
    
         const verifyData = await verifyRes.json();
          if (verifyData.success) {
             window.location.href = `/order-confirmation/${verifyData.orderId}`;
          } else {
            showToast(verifyData.message || "Payment verification failed", "error");
          }
          },
           modal: {
             ondismiss: function () {
        window.location.href = "payment/payment-failed";
    }
}
            };
            new Razorpay(options).open();
        }
    } catch (err) {
        console.error("Order placing errror:",err);
        showToast("Server error, please try again", "error");
    }
}
   
    async function applyCoupon() {
        const code = document.getElementById('couponCodeInput')?.value;
        const subtotalEl = document.getElementById('subtotal-display');
        const subtotal = parseFloat(subtotalEl?.innerText.replace(/[^0-9.]/g, "")) || 0;

        try {
            const response = await fetch('/user/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code, subtotal })
            });
            
            const data = await response.json();

      if (data.success) {
      const discountEl = document.getElementById('discount-display');
      discountEl.innerText = `-₹${data.discount.toFixed(2)}`;
      discountEl.dataset.value = data.discount;

      updateCurrencyDisplay('tax-display', '₹', data.tax);
      updateCurrencyDisplay('total-display', '₹', data.total);
    
      localStorage.setItem('appliedCouponCode', code);
    
      alert("Coupon applied successfully!");
      window.location.reload();
}else{
      alert(data.message || "Failed to apply coupon");
      }
    }catch(err) {
      alert("Error connecting to server.");
    }
}

    function updateCurrencyDisplay(id, prefix, value) {
        const el = document.getElementById(id);
        if (el) {
            const num = parseFloat(value) || 0;
            el.innerText = `${prefix}${num.toFixed(2)}`;
        }
    }

    async function openCouponModal() {
        document.getElementById('couponModal').style.display = 'block';
        try {
            const res = await fetch('/user/get-available-coupons');
            const coupons = await res.json();
            const list = document.getElementById('couponList');
            list.innerHTML = coupons.length ? coupons.map(c => `
                <div class="coupon-item"><strong>${c.code}</strong> - ${c.discountValue}% OFF 
                <button onclick="selectCoupon('${c.code}')">Apply</button></div>
            `).join('') : "<p>No coupons available.</p>";
        } catch (err) {
            document.getElementById('couponList').innerHTML = "Failed to load.";
        }
    }

    function closeCouponModal() { document.getElementById('couponModal').style.display = 'none'; }
    function selectCoupon(code) { document.getElementById('couponCodeInput').value = code; closeCouponModal(); }
</script>