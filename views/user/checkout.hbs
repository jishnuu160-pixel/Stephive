<div id="checkout-view-scoped">
  <div class="checkout-container"> 
    <div class="stepper">
      <div class="step completed">
        <span class="step-num">1</span>
        <span class="step-label">Cart</span>
      </div>
      <div class="step-line active"></div>
      <div class="step active">
        <span class="step-num">2</span>
        <span class="step-label">Checkout</span>
      </div>
      <div class="step-line"></div>
      <div class="step disabled">
        <span class="step-num">3</span>
        <span class="step-label">Payment</span>
      </div>
    </div>

    <div class="main-layout">
      
      <div class="left-column">
<div class="card delivery-card">
  <h2 class="card-title">Delivery Address</h2>
  
 {{#each addresses}}
  <div class="address-box {{#if isDefault}}selected{{/if}}">
    <div class="address-header">
       <label class="radio-container">
        <input type="radio" name="selectedAddress" value="{{this._id}}" {{#if isDefault}}checked{{/if}}>
        <span class="radio-checkmark"></span>
       
        <div class="address-details">
        <span class="user-name">{{this.fullName}}</span>
          <p>{{this.street}}</p>
          <p>{{this.apartment}}, <br>{{this.city}}, {{this.state}} - {{this.pincode}}</p>
          <p class="phone-number">Mobile: {{this.phone}}</p>
    </div>
      </label>
      
      <div class="address-actions">
        <button type="button" class="btn-edit" onclick="openEditAddressModal('{{this._id}}')">Edit</button>
        <button type="button" class="btn-delete" onclick="deleteAddress('{{this._id}}')" >Delete</button>
      </div>
    </div>
    </div>
  {{else}}
    <p>No addresses found. Please add an address to proceed.</p>
  {{/each}}

  <button type="button" class="btn-add-address-checkout" onclick="toggleAddressForm()">
    + Add New Address
  </button>

<div id="newAddressFormContainer" class="new-address-form-container" style="display: none; margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
    <h3>Add New Address</h3>
    
    <form id="inlineAddressForm" onsubmit="event.preventDefault(); submitNewAddress();">
      
      <div class="form-group" style="margin-bottom: 12px;">
        <input type="text" name="fullName" placeholder="Full Name" value="{{formData.fullName}}" style="width: 100%; padding: 8px;">
        <small id="error-fullName" style="color: red; font-size: 12px; display: none;"></small>
      </div>

      <div class="form-group" style="margin-bottom: 12px;">
        <input type="text" name="phone" placeholder="Mobile Number (10 digits)" value="{{formData.phone}}" style="width: 100%; padding: 8px;">
        <small id="error-phone" style="color: red; font-size: 12px; display: none;"></small>
      </div>

      <div class="form-group" style="margin-bottom: 12px;">
        <input type="text" name="street" placeholder="Street Address" value="{{formData.street}}" style="width: 100%; padding: 8px;">
        <small id="error-street" style="color: red; font-size: 12px; display: none;"></small>
      </div>

      <div class="form-group" style="margin-bottom: 12px;">
        <input type="text" name="apartment" placeholder="Apartment / Suite / Landmark" value="{{formData.apartment}}" style="width: 100%; padding: 8px;">
        <small id="error-apartment" style="color: red; font-size: 12px; display: none;"></small>
      </div>

      <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 12px;">
        <div style="flex: 1;">
          <input type="text" name="city" placeholder="City" value="{{formData.city}}" style="width: 100%; padding: 8px;">
          <small id="error-city" style="color: red; font-size: 12px; display: none;"></small>
        </div>
        <div style="flex: 1;">
          <input type="text" name="state" placeholder="State" value="{{formData.state}}" style="width: 100%; padding: 8px;">
          <small id="error-state" style="color: red; font-size: 12px; display: none;"></small>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 15px;">
        <input type="text" name="pincode" placeholder="Pincode / Zip (6 digits)" value="{{formData.pincode}}" style="width: 100%; padding: 8px;">
        <small id="error-pincode" style="color: red; font-size: 12px; display: none;"></small>
      </div>

      <div class="form-actions" style="display: flex; gap: 10px;">
        <button type="submit" class="btn-submit-address" style="padding: 8px 15px; background: #000; color: #fff; border: none; cursor: pointer;">Save Address</button>
        <button type="button" class="btn-cancel-address" onclick="toggleAddressForm()" style="padding: 8px 15px; background: #ccc; border: none; cursor: pointer;">Cancel</button>
      </div>
    </form>
</div>
</div>
      </div>

      <div class="right-column">
        
        <div class="card summary-card">
          <h2 class="card-title">Order Summary</h2>
          
          <div class="cart-items">
            {{#each cartItems}}
            <div class="item-row">
              <div class="item-img-wrapper">
                {{#if this.productId.variants.[0].images.[0]}}
                <img src="{{this.productId.variants.[0].images.[0]}}" 
                     alt="{{this.productId.productName}}"  style="width: 40px; height: 40px; border-radius: 5px; object-fit: cover;">
            {{else}}
                <div class="no-image-placeholder">No Image</div>
            {{/if}}
              </div>
              <div class="item-info">
                <h4 class="item-name">{{this.productId.productName}}</h4>
                <p class="item-qty">Qty: {{this.quantity}} | size: {{this.size}} | color: {{this.color}}</p>
              </div>
              <div class="item-price">₹{{this.itemSubtotal}}</div>
            </div>
            {{/each}}
          </div>

     <div class="coupon-section">
      {{#if appliedCoupon}}
        <div class="applied-coupon-badge">
            <span>Applied Coupon: <strong>{{appliedCoupon}}</strong></span>
            <button type="button" class="btn-remove-coupon" onclick="removeCoupon()">Remove</button>
        </div>
      {{else}}
        <div class="coupon-input-group">
            <input type="text" id="couponCodeInput" placeholder="Enter coupon code" class="coupon-input" value="{{appliedCoupon}}">
            <button type="button" class="btn-apply" onclick="applyCoupon()">APPLY</button>
        </div>
        <a href="javascript:void(0)" class="view-coupons-link" onclick="openCouponModal()">VIEW AVAILABLE COUPONS</a>
      {{/if}}
     </div>

    <div id="couponModal" class="modal" style="display:none;">
     <div class="modal-content-coupon">
        <h3>Available Coupons</h3>
        <div id="couponList"></div>
        <button onclick="closeCouponModal()">Close</button>
      </div>
    </div>

          <div class="price-breakdown">
            <div class="price-row">
              <span>Subtotal</span>
              <span id="subtotal-display">₹{{pricing.subtotal}}</span>
            </div>
            <div class="price-row">
              <span>Shipping</span>
              <span class="free-text">{{pricing.shipping}}</span>
            </div>
            <div class="price-row">
              <span>Tax (10%)</span>
              <span id="tax-display">₹{{pricing.tax}}</span>
            </div>
            <div class="price-row">
             <span>Discount</span>
               <span id="discount-display">-₹{{pricing.discount}}</span>
            </div>
          </div>

          <div class="total-row">
            <span>Total Amount</span>
            <span id="total-display" class="total-price">₹{{pricing.total}}</span>
          </div>
        </div>

        <div class="card payment-card">
          <div class="payment-title-group">
            <span class="payment-step-badge">2</span>
            <h2 class="card-title">Payment Method</h2>
          </div>
          
          <div class="payment-options">
            <label class="payment-option selected">
              <input type="radio" name="payment_method" value="razorpay" checked>
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
               <div class="payment-text">
                 <span class="method-title">Razorpay (Cards/UPI/NetBanking)</span>
               </div>
              </div>
            </label>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="wallet">
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12a2 2 0 0 0 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4v-6z"/></svg>
                <div class="payment-text">
                  <span class="method-title">Wallet</span>
                  <p class="method-desc">Pay securely using your wallet balance (Balance: Rs. {{walletBalance}})</p>
                </div>
              </div>
            </label>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="cod">
              <div class="payment-option-content">
                <svg class="payment-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <div class="payment-text">
                 <span class="method-title">Cash on Delivery Available</span>
                  <p class="method-desc">Pay at your doorstep</p>
                </div>
              </div>
            </label>
          </div>
        </div>

        <div class="action-group">
          <button class="btn-place-order">
            Place Order 
            <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="/cart" class="back-to-cart">← Back to Cart</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const applyBtn = document.querySelector('.btn-apply');
        if (applyBtn) applyBtn.addEventListener('click', applyCoupon);

        const placeOrderBtn = document.querySelector('.btn-place-order');
        if (placeOrderBtn) placeOrderBtn.addEventListener('click', handlePlaceOrder);
    });

    async function handlePlaceOrder() {
        const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked')?.value;
        const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value;
        
        if (!selectedAddress) return showToast("Please select a delivery address", "error");
        if (!paymentMethod) return showToast("Please select a payment method", "error");

        try {
            if (paymentMethod === 'cod') {
                const response = await fetch('/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ addressId: selectedAddress, paymentMethod: 'cod' })
                });
                const data = await response.json();

                if (data.success && data.orderId) {
                    showToast("Order placed successfully!", "success");
                    localStorage.removeItem('appliedCouponCode'); 
                    
                    setTimeout(() => {
                        window.location.href = `/order-confirmation/${data.orderId}`;
                    }, 3000);
                } else {
                    showToast(data.message || "COD Order failed", "error");
                }
            } 
            else if (paymentMethod === 'wallet') {
                const response = await fetch('/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ addressId: selectedAddress, paymentMethod: 'wallet' })
                });
                const data = await response.json();

                if (data.success) {
                    localStorage.removeItem('appliedCouponCode'); 
                      showToast("Order placed successfully!", "success");

                     setTimeout(() => {
                          window.location.href = `/order-confirmation/${data.orderId}`;
                    }, 1000);
                } else {
                    showToast(data.message || "Wallet payment failed", "error");
                }
            } 
            else if (paymentMethod === 'razorpay') {
    const response = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId: selectedAddress, paymentMethod: 'razorpay' })
    });
    const data = await response.json();

    if (!data.success) {
        return showToast(data.message || "Failed to initialize order", "error");
    }

    const options = {
        key: data.key,
        amount: data.amount, 
        order_id: data.razorpayOrderId,
        handler: async function (response) {
            const verifyRes = await fetch('/payment/verify-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    razorpay_payment_id: response.razorpay_payment_id,
                    razorpay_order_id: response.razorpay_order_id,
                    razorpay_signature: response.razorpay_signature,
                    dbOrderId: data.dbOrderId 
                })
            });
    
            const verifyData = await verifyRes.json();
            if (verifyData.success) {
                localStorage.removeItem('appliedCouponCode'); 
                showToast("Order placed successfully!", "success");
                setTimeout(() => {
                    window.location.href = `/order-confirmation/${verifyData.orderId}`;
                }, 1000);
            } else {
                showToast(verifyData.message || "Payment verification failed", "error");
            }
        },
        modal: {
            ondismiss: async function () {
                try {
                    await fetch('/payment/payment-exit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ dbOrderId: data.dbOrderId })
                    });
                } catch (err) {
                    console.error("Error updating exit status:", err);
                } finally {
                    window.location.href = "/history"; 
                }
            }
        }
    };
    new Razorpay(options).open();
}
        } catch (err) {
            console.error("Order placing error:", err);
            showToast("Server error, please try again", "error");
        }
    }
    
    async function applyCoupon() {
        const code = document.getElementById('couponCodeInput')?.value;
        const subtotalEl = document.getElementById('subtotal-display');
        const subtotal = parseFloat(subtotalEl?.innerText.replace(/[^0-9.]/g, "")) || 0;

        try {
            const response = await fetch('/user/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code, subtotal })
            });
            
            const data = await response.json();

            if (data.success) {
                localStorage.setItem('appliedCouponCode', code);
                showToast("Coupon applied successfully!", "success");

                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                showToast(data.message || "Failed to apply coupon", "error");      
            }
        } catch(err) {
            alert("Error connecting to server.");
        }
    }

async function openCouponModal() {
    document.getElementById('couponModal').style.display = 'flex';
    
    const subtotalEl = document.getElementById('subtotal-display');
    const subtotal = subtotalEl ? parseFloat(subtotalEl.innerText.replace(/[^0-9.]/g, "")) || 0 : 0;

    try {
        const res = await fetch('/user/get-available-coupons');
        const coupons = await res.json();
        const list = document.getElementById('couponList');
        
        list.innerHTML = coupons.length ? coupons.map(c => {
            const isEligible = subtotal >= c.min_orderAmount;
            return `
                <div class="coupon-item" style="opacity: ${isEligible ? '1' : '0.6'}; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong>${c.code}</strong> - ${c.discountValue}${c.discountType === 'percentage' ? '%' : '₹'} OFF 
                        <br><small>Min. spend: ₹${c.min_orderAmount}</small>
                        ${!isEligible ? `<br><span style="color: red; font-size: 11px;">Add ₹${c.min_orderAmount - subtotal} more to unlock</span>` : ''}
                    </div>
                    ${isEligible 
                        ? `<button type="button" onclick="selectCoupon('${c.code}')">Apply</button>` 
                        : `<button type="button" disabled style="background:gray; cursor:not-allowed;">Locked</button>`}
                </div>
            `;
        }).join('') : "<p>No coupons available.</p>";
    } catch (err) {
        document.getElementById('couponList').innerHTML = "<p>Failed to load coupons.</p>";
    }
}

   async function removeCoupon() {
    try {
        const response = await fetch('/user/remove-coupon', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const data = await response.json();

        if (data.success) {
            localStorage.removeItem('appliedCouponCode');
            showToast("Coupon removed", "success");
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            showToast(data.message || "Failed to remove coupon", "error");
        }
    } catch (err) {
        console.error("Error removing coupon:", err);
        showToast("Error connecting to server", "error");
    }
}

    function closeCouponModal() { document.getElementById('couponModal').style.display = 'none'; }
    function selectCoupon(code) { document.getElementById('couponCodeInput').value = code; closeCouponModal(); }

    function toggleAddressForm() {
    const container = document.getElementById('newAddressFormContainer');
    if (container) {
        container.style.display = container.style.display === 'none' ? 'block' : 'none';
    }
}

function toggleAddressForm() {
        const container = document.getElementById('newAddressFormContainer');
        const form = document.getElementById('inlineAddressForm');
        const titleEl = document.querySelector('#newAddressFormContainer h3');

        if (container && form) {
            form.reset();
            form.removeAttribute('data-mode');
            form.removeAttribute('data-address-id');
            if (titleEl) titleEl.innerText = "Add New Address";

            document.querySelectorAll('#inlineAddressForm small').forEach(el => {
                el.style.display = 'none';
                el.innerText = '';
            });

            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
    }

    async function submitNewAddress() {
        document.querySelectorAll('#inlineAddressForm small').forEach(el => {
            el.style.display = 'none';
            el.innerText = '';
        });

        const form = document.getElementById('inlineAddressForm');
        const mode = form.getAttribute('data-mode');
        const addressId = form.getAttribute('data-address-id');
        
        const formData = new FormData(form);
        const dataObject = Object.fromEntries(formData.entries());

        const isEditing = mode === 'edit' && addressId;
        const url = isEditing ? `/user/checkout/edit-address/${addressId}` : '/user/checkout/add-address';
        const method = isEditing ? 'PUT' : 'POST';

        try {
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dataObject)
            });

            const result = await response.json();

            if (result.success) {
                showToast(isEditing ? "Address updated successfully!" : "Address added successfully!", "success");
                setTimeout(() => {
                    window.location.reload(); 
                }, 1000);
            } else if (result.errors) {
                for (const [field, message] of Object.entries(result.errors)) {
                    const errorElement = document.getElementById(`error-${field}`);
                    if (errorElement) {
                        errorElement.innerText = message;
                        errorElement.style.display = 'block';
                    }
                }
            } else {
                showToast(result.message || "Failed to save address", "error");
            }
        } catch (err) {
            console.error("Error saving address:", err);
            showToast("Server error while saving address", "error");
        }
    };

    window.openEditAddressModal = async function(addressId) {
        try {
            const response = await fetch(`/user/checkout/address/${addressId}`);
            const data = await response.json();

            if (response.ok && data.address) {
                const form = document.getElementById('inlineAddressForm');
                if (!form) return;

                form.querySelector('[name="fullName"]').value = data.address.fullName || '';
                form.querySelector('[name="phone"]').value = data.address.phone || '';
                form.querySelector('[name="street"]').value = data.address.street || '';
                form.querySelector('[name="apartment"]').value = data.address.apartment || '';
                form.querySelector('[name="city"]').value = data.address.city || '';
                form.querySelector('[name="state"]').value = data.address.state || '';
                form.querySelector('[name="pincode"]').value = data.address.pincode || '';

                form.setAttribute('data-mode', 'edit');
                form.setAttribute('data-address-id', addressId);

                const titleEl = document.querySelector('#newAddressFormContainer h3');
                if (titleEl) titleEl.innerText = "Edit Address";

                const container = document.getElementById('newAddressFormContainer');
                if (container) {
                    container.style.display = 'block';
                    container.scrollIntoView({ behavior: 'smooth' });
                }
            } else {
                showToast(data.message || "Could not load address details.", "error");
            }
        } catch (err) {
            console.error("Error fetching address for edit:", err);
            showToast("Error loading address data", "error");
        }
    };

async function deleteAddress(addressId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "Do you really want to delete this address?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Delete it!',
        width: '320px',
        padding: '1rem',
        customClass: {
            popup: 'small-swal-popup',
            title: 'small-swal-title',
            htmlContainer: 'small-swal-text'
        }
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const response = await fetch(`/user/checkout/address/${addressId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                const resData = await response.json();

                if (resData.success) {
                    showToast("Address deleted successfully", "success");
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showToast(resData.message || "Failed to delete address", "error");
                }
            } catch (err) {
                console.error("Error deleting address:", err);
                showToast("Server error while deleting address", "error");
            }
        }
    });
}
</script>