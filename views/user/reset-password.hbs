<section class="reset-hero">

    <div class="reset-box">

        <h2>SET NEW PASSWORD</h2>
        <p>Enter your new credentials to access your vault.</p>

        <!-- New Password -->
        <label>NEW PASSWORD</label>
        <div class="input-box">
            <input type="password" placeholder="Enter password">
            <span class="eye">👁</span>
        </div>

        <!-- Confirm Password -->
        <label>CONFIRM PASSWORD</label>
        <div class="input-box">
            <input type="password" placeholder="Confirm password">
            <span class="eye">👁</span>
        </div>

        <button class="update-btn">UPDATE PASSWORD</button>

        <a href="/user/login" class="back-link">← Back to Login</a>

    </div>

</section>