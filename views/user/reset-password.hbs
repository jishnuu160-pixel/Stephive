<section class="reset-hero">

    <div class="reset-box">

        <h2>SET NEW PASSWORD</h2>
        <p>Enter your new credentials to access your vault.</p>
        <form action="/user/reset-password" method="POST">
        <!-- New Password -->
        <label>NEW PASSWORD</label>
        <div class="input-box">
            <input type="password" name="password" placeholder="Enter password">
            <span class="eye">👁</span>
        </div>

        <!-- Confirm Password -->
        <label>CONFIRM PASSWORD</label>
        <div class="input-box">
            <input type="password" name="confirmPassword" placeholder="Confirm password">
            <span class="eye">👁</span>
        </div>
          <input type="hidden" name="email" value="{{email}}"> 
        <button class="update-btn">UPDATE PASSWORD</button>

        <a href="/user/login" class="back-link">← Back to Login</a>
       </form>
    </div>

</section>