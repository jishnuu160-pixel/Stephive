<div class="edit-profile-container">
    <div class="edit-card">
        <h3>Change Email Address</h3>
        <p class="subtitle">A verification code will be sent to your new email.</p>
        
        {{#if errorMessage}}
            <div class="alert alert-danger" style="color: red; background: #ffe6e6; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
                {{errorMessage}}
            </div>
        {{/if}}
        <form action="/user/change-email" method="POST" novalidate>
            <div class="form-group">
                <label>CURRENT EMAIL</label>
                <input type="email" value="{{user.email}}" readonly class="readonly-input">
            </div>

            <div class="form-group">
                <label>NEW EMAIL ADDRESS</label>
                <input type="email" name="newEmail" placeholder="Enter new email" >
            </div>

            <div class="modal-actions">
                <button type="submit" class="btn-save">Update Email</button>
                <a href="/user/profile" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>