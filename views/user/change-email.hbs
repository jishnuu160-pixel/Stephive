<div class="edit-profile-container">
    <div class="edit-card">
        <h3>Change Email Address</h3>
        <p class="subtitle">A verification code will be sent to your new email.</p>
        
        <form action="/user/change-email" method="POST">
            <div class="form-group">
                <label>CURRENT EMAIL</label>
                <input type="email" value="{{user.email}}" readonly class="readonly-input">
            </div>

            <div class="form-group">
                <label>NEW EMAIL ADDRESS</label>
                <input type="email" name="newEmail" placeholder="Enter new email" required>
            </div>

            <div class="modal-actions">
                <form action="/user/change-email" method="POST">
    <button type="submit">Update Email</button>
</form>
                <a href="/user/profile" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>



