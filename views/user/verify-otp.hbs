<section class="otp-hero">
    <div class="otp-box">
       <form action="{{#if isPasswordUpdate}}/user/verify-password-otp{{else}}/user/verify-otp{{/if}}" method="post" id="otpForm">
            {{#if error}}
            <p class="server-error" style="color: #ff4d4d; text-align: center; margin-bottom: 10px;font-size: 10px">{{error}}</p>
        {{/if}}

        <div id="js-error-message" style="color: #ff4d4d; text-align: center; margin-bottom: 5px; display: none; font-size: 10px;"></div>

            <div class="lock-icon">🔒</div>

            <p class="otp-text">
                Enter the 6-digit code sent to your registered device to authenticate.
            </p>

            <input type="hidden" name="otp" id="fullOtp">
            <input type="hidden" id="serverExpiryTime" value="{{otpExpiryTime}}">
            <input type="hidden" name="email" value="{{email}}"> 
            <input type="hidden" name="target" value="{{target}}"> 

            <div class="otp-inputs">
                <input type="text" class="otp" maxlength="1" inputmode="numeric" autocomplete="one-time-code">
                <input type="text" class="otp" maxlength="1" inputmode="numeric">
                <input type="text" class="otp" maxlength="1" inputmode="numeric">
                <input type="text" class="otp" maxlength="1" inputmode="numeric">
                <input type="text" class="otp" maxlength="1" inputmode="numeric">
                <input type="text" class="otp" maxlength="1" inputmode="numeric">
            </div>

            <button type="submit" class="otp-btn">VERIFY OTP →</button>

            <p class="resend-text">
                Didn’t receive the code? 
                <span id="timer-container">Resend in <b id="timer">01:00</b></span>
                
               <a href="/user/resend-otp?email={{email}}&target={{target}}&isPasswordUpdate={{#if isPasswordUpdate}}true{{else}}false{{/if}}" 
   id="resend-link" 
   style="display: none; color: #ffffff; font-weight: bold; text-decoration: none;">
    Resend OTP
</a>
            </p>

<a href="{{#if (eq target 'signup')}}/user/signup{{else if (eq target 'email')}}/user/profile{{else if (eq target 'updatepassword')}}/user/profile{{else}}/user/forgot-password{{/if}}" class="back-link">
    {{#if (eq target 'email')}}
        ← BACK TO PROFILE
    {{else if (eq target 'updatepassword')}}
        ← BACK TO PROFILE 
    {{else if (eq target 'signup')}}
        ← BACK TO SIGNUP
    {{else}}
        ← BACK TO FORGOT PASSWORD
    {{/if}}
</a>
        </form>
    </div>
</section>

<div id="toast-container"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const inputs = document.querySelectorAll(".otp");
    const hiddenOtp = document.getElementById("fullOtp");
    const form = document.getElementById("otpForm");
    const jsErrorBox = document.getElementById("js-error-message"); 

    const serverError = document.querySelector(".server-error");
    if (serverError) {
        setTimeout(() => {
            serverError.style.display = "none";
        }, 3000);
    }

    const updateHiddenInput = () => {
        let otp = "";
        inputs.forEach(i => otp += i.value);
        hiddenOtp.value = otp;
    };

    inputs.forEach((input, index) => {
        input.addEventListener("input", (e) => {
            if (e.inputType === "deleteContentBackward") return; 
            if (input.value && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            updateHiddenInput();
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !input.value && index > 0) {
                inputs[index - 1].focus();
            }
        });

        input.addEventListener("paste", (e) => {
            const data = e.clipboardData.getData("text").split("");
            if (data.length === inputs.length) {
                inputs.forEach((inp, i) => inp.value = data[i]);
                updateHiddenInput();
                inputs[inputs.length - 1].focus();
            }
        });
    });

    form.addEventListener("submit", (e) => {
        if (hiddenOtp.value.length !== 6) {
            e.preventDefault();
            if (jsErrorBox) {
                jsErrorBox.innerText = "Please enter the full 6-digit code!";
                jsErrorBox.style.display = "block";
                setTimeout(() => {
                    jsErrorBox.style.display = "none";
                }, 3000);
            }
        }
    });

    const timerDisplay = document.getElementById("timer");
    const timerContainer = document.getElementById("timer-container");
    const resendLink = document.getElementById("resend-link");
    const serverExpiryInput = document.getElementById("serverExpiryTime");

    if (serverExpiryInput && timerDisplay && timerContainer && resendLink) {
        const expiryTime = parseInt(serverExpiryInput.value, 10) || (Date.now() + 60000);

        const updateTimer = () => {
            const timeLeft = Math.max(0, Math.floor((expiryTime - Date.now()) / 1000));
            const minutes = String(Math.floor(timeLeft / 60)).padStart(2, '0');
            const seconds = String(timeLeft % 60).padStart(2, '0');

            timerDisplay.innerText = `${minutes}:${seconds}`;

            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                timerContainer.style.display = "none";
                resendLink.style.display = "inline"; 
            }
        };

        updateTimer();
        const countdownInterval = setInterval(updateTimer, 1000);
    }
});
</script>

