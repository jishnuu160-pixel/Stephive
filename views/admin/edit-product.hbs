<div class="admin-dashboard-wrapper">
    <!-- Dark Backdrop Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar-wrapper" id="sidebarWrapper">
        {{> admin-sidebar}}
    </aside>

    <div class="products-page">
        <div class="prod-table-card">

             <div class="card-header">
                <h2>Edit Product</h2>
                <a href="/admin/products" class="btn-cross-cancel">✕</a>
            </div>

            <form action="/admin/products/edit/{{product._id}}" method="POST" enctype="multipart/form-data" class="modal-form-body">

                <!-- Basic Info Row -->
                <div class="form-row split-row4">
                    <div class="form-group">
                        <label>Shoe Name</label>
                        <input type="text" name="productName" value="{{product.productName}}">
                       <small class="field-error text-danger" id="error-productName"></small>
                        {{#if fieldErrors.productName}}
                         <div class="text-danger small mt-1">{{fieldErrors.productName}}</div>
                        {{/if}}
                    </div>

                    <div class="form-group">
                        <label>Brand</label>
                        <select name="brand" class="form-control">
                            <option value="" disabled>Select Brand</option>
                            {{#each brands}}
                            <option value="{{this}}" {{#if (eq this ../product.brand)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>
                        <small class="field-error text-danger" id="error-brand"></small>
                       {{#if fieldErrors.brand}}
                         <div class="text-danger small mt-1">{{fieldErrors.brand}}</div>
                       {{/if}}
                    </div>

                    <div class="form-group">
                        <label>Base Price</label>
                        <input type="number" name="regularPrice" min="1" value="{{product.regularPrice}}">
                         <small class="field-error text-danger" id="error-regularPrice"></small>
                         {{#if fieldErrors.regularPrice}}
                           <div class="text-danger small mt-1">{{fieldErrors.regularPrice}}</div>
                         {{/if}}
                    </div>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" name="description" value="{{product.description}}">
                    <small class="field-error text-danger" id="error-description"></small>
                      {{#if fieldErrors.description}}
                      <div class="text-danger small mt-1">{{fieldErrors.description}}</div>
                      {{/if}}
                </div>

                <!-- Categories Row -->
                <div class="form-row split-row category-grid">
                    <div class="form-group">
                        <label for="parentCategorySelect">Parent Category (e.g. Men, Women)</label>
                        <select id="parentCategorySelect" name="parentCategory">
                            <option value="">Select Parent Category</option>
                            {{#each parentCategories}}
                            <option value="{{this._id}}" {{#if (eq this._id ../selectedParentId)}}selected{{/if}}>
                                {{this.name}}
                            </option>
                            {{/each}}
                        </select>
                        {{#if fieldErrors.parentCategory}}
                     <div class="text-danger small mt-1">{{fieldErrors.parentCategory}}</div>
                    {{/if}}
                    </div>

                    <div class="form-group">
                        <label for="subcategorySelect">Category Name (Subcategory)</label>
                        <select id="subcategorySelect" name="category">
                            <option value="">Select Subcategory</option>
                            {{#each subcategories}}
                            <option value="{{this._id}}" {{#if (eq this._id ../product.Category._id)}}selected{{/if}}>
                                {{this.name}}
                            </option>
                            {{/each}}
                        </select>
                        {{#if fieldErrors.category}}
                     <div class="text-danger small mt-1">{{fieldErrors.category}}</div>
                    {{/if}}
                    </div>
                </div>

                <!-- Variants Section -->
                <!-- Variants Section -->
                <div class="variants-section">
                    <label class="section-main-label">Variants</label>

                    <div id="variantsContainer" class="variants-grid-wrapper">
                        {{#each product.variants}}
                        <div class="variant-card" data-variant-index="{{@index}}">
                            
                            <input type="hidden" name="variantId_{{@index}}" value="{{this._id}}">

                            <div class="form-group">
                                <label>Color Name</label>
                                <input type="text" name="colorNames[]" value="{{this.colorName}}" placeholder="Color Name">
                                <small class="field-error"></small>
                                
                               <div class="text-danger small mt-1" id="error-colorNames_{{@index}}"></div>

                                <div class="color-picker">
                                    <input type="color" name="colorHex[]" value="{{this.colorHex}}">
                                    <span class="label">{{this.colorHex}}</span>
                                    <input type="hidden" name="colorName[]" class="color-name" value="{{this.colorName}}">
                                </div>
                            </div>

                            <div class="form-group variant-images-section">
                                <label>Variant Images (Upload unique photos for this color)</label>
                                
                                <small style="display:block; margin-bottom:10px; color:#64748b;">
                                    Existing Images for this color (click × to remove)
                                </small>

                                <div class="edit-images-grid">
                                    {{#each this.images}}
                                    <div class="img-box" data-img-url="{{this}}" data-img-name="{{this}}" data-variant-index="{{@../index}}">
                                        <img src="{{this}}">
                                        <button type="button" class="remove-img">✕</button>
                                    </div>
                                    {{/each}}
                                </div>

                                <div class="image-drag-dropzone upload-box-variant">
                                    <input 
                                        type="file" 
                                        class="variant-image-input"
                                        data-index="{{@index}}"
                                        multiple 
                                        accept="image/*" 
                                        style="display:none"
                                    >
                                    <div class="dropzone-inner-ui">
                                        <div class="camera-icon">📷</div>
                                        <p class="main-drop-text">Click to upload more color specific images</p>
                                        <p class="sub-drop-text">JPG, PNG up to 2MB</p>
                                    </div>
                                </div>
                                
                                <div class="cropped-files-container" id="croppedFilesContainer_{{@index}}"></div>
                                <div class="images-preview-gallery-variant" id="thumbnailsContainer_{{@index}}"></div>

                                <div class="image-error text-danger small mt-1" id="error-variantImages_{{@index}}"></div>
                                <div class="text-danger small mt-1" id="error-variantImages_{{@index}}"></div>
                            </div>

                            <div class="sizes-container">
                                <label class="section-main-label">Sizes & Stock</label>
                                
                                {{#each this.sizes}}
                                <div class="size-row">
                                    <input type="number" name="sizes_{{@../index}}[]" value="{{this.size}}" placeholder="Size">
                                    <input type="number" name="stocks_{{@../index}}[]" value="{{this.stock}}" placeholder="Stock">
                                    <button type="button" class="remove-size">✕</button>
                                    <small class="field-error text-danger size-input-error"></small>
                                    <small class="field-error text-danger stock-input-error"></small>
                                </div>
                                {{/each}}

                                <button type="button" class="add-size">+ Add size</button>
                                <div class="size-error text-danger small mt-1"></div>

                                <div class="text-danger small mt-1" id="error-sizes_{{@index}}"></div>
                            </div>

                            <button type="button" class="remove-variant">
                                Remove Variant
                            </button>
                        </div>
                        {{/each}}
                    </div>

                    <div id="removedImagesContainer"></div>

                    <button type="button" class="btn-add-variant-group" id="addVariantBtn" onclick="addColorVariantBlock()">
                        + Add another color variant
                    </button>
                </div>

                <!-- Specifications Row -->
                <div class="form-row split-row4">
                    <div class="form-group">
                        <label>Material</label>
                        <input type="text" name="material" value="{{product.material}}">
                        <small class="field-error text-danger" id="error-material"></small>
                        {{#if fieldErrors.material}}
                         <div class="text-danger small mt-1">{{fieldErrors.material}}</div>
                        {{/if}}
                    </div>

                    <div class="form-group">
                        <label>Closure Type</label>
                        <input type="text" name="closureType" value="{{product.closureType}}">
                          <small class="field-error text-danger" id="error-closureType"></small>
                          {{#if fieldErrors.closureType}}
                           <div class="text-danger small mt-1">{{fieldErrors.closureType}}</div>
                          {{/if}}
                    </div>

                    <div class="form-group">
                        <label>Sole Type</label>
                        <input type="text" name="soleType" value="{{product.soleType}}">
                        <small class="field-error text-danger" id="error-soleType"></small>
        {{#if fieldErrors.soleType}}
            <div class="text-danger small mt-1">{{fieldErrors.soleType}}</div>
        {{/if}}
                    </div>
                    
                    <div class="form-group">
                        <label>Weight</label>
                        <input type="text" name="weight" value="{{product.weight}}">
                        <small class="field-error text-danger" id="error-weight"></small>
        {{#if fieldErrors.weight}}
            <div class="text-danger small mt-1">{{fieldErrors.weight}}</div>
        {{/if}}
                    </div>
                </div>

                <div class="form-row split-row4">
                    <div class="form-group">
                        <label>Country of Origin</label>
                        <input type="text" name="countryOfOrigin" value="{{product.countryOfOrigin}}">
                        <small class="field-error text-danger" id="error-countryOfOrigin"></small>
        {{#if fieldErrors.countryOfOrigin}}
            <div class="text-danger small mt-1">{{fieldErrors.countryOfOrigin}}</div>
        {{/if}}
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="modal-action-footer">
                    <a href="/admin/products" class="btn-modal-cancel">Cancel</a>
                    <button type="submit" class="btn-modal-save">Update</button>
                </div>

            </form>

        </div>
    </div>
</div>

<template id="variantTemplate">
    <div class="variant-card" data-variant-index="__INDEX__">
        
        <!-- Color Name Group -->
        <div class="form-group">
            <label>Color Name</label>
            <input type="text" name="colorNames[]" placeholder="Color Name (e.g. Crimson)">
            <!-- Fixed to single underscore to match your script/backend error mapping -->
            <div class="text-danger small mt-1" id="error-colorNames___INDEX__"></div>
        </div>

        <!-- Color Picker Group -->
        <div class="form-group">
            <div class="color-picker" style="margin-top: 8px;">
                <input type="color" name="colorHex[]" value="#000000">
                <span class="label">#000000</span>
            </div>
        </div>

        <!-- Variant Images Group -->
        <div class="form-group variant-images-section">
            <label>Variant Images (Upload unique photos for this color)</label>
            
            <div class="image-drag-dropzone upload-box-variant">
                <input 
                    type="file" 
                    name="variantImages___INDEX__"
                    class="variant-image-input"
                    data-index="__INDEX__"
                    multiple 
                    accept="image/*" 
                    style="display:none"
                >
                <div class="dropzone-inner-ui">
                    <div class="camera-icon">📷</div>
                    <p class="main-drop-text">Click to upload color specific images</p>
                    <p class="sub-drop-text">JPG, PNG, WebP up to 2MB</p>
                </div>
            </div>
            
            <div class="cropped-files-container" id="croppedFilesContainer___INDEX__"></div>
            <div class="images-preview-gallery-variant" id="thumbnailsContainer___INDEX__"></div>
            
            <!-- Fixed to single underscore -->
            <div class="text-danger small mt-1" id="error-variantImages___INDEX__"></div>
        </div>

        <!-- Sizes & Stock Group -->
        <div class="sizes-container">
            <label class="section-main-label" style="font-size: 14px;">Sizes & Stock</label>
            
            <div class="size-row" style="display: flex; gap: 10px; margin-bottom: 5px;">
                <input type="number" name="sizes___INDEX__[]" placeholder="Size (e.g. 8)">
                <input type="number" name="stocks___INDEX__[]" placeholder="Stock">
                <button type="button" class="remove-size">✕</button>
            </div>
            
            <button type="button" class="add-size">+ Add size</button>
            
            <!-- Fixed to single underscore -->
            <div class="text-danger small mt-1" id="error-sizes___INDEX__"></div>
        </div>

        <button type="button" class="remove-variant">
            Remove Variant
        </button>
    </div>
</template>
<!-- Cropper Modal Container -->
<div id="cropperModal" class="cropper-modal-container" style="display: none;">
    <div class="cropper-wrapper">
        <h3>Crop Variant Image</h3>
        <div class="image-preview-box">
            <img id="cropperTargetImage" src="" alt="Target Crop">
        </div>
        <div class="cropper-actions">
            <button type="button" id="btnCancelCrop" class="btn btn-secondary">Cancel</button>
            <button type="button" id="btnSaveCrop" class="btn btn-primary">Crop & Save</button>
        </div>
    </div>
</div>

<script>
function validateProductForm() {
    let isValid = true;

    document.querySelectorAll('.client-error').forEach(el => {
        el.textContent = '';
    });

function showError(id, message) {
    let element = document.getElementById(id);

    if (!element) {
        const fieldName = id.replace(/^error-/, '');
        const inputElement = document.querySelector(`[name="${fieldName}"]`);
        if (inputElement) {
            element = inputElement.parentElement.querySelector('.client-error, .text-danger, .error-message');
        }
    }

    if (element) {
        element.textContent = message;
    }
    isValid = false;
}

    const productName = document.querySelector('[name="productName"]')?.value.trim();

    const nameRegex = /^[A-Za-z\s]+$/;    

    if (!productName) {
        showError('error-productName', 'Product name is required.');
    } else if (productName.length < 3) {
        showError(
            'error-productName',
            'Product name must contain at least 3 characters.'
        );
    } else if (!nameRegex.test(productName)) {
        showError(
            'error-productName',
            'Product name should contain only letters and space.'
        );
    }

    const brand = document.querySelector('[name="brand"]')?.value;

    if (!brand) {
        showError('error-brand', 'Please select a brand.');
    }

    const regularPrice = document
        .querySelector('[name="regularPrice"]')
        ?.value;

    if (!regularPrice) {
        showError(
            'error-regularPrice',
            'Price is required.'
        );
    } else if (Number(regularPrice) <= 500) {
        showError(
            'error-regularPrice',
            'Price must be greater than 500.'
        );
    }

    const description = document
        .querySelector('[name="description"]')
        ?.value.trim();

    const descriptionRegex = /^[A-Za-z\s]+$/; 
    if (!description) {
        showError(
            'error-description',
            'Description is required.'
        );
    } else if (!descriptionRegex.test(description)) {
        showError(
            'error-description',
            'Should contain only letters and space.'
        );
    }  else if (description.length < 10) {
        showError(
            'error-description',
            'Description must contain at least 10 characters.'
        );
    } else if (description.length > 500) {
        showError(
            'error-description',
            'Description cannot exceed 500 characters.'
        );
    }

    const material = document
        .querySelector('[name="material"]')
        ?.value.trim();

    const materialRegex = /^[A-Za-z\s]+$/; 

    if (!material) {
        showError(
            'error-material',
            'Material is required.'
        );
    } else if (!materialRegex.test(material)) {
        showError(
            'error-material',
            'Should contain only letters and space.'
        );
    }
    
    const closureType = document
        .querySelector('[name="closureType"]')
        ?.value.trim();

    const closureRegex = /^[A-Za-z\s]+$/;

    if (!closureType) {
        showError(
            'error-closureType',
            'Closure type is required.'
        );
    } else if (!closureRegex.test(closureType)){
        showError(
            'error-closureType',
            'Should contain only contain letters and space.'
        )
    }

    const soleType = document
        .querySelector('[name="soleType"]')
        ?.value.trim();

    const soleRegex = /^[A-Za-z\s]+$/;
    if (!soleType) {
        showError(
            'error-soleType',
            'Sole type is required.'
        );
    } else if (!soleRegex.test(soleType)){
        showError(
            'error-soleType',
            'Should contain only contain letters and space.'
        )
    }

    const weight = document
        .querySelector('[name="weight"]')
        ?.value.trim();

    const WeightRegex = /^[0-9]+$/;
    if (!weight) {
        showError(
            'error-weight',
            'Weight is required.'
        );
    } else if (!WeightRegex.test(weight)){
        showError(
            'error-weight',
            'Should contain only numbers'
        )
    }

     const countryRegex = /^[A-Za-z\s]+$/;
    const country = document
        .querySelector('[name="countryOfOrigin"]')
        ?.value.trim();

    if (!country) {
        showError(
            'error-countryOfOrigin',
            'Country of origin is required.'
        );
    } else if (!countryRegex.test(country)){
        showError(
            'error-countryOfOrigin',
            'Should contain only contain letters and space.'
        )
    }


    const variantCards = document.querySelectorAll(
        '#variantsContainer .variant-card'
    );

    if (variantCards.length === 0) {
        showToast(
            'At least one color variant is required.',
            'info'
        );

        return false;
    }

    variantCards.forEach((card, index) => {

        const colorName = card
            .querySelector('[name="colorNames[]"]')
            ?.value.trim();

        const colorRegex = /^[A-Za-z\s]+$/;
        if (!colorName) {
            const error = card.querySelector(
                `#error-colorNames_${index}`
            );

            if (error) {
                error.textContent =
                    'Color name is required.';
            }
            isValid = false;
        }else if (!colorRegex.test(colorName)) {
            const error = card.querySelector(
                `#error-colorNames_${index}`
            );

            if (error) {
                error.textContent =
                    'Color name should contain only letters and space.';
            }
            isValid = false;
        } 

        const sizeRows = card.querySelectorAll(
            '.size-row'
        );

        if (sizeRows.length === 0) {

            const error = card.querySelector(
                `#error-sizes_${index}`
            );

            if (error) {
                error.textContent =
                    'At least one size is required.';
            }

            isValid = false;
        }

        sizeRows.forEach(row => {

            const size = row.querySelector(
                'input[name^="sizes_"]'
            );

            const stock = row.querySelector(
                'input[name^="stocks_"]'
            );

            if (!size?.value) {
                isValid = false;
                size?.classList.add('is-invalid');
            }

            if (!stock?.value && stock?.value !== '0') {
                isValid = false;
                stock?.classList.add('is-invalid');
            }

            if (
                size?.value &&
                Number(size.value) <= 0
            ) {
                isValid = false;
                size.classList.add('is-invalid');
            }

            if (
                stock?.value &&
                Number(stock.value) < 0
            ) {
                isValid = false;
                stock.classList.add('is-invalid');
            }
        });
    });

    return isValid;
}

document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('variantsContainer');
    const removedContainer = document.getElementById('removedImagesContainer');
    const form = document.querySelector('form');

    const variantFilesStore = {};

    let cropperInstance = null;
    let currentTargetInput = null;
    let fileQueue = []; 
    let currentFileToCrop = null;

function renderThumbnail(file, idx) {
    const thumbContainer = document.getElementById(`thumbnailsContainer_${idx}`) || 
                           document.querySelector(`.variant-card[data-variant-index="${idx}"] .images-preview-gallery-variant`);

    if (!thumbContainer) {
        console.warn(`Thumbnail container not found for index ${idx}`);
        return;
    }

    const reader = new FileReader();
    reader.onload = (event) => {
        const imgBox = document.createElement('div');
        imgBox.className = 'img-box new-upload-box';
        imgBox.style.position = 'relative';
        imgBox.style.display = 'inline-block';
        imgBox.style.margin = '4px';

        imgBox.innerHTML = `
            <img src="${event.target.result}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px;">
            <button type="button" class="remove-new-img" style="position: absolute; top: 0; right: 0; background: red; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; font-size: 10px; line-height: 1;">✕</button>
        `;

        imgBox.querySelector('.remove-new-img').addEventListener('click', (ev) => {
            ev.stopPropagation();
            const fileIdx = variantFilesStore[idx] ? variantFilesStore[idx].indexOf(file) : -1;
            if (fileIdx > -1) {
                variantFilesStore[idx].splice(fileIdx, 1);
            }
            imgBox.remove();
        });

        thumbContainer.appendChild(imgBox);
    };
    reader.readAsDataURL(file);
}

function processNextInQueue() {
    if (fileQueue.length === 0) {
        document.getElementById('cropperModal').style.display = 'none';
        if (cropperInstance) {
            cropperInstance.destroy();
            cropperInstance = null;
        }
        currentTargetInput = null;
        return;
    }

    currentFileToCrop = fileQueue.shift();

    const reader = new FileReader();
    reader.onload = (event) => {
        const modal = document.getElementById('cropperModal');
        const cropperImage = document.getElementById('cropperTargetImage');
        
        if (!modal || !cropperImage) return;

        cropperImage.src = event.target.result;
        modal.style.display = 'flex';

        setTimeout(() => {
            if (cropperInstance) {
                cropperInstance.destroy();
            }
            cropperInstance = new Cropper(cropperImage, {
                aspectRatio: NaN,
                viewMode: 1,
            });
        }, 50);
    };
    reader.readAsDataURL(currentFileToCrop);
}

document.addEventListener('change', (e) => {
    if (e.target.classList.contains('variant-image-input') || (e.target.type === 'file' && e.target.closest('.variant-card'))) {
        const input = e.target;
        if (!input.files || input.files.length === 0) return;

        currentTargetInput = input;
        
        fileQueue = Array.from(input.files);

        processNextInQueue();

        input.value = ''; 
    }
});

const saveCropBtn = document.getElementById('btnSaveCrop');
if (saveCropBtn) {
    const newSaveBtn = saveCropBtn.cloneNode(true);
    saveCropBtn.replaceWith(newSaveBtn);
    
    document.getElementById('btnSaveCrop').addEventListener('click', () => {
        if (!cropperInstance || !currentTargetInput || !currentFileToCrop) {
            return;
        }

        const canvas = cropperInstance.getCroppedCanvas();
        if (!canvas) return;

        canvas.toBlob((blob) => {
            if (!blob) return;

            const croppedFile = new File([blob], currentFileToCrop.name || 'cropped.jpg', {
                type: currentFileToCrop.type,
                lastModified: Date.now()
            });

            const card = currentTargetInput.closest('.variant-card');
            const idx = currentTargetInput.dataset.index || (card ? card.dataset.variantIndex : '0');

            if (!variantFilesStore[idx]) {
                variantFilesStore[idx] = [];
            }
            variantFilesStore[idx].push(croppedFile);

            renderThumbnail(croppedFile, idx);

            processNextInQueue();

        }, currentFileToCrop.type);
    });
}

document.getElementById('btnCancelCrop')?.addEventListener('click', () => {
    fileQueue = []; 
    document.getElementById('cropperModal').style.display = 'none';
    if (cropperInstance) {
        cropperInstance.destroy();
        cropperInstance = null;
    }
});     

    document.addEventListener('change', (e) => {
        if (e.target.classList.contains('variant-image-input') || (e.target.type === 'file' && e.target.closest('.variant-card'))) {
            const input = e.target;
            const card = input.closest('.variant-card');
            const idx = input.dataset.index || (card ? card.dataset.variantIndex : '0');

            if (!variantFilesStore[idx]) {
                variantFilesStore[idx] = [];
            }

            const thumbContainer = document.getElementById(`thumbnailsContainer_${idx}`) || 
                                   card?.querySelector('.images-preview-gallery-variant');

            Array.from(input.files).forEach((file) => {
                variantFilesStore[idx].push(file);

                if (thumbContainer) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        const imgBox = document.createElement('div');
                        imgBox.className = 'img-box new-upload-box';
                        imgBox.innerHTML = `
                            <img src="${event.target.result}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px; margin: 4px;">
                            <button type="button" class="remove-new-img" style="position: absolute; top: 0; right: 0; background: red; color: white; border: none; border-radius: 50%; cursor: pointer;">✕</button>
                        `;
                        imgBox.style.position = 'relative';
                        imgBox.style.display = 'inline-block';

                        imgBox.querySelector('.remove-new-img').addEventListener('click', (ev) => {
                            ev.stopPropagation();
                            const fileIdx = variantFilesStore[idx].indexOf(file);
                            if (fileIdx > -1) {
                                variantFilesStore[idx].splice(fileIdx, 1);
                            }
                            imgBox.remove();
                        });

                        thumbContainer.appendChild(imgBox);
                    };
                    reader.readAsDataURL(file);
                }
            });

            input.value = '';
        }
    });

    if (form) {
        form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!validateProductForm()) {
        return;
    }

    const variantCards = document.querySelectorAll('#variantsContainer .variant-card');
            if (variantCards.length === 0) {
                if (typeof showToast === 'function') {
                    showToast("At least one color variant is required.", "info");
                } else {
                    alert("At least one color variant is required.");
                }
                return;
            }

            document.querySelectorAll('.text-danger, .error-message, [id^="error-"]').forEach(el => {
                el.textContent = '';
            });

            const formData = new FormData(form);

            Object.keys(variantFilesStore).forEach((idx) => {
                if (variantFilesStore[idx] && variantFilesStore[idx].length > 0) {
                    variantFilesStore[idx].forEach((file) => {
                        formData.append(`variantImages_${idx}`, file);
                    });
                }
            });

            try {
                const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                 'Accept': 'application/json'
                }
            });

                const result = await response.json();

                if (!response.ok) {
                    if (result.errors) {
                        Object.keys(result.errors).forEach(key => {
                            const errorMsg = result.errors[key];

                            let errorSlot = document.getElementById(`error-${key}`);

                            if (!errorSlot) {
    const match = key.match(
        /^(sizes|stocks|variantImages|colorNames|colorHex)_(\d+)/
    );

    if (match) {
        const fieldType = match[1];
        const idx = match[2];

        const card = document.querySelector(
            `.variant-card[data-variant-index="${idx}"]`
        );

        if (card) {
            errorSlot = card.querySelector(
                `#error-${fieldType}_${idx}`
            );
        }
    }
}

                            if (!errorSlot) {
                                errorSlot = document.querySelector(`[name="${key}"]`)?.parentElement?.querySelector('.text-danger, .error-message');
                            }

                            if (errorSlot) {
                                errorSlot.textContent = errorMsg;
                            }
                        });
                    }
                    return;
                }

                window.location.href = result.redirectUrl || '/admin/products';

            } catch (err) {
                console.error("Submission failed:", err);
            }
        });
    }

    if (container) {
        container.addEventListener('click', (e) => {
            
            const dropzone = e.target.closest('.upload-box-variant');
            if (dropzone && !e.target.classList.contains('variant-image-input') && e.target.tagName !== 'BUTTON') {
                const fileInput = dropzone.querySelector('.variant-image-input') || dropzone.querySelector('input[type="file"]');
                if (fileInput) fileInput.click();
                return;
            }

            if (e.target.classList.contains('remove-img')) {
                const box = e.target.closest('.img-box');
                const imgUrl = box.dataset.imgUrl;
                const card = e.target.closest('.variant-card');
                const variantIndex = box.dataset.variantIndex || (card ? card.dataset.variantIndex : '0');

                if (removedContainer && imgUrl) {
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = `removedImages_${variantIndex}[]`;
                    hiddenInput.value = imgUrl;
                    hiddenInput.className = 'removed-image-input';
                    hiddenInput.dataset.variantIndex = variantIndex;
                    removedContainer.appendChild(hiddenInput);
                }
                box.remove();
            }

            if (e.target.classList.contains('add-size')) {
                const card = e.target.closest('.variant-card');
                const index = card.dataset.variantIndex;

                const newRow = document.createElement('div');
                newRow.className = 'size-row';
                newRow.innerHTML = `
                    <input type="number" name="sizes_${index}[]" placeholder="Size">
                    <input type="number" name="stocks_${index}[]" placeholder="Stock">
                    <button type="button" class="remove-size">✕</button>
                `;
                e.target.before(newRow);
            }

            if (e.target.classList.contains('remove-size')) {
                e.target.closest('.size-row').remove();
            }

            if (e.target.classList.contains('remove-variant')) {
                const totalCards = document.querySelectorAll('#variantsContainer .variant-card').length;
                if (totalCards <= 1) {
                    if (typeof showToast === 'function') {
                        showToast("At least one color variant is required.", "info");
                    } else {
                        alert("At least one color variant is required.");
                    }
                    return;
                }
                
                const cardToRemove = e.target.closest('.variant-card');
                const oldIdx = cardToRemove.dataset.variantIndex;

                delete variantFilesStore[oldIdx];

                cardToRemove.remove();
                reindexVariants();
            }
        });
    }

    document.body.addEventListener('input', (e) => {
        if (e.target.matches('.color-picker input[type="color"]')) {
            const picker = e.target;
            const label = picker.parentElement.querySelector('.label');
            if (label) {
                label.textContent = picker.value;
            }
        }
    });
});

function addColorVariantBlock() {
    const container = document.getElementById('variantsContainer');
    const template = document.getElementById('variantTemplate');
    if (!container || !template) return;

    const index = container.querySelectorAll('.variant-card').length;
    
    let html = template.innerHTML.replaceAll('__INDEX__', index);

    container.insertAdjacentHTML('beforeend', html);
}

function reindexVariants() {
    const cards = document.querySelectorAll('#variantsContainer .variant-card');
    
    cards.forEach((card, newIdx) => {
        const oldIdx = card.dataset.variantIndex;
        card.dataset.variantIndex = newIdx;

        const variantIdInput = card.querySelector('input[name^="variantId_"]');
        if (variantIdInput) variantIdInput.name = `variantId_${newIdx}`;

        card.querySelectorAll('input[name^="sizes_"]').forEach(input => {
            input.name = `sizes_${newIdx}[]`;
        });
        card.querySelectorAll('input[name^="stocks_"]').forEach(input => {
            input.name = `stocks_${newIdx}[]`;
        });

        const fileInput = card.querySelector('.variant-image-input') || card.querySelector('input[type="file"]');
        if (fileInput) {
            fileInput.name = `variantImages_${newIdx}`;
            fileInput.dataset.index = newIdx;
        }

        const croppedContainer = card.querySelector('.cropped-files-container');
        if (croppedContainer) croppedContainer.id = `croppedFilesContainer_${newIdx}`;

        const thumbContainer = card.querySelector('.images-preview-gallery-variant');
        if (thumbContainer) thumbContainer.id = `thumbnailsContainer_${newIdx}`;

        const colorError = card.querySelector('[id^="error-colorNames_"]');
        if (colorError) colorError.id = `error-colorNames_${newIdx}`;

        const imgError = card.querySelector('[id^="error-variantImages_"]');
        if (imgError) imgError.id = `error-variantImages_${newIdx}`;

        const sizeError = card.querySelector('[id^="error-sizes_"]');
        if (sizeError) sizeError.id = `error-sizes_${newIdx}`;

        document.querySelectorAll(`#removedImagesContainer .removed-image-input[data-variant-index="${oldIdx}"]`).forEach(input => {
            input.name = `removedImages_${newIdx}[]`;
            input.dataset.variantIndex = newIdx;
        });
    });
}


document.addEventListener('input', (e) => {
        const target = e.target;
        
        if (target.classList.contains('is-invalid')) {
            target.classList.remove('is-invalid');
        }

        const fieldName = target.getAttribute('name');
        if (fieldName) {
            const cleanName = fieldName.replace(/\[\]$/, ''); 
            const errorSlot = document.getElementById(`error-${cleanName}`) || 
                              target.parentElement?.querySelector('.client-error, .text-danger, .error-message');
            if (errorSlot) {
                errorSlot.textContent = '';
            }
        }
    });

    document.addEventListener('change', (e) => {
        const target = e.target;
        
        if (target.classList.contains('is-invalid')) {
            target.classList.remove('is-invalid');
        }

        const fieldName = target.getAttribute('name');
        if (fieldName) {
            const cleanName = fieldName.replace(/\[\]$/, '');
            const errorSlot = document.getElementById(`error-${cleanName}`) || 
                              target.parentElement?.querySelector('.client-error, .text-danger, .error-message');
            if (errorSlot) {
                errorSlot.textContent = '';
            }
        }
    });
</script>

