<div class="customers-page">
  <div class="table-card">

    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
      <h2>Edit Product</h2>
      <a href="/admin/products" class="btn-modal-cancel">✕</a>
    </div>

    <form action="/admin/products/edit/{{product._id}}" 
          method="POST" 
          enumerable="multipart/form-data" 
          class="modal-form-body">

      <div class="form-row split-row4">
        <div class="form-group">
          <label>Product Name</label>
          <input type="text" name="productName" value="{{product.productName}}">
          <small class="field-error"></small>
        </div>

       <div class="form-group">
          <label>Brand</label>
          <select name="brand" class="form-control">
            <option value="" disabled>Select Brand</option>
            {{#each brands}}
              <option value="{{this}}" {{#if (eq this ../product.brand)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>Base Price</label>
          <input type="number" name="regularPrice" min="1" value="{{product.regularPrice}}">
          <small class="field-error"></small>
        </div>
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="description" class="form-control" rows="3">{{product.description}}</textarea>
        <small class="field-error"></small>
      </div>

      <div class="form-row split-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
        <div class="form-group">
          <label>Category</label>
          <select name="parentCategory" id="parentCategory">
            <option value="">Select Parent Category</option>
            {{#each parentCategories}}
              <option value="{{this._id}}" {{#if (eq this._id ../selectedParentId)}}selected{{/if}}>
                {{this.name}}
              </option>
            {{/each}}
          </select>
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>SUBCATEGORY</label>
          <select name="category" id="subCategory" class="form-control">
            <option value="">Select Subcategory</option>
            {{#each subcategories}}
              <option value="{{this._id}}" {{#if (eq this._id ../product.Category._id)}}selected{{/if}}>
                {{this.name}}
              </option>
            {{/each}}
          </select>
          <small class="field-error"></small>
        </div>
      </div>

      <div class="variants-section" style="margin-top:25px;">
        <label class="section-main-label" style="font-weight:600; font-size:16px;">Variants</label>

        <div id="variantsContainer" class="variants-grid-wrapper">
          {{#each product.variants}}
            <div class="variant-card" data-variant-index="{{@index}}" style="border:1px solid #e2e8f0; padding:15px; border-radius:8px; margin-bottom:15px; background:#f8fafc;">
              
              <input type="hidden" name="variantId_{{@index}}" value="{{this._id}}">

              <div class="form-group">
                <label>Color Name</label>
                <input type="text" name="colorNames[]" value="{{this.colorName}}" placeholder="Color Name">
                <small class="field-error"></small>

                <div class="color-picker" style="margin-top: 10px; display:flex; align-items:center; gap:10px;">
                  <input type="color" name="colorHex[]" value="{{this.colorHex}}">
                  <span class="label">{{this.colorHex}}</span>
                  <input type="hidden" name="colorName[]" class="color-name" value="{{this.colorName}}">
                </div>
              </div>

              <div class="form-group variant-images-section" style="margin-top: 20px;">
                <label>Variant Images (Upload unique photos for this color)</label>
                
                <small style="display:block; margin-bottom:10px; color:#64748b;">
                  Existing Images for this color (click × to remove)
                </small>

                <div class="edit-images-grid" style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                  {{#each this.images}}
                    <div class="img-box" style="position:relative;" data-img-url="{{this}}" data-img-name="{{this}}" data-variant-index="{{@../index}}">
                      <img src="{{this}}" style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #cbd5e1;">
                      <button type="button" class="remove-img"
                        style="position:absolute;top:-5px;right:-5px;background:#ef4444;color:white;border:none;border-radius:50%;width:20px;height:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;">
                        ✕
                      </button>
                    </div>
                  {{/each}}
                </div>

                <div class="image-drag-dropzone upload-box-variant" style="border: 2px dashed #cbd5e1; padding: 20px; text-align: center; border-radius: 8px; background: #fff; cursor: pointer;">
                  <input 
                      type="file" 
                      class="variant-image-input"
                      data-index="{{@index}}"
                      multiple 
                      accept="image/*" 
                      style="display:none"
                  >
                  <div class="dropzone-inner-ui">
                      <div class="camera-icon" style="font-size: 24px; margin-bottom: 5px;">📷</div>
                      <p class="main-drop-text" style="margin:0; font-weight:500;">Click to upload more color specific images</p>
                      <p class="sub-drop-text" style="margin:0; color:#64748b; font-size:12px;">JPG, PNG up to 2MB</p>
                  </div>
                </div>
                
                <div class="cropped-files-container" id="croppedFilesContainer_{{@index}}"></div>
                <div class="images-preview-gallery-variant" id="thumbnailsContainer_{{@index}}" style="display: flex; flex-wrap: wrap; margin-top: 10px;"></div>
                <small class="field-error image-error"></small>
              </div>

              <div class="sizes-container" style="margin-top:15px;">
                <label style="font-weight:500; display:block; margin-bottom:5px;">Sizes & Stock</label>
                
                {{#each this.sizes}}
                  <div class="size-row" style="display:flex; gap:10px; margin-bottom:10px; align-items:flex-start;">
                    <div style="flex:1;">
                      <input type="number" name="sizes_{{@../index}}[]" value="{{this.size}}" placeholder="Size">
                      <small class="field-error"></small>
                    </div>
                    <div style="flex:1;">
                      <input type="number" name="stocks_{{@../index}}[]" value="{{this.stock}}" placeholder="Stock">
                      <small class="field-error"></small>
                    </div>
                    <button type="button" class="remove-size" style="background:#ef4444; color:white; border:none; border-radius:4px; padding:6px 10px; cursor:pointer;">X</button>
                  </div>
                {{/each}}

                <button type="button" class="edit-size add-size" style="margin-top:5px;">+ Add size</button>
              </div>

              <button type="button" class="remove-variant" style="margin-top:15px; background:#fee2e2; color:#ef4444; border:1px solid #fca5a5; padding:6px 12px; border-radius:4px; cursor:pointer; font-size:13px;">
                Remove Variant
              </button>
            </div>
          {{/each}}
        </div>

        <div id="removedImagesContainer"></div>

        <button type="button" class="btn-add-variant-group" id="addVariantBtn" style="margin-top:10px; padding:8px 16px; background:#004d40; color:white; border:none; border-radius:6px; cursor:pointer;">
          + Add another color variant
        </button>
      </div>

      <div class="form-row split-row4" style="margin-top:25px;">
        <div class="form-group">
          <label>Material</label>
          <input type="text" name="material" value="{{product.material}}">
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>Closure Type</label>
          <input type="text" name="closureType" value="{{product.closureType}}">
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>Sole Type</label>
          <input type="text" name="soleType" value="{{product.soleType}}">
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>Weight</label>
          <input type="text" name="weight" value="{{product.weight}}">
          <small class="field-error"></small>
        </div>

        <div class="form-group">
          <label>Country of Origin</label>
          <input type="text" name="countryOfOrigin" value="{{product.countryOfOrigin}}">
          <small class="field-error"></small>
        </div>
      </div>

      <div class="modal-action-footer" style="margin-top:30px; display:flex; justify-content:flex-end; gap:10px;">
        <a href="/admin/products" class="btn-modal-cancel">Cancel</a>
        <button type="submit" class="btn-modal-save">Update Changes</button>
      </div>

    </form>
  </div>
</div>

<div id="variantTemplate" style="display:none;">
  <div class="variant-card" data-variant-index="TEMPLATE_INDEX" style="border:1px solid #e2e8f0; padding:15px; border-radius:8px; margin-bottom:15px; background:#f8fafc;">
    <div class="form-group">
      <label>Color Name</label>
      <input type="text" name="colorNames[]" placeholder="Color Name">
      <small class="field-error"></small>

      <div class="color-picker" style="margin-top: 10px; display:flex; align-items:center; gap:10px;">
        <input type="color" name="colorHex[]" value="#000000">
        <span class="label">#000000</span>
        <input type="hidden" name="colorName[]" class="color-name">
      </div>
    </div>

    <div class="form-group variant-images-section" style="margin-top: 20px;">
        <label>Variant Images (Upload unique photos for this color)</label>
        
        <div class="image-drag-dropzone upload-box-variant" style="border: 2px dashed #cbd5e1; padding: 20px; text-align: center; border-radius: 8px; background: #fff; cursor: pointer;">
            <input 
                type="file" 
                class="variant-image-input"
                data-index="TEMPLATE_INDEX"
                multiple 
                accept="image/*" 
                style="display:none"
            >
            <div class="dropzone-inner-ui">
                <div class="camera-icon" style="font-size: 24px; margin-bottom: 5px;">📷</div>
                <p class="main-drop-text" style="margin:0; font-weight:500;">Click to upload color specific images</p>
                <p class="sub-drop-text" style="margin:0; color:#64748b; font-size:12px;">JPG, PNG up to 2MB</p>
            </div>
        </div>
        <div class="cropped-files-container" id="croppedFilesContainer_TEMPLATE_INDEX"></div>
        <div class="images-preview-gallery-variant" id="thumbnailsContainer_TEMPLATE_INDEX" style="display: flex; flex-wrap: wrap; margin-top: 10px;"></div>
        <small class="field-error image-error"></small>
    </div>

    <div class="sizes-container" style="margin-top:15px;">
      <label style="font-weight:500; display:block; margin-bottom:5px;">Sizes & Stock</label>
      <div class="size-row" style="display:flex; gap:10px; margin-bottom:10px; align-items:flex-start;">
        <div style="flex:1;">
          <input type="number" name="sizes_TEMPLATE_INDEX[]" placeholder="Size">
          <small class="field-error"></small>
        </div>
        <div style="flex:1;">
          <input type="number" name="stocks_TEMPLATE_INDEX[]" placeholder="Stock">
          <small class="field-error"></small>
        </div>
        <button type="button" class="remove-size" style="background:#ef4444; color:white; border:none; border-radius:4px; padding:6px 10px; cursor:pointer;">X</button>
      </div>
      <button type="button" class="add-size" style="margin-top: 5px;">+ Add size</button>
    </div>

    <button type="button" class="remove-variant" style="margin-top:15px; background:#fee2e2; color:#ef4444; border:1px solid #fca5a5; padding:6px 12px; border-radius:4px; cursor:pointer; font-size:13px;">
      Remove Variant
    </button>
  </div>
</div>

<div id="cropperModal" class="cropper-modal-container" style="display: none;">
    <div class="cropper-wrapper">
        <h3>Crop Variant Image</h3>
        <div class="image-preview-box">
            <img id="cropperTargetImage" src="" alt="Target Crop" style="max-width: 100%; max-height: 100%; display: block;">
        </div>
        <div class="cropper-actions">
            <button type="button" id="btnCancelCrop" class="btn btn-secondary">Cancel</button>
            <button type="button" id="btnSaveCrop" class="btn btn-primary">Crop & Save</button>
        </div>
    </div>
</div>

<style>
.cropper-modal-container {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);
    display: none; align-items: center; justify-content: center; z-index: 999999;
}
.cropper-wrapper {
    background: #ffffff; padding: 20px; border-radius: 12px;
    max-width: 500px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
}
.cropper-wrapper h3 { margin-top: 0; margin-bottom: 14px; font-size: 16px; font-weight: 600; color: #0f172a; }
.image-preview-box {
    max-height: 350px; height: 350px; margin-bottom: 18px; overflow: hidden;
    background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px;
    display: flex; justify-content: center; align-items: center;
}
.cropper-actions { display: flex; justify-content: flex-end; gap: 10px; }
.btn { padding: 8px 14px; border: none; border-radius: 6px; font-size: 13px; font-weight: 500; cursor: pointer; }
.btn-secondary { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
.btn-primary { background: #004d40; color: #ffffff; }
</style>

<script>
let variantCounter = document.querySelectorAll('#variantsContainer .variant-card').length;
let variantFilesMap = {};

for (let i = 0; i < variantCounter; i++) {
    variantFilesMap[i] = [];
}

function initColorPickers(scope = document) {
  scope.querySelectorAll('.color-picker').forEach(wrapper => {
    const input = wrapper.querySelector('input[type="color"]');
    const label = wrapper.querySelector('.label');
    const hidden = wrapper.querySelector('.color-name');

    function update() {
      label.textContent = input.value.toUpperCase();
      if(hidden) hidden.value = input.value;
    }
    input.removeEventListener('input', update);
    input.addEventListener('input', update);
  });
}

document.getElementById("addVariantBtn").addEventListener("click", function () {
  const template = document.getElementById("variantTemplate");
  const clone = template.querySelector(".variant-card").cloneNode(true);
  
  const targetIndex = variantCounter;
  clone.setAttribute("data-variant-index", targetIndex);
  variantFilesMap[targetIndex] = []; 
  
  let innerHTMLContent = clone.innerHTML;
  innerHTMLContent = innerHTMLContent.replace(/TEMPLATE_INDEX/g, targetIndex);
  clone.innerHTML = innerHTMLContent;

  document.getElementById("variantsContainer").appendChild(clone);
  initColorPickers(clone);
  
  variantCounter++;
});

document.addEventListener("click", function(e) {
    const dropzone = e.target.closest('.upload-box-variant');
    if (dropzone && e.target.tagName !== 'INPUT') {
        dropzone.querySelector('.variant-image-input').click();
    }
});

document.addEventListener("click", function (e) {
  if (e.target.classList.contains("remove-variant")) {
    const card = e.target.closest(".variant-card");
    const index = card.getAttribute("data-variant-index");
    delete variantFilesMap[index];
    card.remove();
  }
});

document.addEventListener("click", function (e) {
  if (e.target.classList.contains("add-size")) {
    const container = e.target.closest(".sizes-container");
    const parentCard = e.target.closest(".variant-card");
    const currentIndex = parentCard.getAttribute("data-variant-index");

    const row = document.createElement("div");
    row.classList.add("size-row");
    row.style.display = "flex"; row.style.gap = "10px"; row.style.marginBottom = "5px";

    row.innerHTML = `
      <input type="number" name="sizes_${currentIndex}[]" placeholder="Size">
      <input type="number" name="stocks_${currentIndex}[]" placeholder="Stock">
      <button type="button" class="remove-size" style="background:#ef4444; color:white; border:none; border-radius:4px; padding:0 10px; cursor:pointer;">X</button>
    `;
    container.insertBefore(row, e.target);
  }
});

document.addEventListener("click", function (e) {
  if (e.target.classList.contains("remove-size")) {
    e.target.closest(".size-row").remove();
  }
});


document.addEventListener("DOMContentLoaded", function() {
    const parentSelect = document.getElementById('parentCategory');
    const subSelect = document.getElementById('subCategory');

    if (!parentSelect) {
        console.error("DEBUG: parentCategory select element not found!");
        return;
    }

    parentSelect.addEventListener('change', async function() {
        const parentId = this.value;
        console.log("DEBUG: Selection changed to ID:", parentId);

        subSelect.innerHTML = '<option value="">Loading...</option>';
        
        if (!parentId) {
            subSelect.innerHTML = '<option value="">Select Subcategory</option>';
            return;
        }

        try {
            console.log("DEBUG: Fetching URL:", `/admin/categories/${parentId}/subcategories`);
            
            const response = await fetch(`/admin/categories/${parentId}/subcategories`);
            const data = await response.json();
            
            console.log("DEBUG: Data received:", data);

            subSelect.innerHTML = '<option value="">Select Subcategory</option>';

            if (data.success && data.subcategories && data.subcategories.length > 0) {
                console.log(`DEBUG: Populating ${data.subcategories.length} subcategories.`);
                data.subcategories.forEach(sub => {
                    const option = document.createElement('option');
                    option.value = sub._id;
                    option.textContent = sub.name;
                    subSelect.appendChild(option);
                });
            } else {
                console.warn("DEBUG: Server returned success but no subcategories array found or array is empty.");
                subSelect.innerHTML = '<option value="">No subcategories found</option>';
            }
        } catch (error) {
            console.error("DEBUG: Critical error in fetch:", error);
            subSelect.innerHTML = '<option value="">Error!</option>';
        }
    });
});

document.addEventListener('click', function(e) {
  if (e.target.classList.contains('remove-img')) {
    const box = e.target.closest('.img-box');
    const imageName = box.getAttribute('data-img-name');
    const variantIndex = box.getAttribute('data-variant-index');
    
    const hiddenInput = document.createElement('input');
    hiddenInput.type = 'hidden';
    hiddenInput.name = `removedImages_${variantIndex}[]`;
    hiddenInput.value = imageName;
    
    document.getElementById('removedImagesContainer').appendChild(hiddenInput);
    box.remove();
  }
});


let cropper = null;
let currentFilesQueue = [];
let currentQueueIndex = 0;
let currentVariantIndex = null;

const cropperModal = document.getElementById('cropperModal');
const cropperTargetImage = document.getElementById('cropperTargetImage');
const btnSaveCrop = document.getElementById('btnSaveCrop');
const btnCancelCrop = document.getElementById('btnCancelCrop');

document.addEventListener('change', (e) => {
    if (e.target && e.target.classList.contains('variant-image-input')) {
        if (!e.target.files || e.target.files.length === 0) return;

        const files = Array.from(e.target.files);
        const filteredFiles = [];

        const allowedExtensions = /(\.jpg|\.jpeg|\.png|\.webp)$/i;

        for (let i = 0; i < files.length; i++) {
            const file = files[i];

            if (!file.type.startsWith('image/') || !allowedExtensions.exec(file.name)) {
                const oldToast = document.querySelector('.custom-validation-toast');
                if (oldToast) oldToast.remove();

                const toast = document.createElement('div');
                toast.className = 'custom-validation-toast';
                toast.innerText = "Invalid file format Only JPG, JPEG, PNG, and WebP formats are allowed.";

                document.body.appendChild(toast);
                
                setTimeout(() => toast.classList.add('show'), 10);
              
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, 4000);

                continue; 
            }

            if (file.size > 2 * 1024 * 1024) {
                const oldToast = document.querySelector('.custom-validation-toast');
                if (oldToast) oldToast.remove();

                const toast = document.createElement('div');
                toast.className = 'custom-validation-toast';
                toast.innerText = `"${file.name}" exceeds the maximum 2MB size limit!`;

                document.body.appendChild(toast);
                setTimeout(() => toast.classList.add('show'), 10);
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, 4000);
                
                continue; 
            }

            filteredFiles.push(file);
        }

        e.target.value = ""; 

        if (filteredFiles.length === 0) { 
            return; 
        }

        currentVariantIndex = e.target.getAttribute('data-index');
        currentFilesQueue = filteredFiles;
        currentQueueIndex = 0;

        openCropperForNextInQueue();
    }
});

function openCropperForNextInQueue() {
    if (currentQueueIndex >= currentFilesQueue.length) {
        finalizeVariantFilesInput(currentVariantIndex);
        return;
    }

    if (cropper) { cropper.destroy(); cropper = null; }

    const currentFile = currentFilesQueue[currentQueueIndex];
    const reader = new FileReader();
    
    reader.onload = function(event) {
        cropperTargetImage.src = event.target.result;
        cropperModal.style.display = 'flex';

        cropperTargetImage.onload = function() {
            if (cropper) cropper.destroy();
            cropper = new Cropper(cropperTargetImage, {
                aspectRatio: 1, 
                viewMode: 1,
                autoCropArea: 0.8,
                responsive: true,
                restore: false
            });
        };
    };
    reader.readAsDataURL(currentFile);
}

btnSaveCrop.addEventListener('click', () => {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });

    canvas.toBlob((blob) => {
        const originalName = currentFilesQueue[currentQueueIndex].name;
        const croppedFile = new File([blob], originalName, { type: 'image/jpeg' });

        if (!variantFilesMap[currentVariantIndex]) {
            variantFilesMap[currentVariantIndex] = [];
        }
        variantFilesMap[currentVariantIndex].push(croppedFile);

        cropperModal.style.display = 'none';
        if (cropper) { cropper.destroy(); cropper = null; }

        renderVariantImagesGallery(currentVariantIndex);
        currentQueueIndex++;
        openCropperForNextInQueue();
    }, 'image/jpeg', 0.9);
});

function renderVariantImagesGallery(variantIdx) {
    const thumbContainer = document.getElementById(`thumbnailsContainer_${variantIdx}`);
    if (!thumbContainer) return;
    thumbContainer.innerHTML = ""; 

    variantFilesMap[variantIdx].forEach((file, fileIdx) => {
        const wrapper = document.createElement("div");
        wrapper.style.position = "relative"; wrapper.style.display = "inline-block"; wrapper.style.margin = "10px";

        const img = document.createElement('img');
        img.src = URL.createObjectURL(file); 
        img.style.width = "80px"; img.style.height = "80px"; img.style.objectFit = "cover"; img.style.borderRadius = "6px";

        const btn = document.createElement("button");
        btn.innerText = "×"; btn.type = "button";
        btn.style.position = "absolute"; btn.style.top = "0"; btn.style.right = "0"; btn.style.background = "red";
        btn.style.color = "white"; btn.style.border = "none"; btn.style.borderRadius = "50%";
        btn.style.width = "20px"; btn.style.height = "20px"; btn.style.cursor = "pointer";

        btn.onclick = () => {
            variantFilesMap[variantIdx].splice(fileIdx, 1);
            renderVariantImagesGallery(variantIdx);
            finalizeVariantFilesInput(variantIdx);
        };

        wrapper.appendChild(img);
        wrapper.appendChild(btn);
        thumbContainer.appendChild(wrapper);
    });
}

function finalizeVariantFilesInput(variantIdx) {
    const hiddenContainer = document.getElementById(`croppedFilesContainer_${variantIdx}`);
    if (!hiddenContainer) return; 
    
    if (!variantFilesMap[variantIdx] || variantFilesMap[variantIdx].length === 0) {
        hiddenContainer.innerHTML = "";
        return; 
    }

    hiddenContainer.innerHTML = ""; 

    const dataTransfer = new DataTransfer();
    variantFilesMap[variantIdx].forEach(file => {
        dataTransfer.items.add(file);
    });

    const hiddenFileInput = document.createElement('input');
    hiddenFileInput.type = 'file';
    hiddenFileInput.name = `variantImages_${variantIdx}`; 
    hiddenFileInput.multiple = true;
    hiddenFileInput.style.display = 'none';
    hiddenFileInput.files = dataTransfer.files; 
    
    hiddenContainer.appendChild(hiddenFileInput);
}

document.querySelector('form').addEventListener('submit', function(e) {
    let formIsValid = true;
    let textBody = "";

    function showFieldError(input, message) {
        if (!input) return;
        input.classList.add("input-error");
        const wrapper = input.closest('.form-group') || input.parentElement;
        const errorBox = wrapper ? wrapper.querySelector('.field-error') : null;
        if (errorBox) errorBox.textContent = message;
    }

    function clearFieldError(input) {
        if (!input) return;
        input.classList.remove("input-error");
        const wrapper = input.closest('.form-group') || input.parentElement;
        const errorBox = wrapper ? wrapper.querySelector('.field-error') : null;
        if (errorBox) errorBox.textContent = "";
    }

    const productNameInput = document.querySelector('[name="productName"]');
    const brandInput = document.querySelector('[name="brand"]');
    const priceInput = document.querySelector('[name="regularPrice"]');
    const descriptionInput = document.querySelector('[name="description"]');
    const parentCategoryInput = document.querySelector('[name="parentCategory"]');
    const subcategoryInput = document.querySelector('[name="category"]');
    
    const materialInput = document.querySelector('[name="material"]');
    const closureTypeInput = document.querySelector('[name="closureType"]');
    const soleTypeInput = document.querySelector('[name="soleType"]');
    const weightInput = document.querySelector('[name="weight"]');
    const countryInput = document.querySelector('[name="countryOfOrigin"]');

    const mainInputs = [
        productNameInput, brandInput, priceInput, descriptionInput, 
        parentCategoryInput, subcategoryInput, materialInput, 
        closureTypeInput, soleTypeInput, weightInput, countryInput
    ];

    mainInputs.forEach(clearFieldError);

    if (!productNameInput || !productNameInput.value.trim()) {
        showFieldError(productNameInput, "Product name is required.");
        formIsValid = false;
    }
    if (!brandInput || !brandInput.value.trim()) {
        showFieldError(brandInput, "Please select a brand.");
        formIsValid = false;
    }
    if (!priceInput || !priceInput.value.trim() || Number(priceInput.value.trim()) <= 500) {
    showFieldError(priceInput, "Price must be greater than 500");
    formIsValid = false;
    }
    if (!descriptionInput || !descriptionInput.value.trim()) {
        showFieldError(descriptionInput, "Description is required.");
        formIsValid = false;
    }
    if (!parentCategoryInput || !parentCategoryInput.value.trim()) {
        showFieldError(parentCategoryInput, "Please select a parent category.");
        formIsValid = false;
    }
    if (!subcategoryInput || !subcategoryInput.value.trim()) {
        showFieldError(subcategoryInput, "Please select a subcategory.");
        formIsValid = false;
    }
    if (materialInput && !materialInput.value.trim()) {
        showFieldError(materialInput, "Material is required.");
        formIsValid = false;
    }
    if (closureTypeInput && !closureTypeInput.value.trim()) {
        showFieldError(closureTypeInput, "Closure type is required.");
        formIsValid = false;
    }
    if (soleTypeInput && !soleTypeInput.value.trim()) {
        showFieldError(soleTypeInput, "Sole type is required.");
        formIsValid = false;
    }
    if (weightInput && !weightInput.value.trim()) {
        showFieldError(weightInput, "Weight is required.");
        formIsValid = false;
    }
    if (countryInput && !countryInput.value.trim()) {
        showFieldError(countryInput, "Country of origin is required.");
        formIsValid = false;
    }

    const cards = document.querySelectorAll('#variantsContainer .variant-card');
    
    if (cards.length === 0) {
        formIsValid = false;
        textBody = "Please add at least one color variant configuration.";
    } else {
        for (const card of cards) {
            const variantIdx = card.getAttribute('data-variant-index');
            const colorNameInput = card.querySelector('input[name="colorNames[]"]');
            const colorTitle = colorNameInput && colorNameInput.value.trim() ? colorNameInput.value.trim() : `Variant #${parseInt(variantIdx) + 1}`;

            clearFieldError(colorNameInput);
            if (!colorNameInput || !colorNameInput.value.trim()) {
                showFieldError(colorNameInput, "Color name is required.");
                formIsValid = false;
            }

            const remainingExistingImages = card.querySelectorAll('.edit-images-grid .img-box').length;
            const newUploadedImages = (typeof variantFilesMap !== 'undefined' && variantFilesMap[variantIdx]) ? variantFilesMap[variantIdx].length : 0;
            const totalImagesCount = remainingExistingImages + newUploadedImages;
            const imageErrorBox = card.querySelector('.image-error');

            if (imageErrorBox) imageErrorBox.textContent = "";

            if (totalImagesCount < 1) { 
                formIsValid = false;
                if (imageErrorBox) imageErrorBox.textContent = `Please upload at least one image for "${colorTitle}".`;
                textBody = `The color variant "${colorTitle}" must have at least one image.`;
            }

            const sizeRows = card.querySelectorAll('.sizes-container .size-row');
            
            if (sizeRows.length === 0) {
                formIsValid = false;
                textBody = `The color variant "${colorTitle}" must have at least one size row added.`;
                continue;
            }

            for (const row of sizeRows) {
                const sizeInput = row.querySelector(`input[name^="sizes_"]`);
                const stockInput = row.querySelector(`input[name^="stocks_"]`);

                clearFieldError(sizeInput);
                clearFieldError(stockInput);

                const sizeValue = sizeInput ? sizeInput.value.trim() : "";
                const stockValue = stockInput ? stockInput.value.trim() : "";

                if (sizeValue === "" || stockValue === "") {
                    formIsValid = false;
                    if (sizeValue === "") showFieldError(sizeInput, "Size required");
                    if (stockValue === "") showFieldError(stockInput, "Stock required");
                    textBody = `Please fill out all Size and Stock fields for "${colorTitle}".`;
                }

                if (parseFloat(sizeValue) < 0 || parseInt(stockValue) < 0) {
                    formIsValid = false;
                    if (parseFloat(sizeValue) < 0) showFieldError(sizeInput, "Cannot be negative");
                    if (parseInt(stockValue) < 0) showFieldError(stockInput, "Cannot be negative");
                    textBody = `Size and Stock values cannot be negative numbers in "${colorTitle}".`;
                }
            }
        }
    }

    if (!formIsValid) {
        e.preventDefault(); 
        
        window.scrollTo({ top: 0, behavior: 'smooth' });

        const oldToast = document.querySelector('.custom-validation-toast');
        if (oldToast) oldToast.remove();

        const toast = document.createElement('div');
        toast.className = 'custom-validation-toast';
        toast.innerText = textBody || "Please correct the highlighted errors before submitting.";

        document.body.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 300);
        }, 4000);

        return false;
    }

    if (typeof variantFilesMap !== 'undefined') {
        Object.keys(variantFilesMap).forEach(variantIdx => {
            finalizeVariantFilesInput(variantIdx);
        });
    }
});

btnCancelCrop.addEventListener('click', () => {
    cropperModal.style.display = 'none';
    if (cropper) { cropper.destroy(); cropper = null; }
    currentQueueIndex++;
    openCropperForNextInQueue();
});

initColorPickers();
</script>