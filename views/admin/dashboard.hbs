<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StepHive Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin-style.css">
</head>
<body>
    <div class="dashboard-container">
       

        <main class="main-content">
            <header class="top-bar">
                <h6>Dashboard</h6>
                <div class="search-bar">
                    <input type="text" placeholder="Search data, users, or reports">
                </div>
            </header>

            <section class="stats-grid">
                <div class="stat-card">
                    <p>Total Sales</p>
                    <h3>₹350K <span>+23.5%</span></h3>
                </div>
                <div class="stat-card">
                    <p>Total Orders</p>
                    <h3>10.7K <span>+12.4%</span></h3>
                </div>
                <div class="stat-card">
                    <p>Pending & Canceled</p>
                    <h3>450 <span>-2.1%</span></h3>
                </div>
            </section>

            <section class="content-grid">
                <div class="chart-container">
                    <h3>Report for this week</h3>
                    <div class="placeholder-chart">
                        <p>[Area Chart Visualization]</p>
                    </div>
                </div>
                <div class="table-container">
                    <h3>Recent Transactions</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>#5410</td><td>01 Oct</td><td><span class="status pending">Pending</span></td><td>₹587</td></tr>
                            <tr><td>#5412</td><td>01 Oct</td><td><span class="status paid">Paid</span></td><td>₹912</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</body>
</html>