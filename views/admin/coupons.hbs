<div class="customers-page">
    <div class="table-card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2>Coupons</h2>
        <div class="controls">
             <div class="search-wrapper" style="flex-grow: 1; margin: 0;">
          <form id="searchForm" action="/admin/coupons" method="GET" style="display: flex; align-items: center; width: 100%; margin: 0;">
            <i class="fas fa-search" style="margin-right: 10px;"></i>
                 <input type="text" name="search" id="searchInput"value="{{search}}" placeholder="Search by name or code..."oninput="autoSearch(this)">
                 {{#if search}}
                  <a href="/admin/coupons" class="search-clear-btn" >
                   <i class="fas fa-times-circle"></i>
                 </a>
                 {{/if}}
          </form>
        </div>
            <a href="/admin/coupons/add" class="btn-add-coupon" >Add coupon</a>    
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Minimum Amount</th>
                    <th>Maximum Amount</th>
                    <th>Start Date</th>
                    <th>Expiration Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {{#each coupons}}
                <tr>
                    <td class="font-coupon">{{this.code}}</td>
                    <td class="font-coupon">{{this.discountValue}}%</td>
                    <td class="font-coupon">{{this.min_orderAmount}}</td>
                    <td class="font-coupon">{{this.maxDiscountAmount}}</td>
                    <td class="font-coupon">{{formattedDate this.startDate}}</td>
                    <td class="font-coupon">{{formattedDate this.expiryDate}}</td>
                    <td>
                        {{#if (eq this.status 'Active')}}
                            <span class="status-active">Active</span>
                        {{else}}
                            <span class="status-inactive">Inactive</span>
                        {{/if}}
                    </td>
                   <td>
                <a href="/admin/coupons/edit/{{this._id}}" class="btn-edit-small">Edit</a> 
                <form action="/admin/coupons/toggle-status/{{this._id}}" method="POST" style="display:inline;">
                  <button type="button" 
                    class="btn-unlist-small {{#if (eq this.status 'Active')}}btn-delete{{else}}btn-success{{/if}}"
                   onclick="confirmToggle(this, '{{this.name}}', {{#if (eq this.status 'Inactive')}}true{{else}}false{{/if}})">
                     {{#if (eq this.status 'Active')}}Unlist{{else}}List{{/if}}
                  </button>
                </form>
               </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
    </div>

    <div class="pagination">
   {{#if hasPrevPage}}
    <a href="/admin/coupons?page={{prevPage}}&search={{search}}" class="page-link">« Prev</a>
   {{/if}}

   <span class="page-info">Page {{currentPage}} of {{totalPages}}</span>

   {{#if hasNextPage}}
    <a href="/admin/coupons?page={{nextPage}}&search={{search}}"  class="page-link">Next »</a>
   {{/if}}
</div>
</div>
</div>

<script>
function confirmToggle(button, name, isCurrentlyInactive) {
    const action = isCurrentlyInactive ? 'list' : 'unlist';
    
    Swal.fire({
        title: 'Are you sure?',
        text: `Do you really want to ${action} the coupon "${name}"?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isCurrentlyInactive ? '#28a745' : '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: `Yes, ${action}!`,
        width: '320px',             
        padding: '1rem',          
        customClass: {
            popup: 'small-swal-popup',
            title: 'small-swal-title',
            htmlContainer: 'small-swal-text'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            button.closest('form').submit();
        }
    });
}

    let timeout = null;

    function autoSearch(input) {
        clearTimeout(timeout);

        timeout = setTimeout(() => {
            document.getElementById('searchForm').submit();
        }, 500); 
    }

</script>