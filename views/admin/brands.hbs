<div class="admin-dashboard-wrapper">
    <!-- Dark Backdrop Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Dashboard Flex Container -->
    <div class="dashboard-container">
        <aside class="sidebar-wrapper" id="sidebarWrapper">
            {{> admin-sidebar}}
        </aside>
<div class="brands-page">
    <div class="table-card">

        <header class="card-header">
            <h1 class="page-title">Brands</h1>

            <div class="header-actions">
                <div class="search-container">
                    <form action="/admin/brands" method="GET" class="search-form">
                        <div class="search-wrapper">
                            <i class="fas fa-search"></i>
                            <input
                                type="text"
                                name="search"
                                placeholder="Search brands..."
                                value="{{searchQuery}}"
                                class="search-input"
                                oninput="autoSearch(this)"
                            >
                            {{#if searchQuery}}
                                <a href="/admin/brands" class="search-clear-btn">
                                    <i class="fas fa-times-circle"></i>
                                </a>
                            {{/if}}
                        </div>
                    </form>
                </div>

                <a href="/admin/brands/add" class="btn-cat">Add Brand</a>    
            </div>
        </header>

        <main class="table-wrapper">
            <table class="brand-table">
                <thead>
                    <tr>
                        <th>BRAND</th>
                        <th>NAME</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center">STATUS</th>
                        <th class="text-center">ACTION</th>
                    </tr>
                </thead>

                <tbody>
                    {{#if brands.length}}
                        {{#each brands}}
                        <tr>
                            <td>
                                <div class="brand-logo-cell">
                                    <div class="brand-logo-container">
                                        {{#if this.logo}}
                                            <img src="{{this.logo}}" alt="{{this.name}}" class="brand-logo-img">
                                        {{else}}
                                            <div class="brand-logo-placeholder"></div>
                                        {{/if}}
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="brand-name-wrapper">
                                    <span class="brand-names">
                                        {{this.name}}
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="brand-desc">
                                    {{this.description}}
                                </span>
                            </td>

                            <td class="text-center">
                                {{#if this.isListed}}
                                    <span class="status-badge status-listed">Listed</span>
                                {{else}}
                                    <span class="status-badge status-unlisted">Unlisted</span>
                                {{/if}}
                            </td>
                            <td>
                                <div class="brand-actions-wrapper">
                                    <a href="/admin/brands/edit/{{this._id}}" class="btn-edit-small">Edit</a>
                                    
                                    <form action="/admin/brands/toggle-status/{{this._id}}?page={{../currentPage}}&search={{../searchQuery}}" method="POST" class="status-toggle-form">
                                        <button type="submit" 
                                                class="btn-unlist-small {{#if this.isListed}}active{{else}}inactive{{/if}}">
                                            {{#if this.isListed}}Unlist{{else}}List{{/if}}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="5" class="table-empty-state">
                                No brand records discovered matching your search context.
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </main>

        {{#if brands.length}}
             <div class="pagination">
                {{#if hasPrevPage}}
                    <a href="/admin/brands?page={{prevPage}}&search={{searchQuery}}" class="page-link">&laquo; Prev</a>
                {{/if}}

                <span class="page-info">Page {{currentPage}} of {{totalPages}}</span>

                {{#if hasNextPage}}
                    <a href="/admin/brands?page={{nextPage}}&search={{searchQuery}}" class="page-link">Next &raquo;</a>
                {{else}}
                    <span class="page-link disabled">Next &raquo;</span>
                {{/if}}
            </div>
        {{/if}}
    </div>
</div>
</div>
</div>

<script>
let searchTimeout = null;

function autoSearch(input) {
    clearTimeout(searchTimeout);

    searchTimeout = setTimeout(() => {
        input.form.submit();
    }, 500);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.status-toggle-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            const button = this.querySelector('button');
            const actionText = button.textContent.trim().toLowerCase(); 
            const isUnlisting = (actionText === 'unlist');
            const targetColor = isUnlisting ? '#ef4444' : '#0d9488';

            Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to change this brand status to ${isUnlisting ? 'unlisted' : 'listed'}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: targetColor,
                cancelButtonColor: '#94a3b8',
                confirmButtonText: `Yes, ${actionText} it!`,
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'small-swal-popup',
                    title: 'small-swal-title',
                    htmlContainer: 'small-swal-text'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); 
                }
            });
        });
    });
});
</script>