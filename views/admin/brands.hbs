<div class="customers-page">
    <div class="table-card">

        <header class="card-header">
            <h1 class="page-title">Brands</h1>

            <div class="header-actions">
                <div class="search-container">
                    <form action="/admin/brands" method="GET" class="search-form">
                        <input
                            type="text"
                            name="search"
                            placeholder="Search brands..."
                            value="{{searchQuery}}"
                            class="search-input"
                        >

                        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>

                        {{#if searchQuery}}
                            <a href="/admin/brands" class="search-clear-btn">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {{/if}}
                    </form>
                </div>

                <a href="/admin/brands/add" class="btn-cat" >Add Brand</a>    
            </div>
        </header>

        <main class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>BRAND NAME</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center">STATUS</th>
                        <th class="text-center">ACTION</th>
                    </tr>
                </thead>

                <tbody>
                    {{#if brands.length}}
                        {{#each brands}}
                        <tr>
                            <td>
                                <div class="brand-cell">
                                    <div class="brand-logo-container">
                                        {{#if this.logo}}
                                            <img
                                                src="{{this.logo}}"
                                                alt="{{this.name}}"
                                                class="brand-logo-img"
                                            >
                                        {{else}}
                                            <div class="brand-logo-placeholder"></div>
                                        {{/if}}
                                    </div>
                                    <span class="brand-name" style="font-weight: 600; color: #0f172a;">
                                        {{this.name}}
                                    </span>
                                </div>
                            </td>

                            <td>
                                <span class="brand-desc">
                                    {{this.description}}
                                </span>
                            </td>

                            <td class="text-center">
                                {{#if this.isListed}}
                                    <span class="status-badge status-listed" style="background: #10b981; color: #ffffff; padding: 4px 12px; border-radius: 50px; font-size: 12px; font-weight: 600;">Listed</span>
                                {{else}}
                                    <span class="status-badge status-unlisted" style="background: #ef4444; color: #ffffff; padding: 4px 12px; border-radius: 50px; font-size: 12px; font-weight: 600;">Unlisted</span>
                                {{/if}}
                            </td>

                           <td class="text-center" style="display: flex; gap: 8px; justify-content: center; align-items: center;">
    <!-- Edit Button -->
    <a href="/admin/brands/edit/{{this._id}}" 
       class="btn-edit" 
       style="background: #e2e8f0; color: #475569; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; font-weight: 500; cursor: pointer; text-decoration: none; transition: all 0.2s;">
       Edit
    </a>

    <!-- Status Toggle Form -->
    <form action="/admin/brands/toggle-status/{{this._id}}?page={{../currentPage}}&search={{../searchQuery}}" 
          method="POST" 
          class="inline-form status-toggle-form">
        {{#if this.isListed}}
            <button type="submit" class="btn-edit btn-status-unlist" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; padding: 6px 14px; border-radius: 6px; font-weight: 500; cursor: pointer; transition: all 0.2s;">Unlist</button>
        {{else}}
            <button type="submit" class="btn-edit btn-status-list" style="background: #ccfbf1; color: #0d9488; border: 1px solid #99f6e4; padding: 6px 14px; border-radius: 6px; font-weight: 500; cursor: pointer; transition: all 0.2s;">List</button>
        {{/if}}
    </form>
</td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="4" class="table-empty-state" style="text-align: center; padding: 50px 0; color: #64748b; font-size: 15px;">
                                No brand records discovered matching your search context.
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </main>

        {{#if brands.length}}
        <footer class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 10px; padding: 20px 0;">
            {{#if hasPrevPage}}
                <a
                    href="/admin/brands?page={{prevPage}}&search={{searchQuery}}"
                    class="page-link-nav"
                    style="text-decoration: none; color: #0f172a; font-weight: 600;"
                >
                    « Prev
                </a>
            {{/if}}

            <button class="page-num active" type="button" style="background: #0f172a; color: #ffffff; border: none; width: 36px; height: 36px; border-radius: 6px; font-weight: 600;">
                {{currentPage}}
            </button>

            {{#if hasNextPage}}
                <a
                    href="/admin/brands?page={{nextPage}}&search={{searchQuery}}"
                    class="page-next"
                    style="text-decoration: none; color: #0f172a; font-weight: 600;"
                >
                    Next »
                </a>
            {{/if}}
        </footer>
        {{/if}}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.status-toggle-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            const button = this.querySelector('button');
            const actionText = button.textContent.trim().toLowerCase(); 
            const isUnlisting = (actionText === 'unlist');
            const targetColor = isUnlisting ? '#ef4444' : '#0d9488';

            Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to change this brand status to ${isUnlisting ? 'unlisted' : 'listed'}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: targetColor,
                cancelButtonColor: '#94a3b8',
                confirmButtonText: `Yes, ${actionText} it!`,
                cancelButtonText: 'Cancel',
                customClass: {
            popup: 'small-swal-popup',
            title: 'small-swal-title',
            htmlContainer: 'small-swal-text'
        }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); 
                }
            });
        });
    });
});
</script>