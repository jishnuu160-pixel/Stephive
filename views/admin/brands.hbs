<div class="customers-page">
    <div class="table-card">

        <header class="card-header">
            <h1 class="page-title">Brands</h1>

            <div class="header-actions">
                <div class="search-container">
                    <form action="/admin/brands" method="GET" class="search-form">
                        <input
                            type="text"
                            name="search"
                            placeholder="Search brands..."
                            value="{{searchQuery}}"
                            class="search-input"
                        >

                        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>

                        {{#if searchQuery}}
                            <a href="/admin/brands" class="search-clear-btn">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {{/if}}
                    </form>
                </div>

                <button class="btn btn-primary">
                    Add Brand
                </button>
            </div>
        </header>

        <main class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>BRAND</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center">PRODUCTS</th> 
                        <th class="text-center">STATUS</th>
                        <th class="text-center">ACTION</th>
                    </tr>
                </thead>

                <tbody>
                    {{#if brands.length}}
                        {{#each brands}}
                        <tr>
                            <td>
                                <div class="brand-cell">
                                    <div class="brand-logo-container">
                                        {{#if this.logo}}
                                            <img
                                                src="/uploads/brands/{{this.logo}}"
                                                alt="{{this.name}}"
                                                class="brand-logo-img"
                                            >
                                        {{else}}
                                            <div class="brand-logo-placeholder"></div>
                                        {{/if}}
                                    </div>
                                    <span class="brand-name">
                                        {{this.name}}
                                    </span>
                                </div>
                            </td>

                            <td>
                                <span class="brand-desc">
                                    {{this.description}}
                                </span>
                            </td>

                            <td class="text-center">
                                <div style="display: inline-flex; flex-direction: column; gap: 4px; align-items: center;">
                                    <span class="badge-count" style="background: #e6fffa; color: #234e52; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 0.85em; width: 85px; display: inline-block;">
                                        {{this.listedProductCount}} Listed
                                    </span>
                                    <span class="badge-count" style="background: #fff5f5; color: #9b2c2c; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 0.85em; width: 85px; display: inline-block;">
                                        {{this.unlistedProductCount}} Unlisted
                                    </span>
                                </div>
                            </td>

                            <td class="text-center">
                                {{#if this.isListed}}
                                    <span class="status-badge status-listed">Listed</span>
                                {{else}}
                                    <span class="status-badge status-unlisted">Unlisted</span>
                                {{/if}}
                            </td>

                            <td class="text-center">
                                <form
                                    action="/admin/brands/toggle-status/{{this._id}}"
                                    method="POST"
                                    class="inline-form status-toggle-form" 
                                >
                                    {{#if this.isListed}}
                                        <button type="submit" class="btn-edit btn-status-unlist">Unlist</button>
                                    {{else}}
                                        <button type="submit" class="btn-edit btn-status-list">List</button>
                                    {{/if}}
                                </form>
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="5" class="table-empty-state">
                                No brands found.
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </main>

        {{#if brands.length}}
        <footer class="pagination-container">
            {{#if hasPrevPage}}
                <a
                    href="/admin/brands?page={{prevPage}}&search={{searchQuery}}"
                    class="page-link-nav"
                >
                    « Prev
                </a>
            {{/if}}

            <button class="page-num active">
                {{currentPage}}
            </button>

            {{#if hasNextPage}}
                <a
                    href="/admin/brands?page={{nextPage}}&search={{searchQuery}}"
                    class="page-next"
                >
                    Next »
                </a>
            {{/if}}
        </footer>
        {{/if}}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.status-toggle-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            const button = this.querySelector('button');
            const actionText = button.textContent.trim().toLowerCase(); 
            const isUnlisting = (actionText === 'unlist');
            const targetColor = isUnlisting ? '#e53e3e' : '#319795';

            Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to change this brand status to ${isUnlisting ? 'unlisted' : 'listed'}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: targetColor,
                cancelButtonColor: '#a0aec0',
                confirmButtonText: `Yes, ${actionText} it!`,
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); 
                }
            });
        });
    });
});
</script>