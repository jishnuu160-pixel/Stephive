<div class="return-details-wrapper">
    <section class="rdetail-section">
        <div class="rdetail-container">
            
            <div class="rdetail-page-header">
                <div>
                    <a href="/admin/returns" class="rdetail-back-link">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                    <h1>Return #{{returnDetails.returnId}}</h1>
                </div>
            </div>

            <!-- Flash Message Container (Hidden by default) -->
            <div id="flashMessageContainer" style="display: none; padding: 12px 16px; margin-bottom: 20px; border-radius: 6px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; font-weight: 500;">
                <span id="flashMessageText"></span>
            </div>

            <form id="returnUpdateForm">

                <!-- Product Card -->
                <div class="rdetail-card">
                    <h4 class="rdetail-section-title">PRODUCT</h4>
                    <div class="rdetail-product-box">
                        <img src="{{returnDetails.productImage}}" alt="{{returnDetails.productName}}">
                        <div>
                            <h2>{{returnDetails.productName}}</h2>
                           <div class="return-item-summary">
    <p class="mb-1">
        <span>Color: <strong>{{returnDetails.color}}</strong></span> |
        <span>Size: <strong>{{returnDetails.size}}</strong></span> | 
        <span>Qty: <strong>{{returnDetails.quantity}}</strong></span> | 
        <span>Unit Price: <strong>₹{{returnDetails.price}}</strong></span>
    </p>
    <p class="refund-info mb-0 text-success">
        <strong>Total Refund Amount (Incl. Tax): </strong> ₹{{returnDetails.refundAmount}}
    </p>
</div>
                        </div>
                    </div>
                </div>

                <!-- Return Info Card -->
                <div class="rdetail-card">
                    <h4 class="rdetail-section-title">RETURN INFORMATION</h4>
                    <div class="rdetail-info-grid">
                        <div class="rdetail-info-item">
                            <label>Customer</label>
                            <p>{{returnDetails.pickupAddress.fullName}}</p>
                        </div>
                        <div class="rdetail-info-item">
                            <label>Return Type</label>
                            <p>{{returnDetails.returnType}}</p>
                        </div>
                        <div class="rdetail-info-item">
                            <label>Reason</label>
                            <p>{{returnDetails.reason}}</p>
                        </div>
                        <div class="rdetail-info-item">
                            <label>Description</label>
                            <p>{{returnDetails.description}}</p>
                        </div>
                        <div class="rdetail-info-item">
                            <label>Refund Method</label>
                            <p>{{returnDetails.refundMode}}</p>
                        </div>
                        <div class="rdetail-info-item">
                            <label>Pickup Date</label>
                            <p>{{formattedDate returnDetails.expectedPickupDate}}</p>
                        </div>
                    </div>
                </div>

                <!-- Pickup Address Card -->
                <div class="rdetail-card">
                    <h4 class="rdetail-section-title">PICKUP ADDRESS</h4>
                    <p class="rdetail-address-text">
                        {{returnDetails.pickupAddress.fullName}}<br>
                        {{returnDetails.pickupAddress.addressLine1}}<br>
                        {{returnDetails.pickupAddress.city}},
                        {{returnDetails.pickupAddress.state}} -
                        {{returnDetails.pickupAddress.pincode}}<br>
                        {{returnDetails.pickupAddress.mobileNumber}}
                    </p>
                </div>

                <!-- Update Status Card -->
                <div class="rdetail-card">
                    <h4 class="rdetail-section-title">UPDATE STATUS</h4>
                    <select name="status" class="rdetail-select">
                        <option value="Requested" {{#ifEquals returnDetails.status "Requested"}}selected{{/ifEquals}}>Requested</option>
                        <option value="Picked Up" {{#ifEquals returnDetails.status "Picked Up"}}selected{{/ifEquals}}>Picked Up</option>
                        <option value="Refunded" {{#ifEquals returnDetails.status "Refunded"}}selected{{/ifEquals}}>Refunded</option>
                        <option value="Rejected" {{#ifEquals returnDetails.status "Rejected"}}selected{{/ifEquals}}>Rejected</option>
                    </select>
                </div>

                <!-- Form Actions -->
                <div class="rdetail-page-actions">
                    <a href="/admin/returns" class="rdetail-btn-cancel">Cancel</a>
                    <button type="submit" class="rdetail-btn-save">Save Changes</button>
                </div>

            </form>
        </div>
    </section>
</div>

<script>
document.getElementById('returnUpdateForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const statusValue = document.querySelector('select[name="status"]').value;

    try {
        const response = await fetch(`/admin/returns/update/{{returnDetails._id}}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: statusValue })
        });

        const data = await response.json();
        
        if (response.ok) {
            showToast(data.message || 'Status updated successfully');
            setTimeout(() => {
                window.location.href = '/admin/returns';
            }, 1000); 
        } else {
            showToast(data.message || 'Failed to update status');
        }
    } catch (err) {
        console.error('Error updating status:', err);
        showToast('An error occurred while updating the return status.');
    }
});
</script>