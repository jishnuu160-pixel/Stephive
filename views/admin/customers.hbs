<div class="customers-page">
    <div class="table-card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2>Users</h2>
            
            <div class="header-actions" style="display: flex; align-items: center; gap: 15px; width: 100%; max-width: 600px; justify-content: flex-end;">
                
                <div class="search-wrapper" style="flex-grow: 1; margin: 0;">
                    <form action="/admin/customers" method="GET" style="display: flex; align-items: center; width: 100%; margin: 0;">
                        <i class="fas fa-search"></i>
                        <input type="text" name="search" placeholder="Search Users" value="{{searchQuery}}">
                        {{#if searchQuery}}
                            <a href="/admin/customers" class="search-clear-btn">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {{/if}}
                    </form>
                </div>

            </div>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#if users.length}}
                    {{#each users}}
                    <tr>
                        <td>{{add ../startIndex @index 1}}</td>
                        <td><strong>{{this.fullName}}</strong></td>
                        <td>{{this.email}}</td>
                        <td>
                            <span class="status-pill {{#if this.isBlocked}}status-blocked{{else}}status-active{{/if}}">
                                {{#if this.isBlocked}}Blocked{{else}}Active{{/if}}
                            </span>
                        </td>
                        <td>
                      <form action="/admin/customers/toggle-status/{{this._id}}" method="POST" style="display:inline;">
       <button type="button" 
        class="btn-action {{#if this.isBlocked}}btn-unblock{{else}}btn-block{{/if}}" 
        onclick="confirmToggle(this, '{{this.fullName}}', {{this.isBlocked}})">
    {{#if this.isBlocked}}Unblock{{else}}Block{{/if}}
</button>
    </form>
</td>
                    </tr>
                    {{/each}}
                {{else}}
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">
                            No users found in database.
                        </td>
                    </tr>
                {{/if}}
            </tbody>
        </table>

        {{#if users.length}}
        <div class="pagination">
            {{#if hasPrevPage}}
                <a href="/admin/customers?page={{prevPage}}&search={{searchQuery}}" class="page-link">« Prev</a>
            {{/if}}

            <span class="page-info">Page {{currentPage}} of {{totalPages}}</span>

            {{#if hasNextPage}}
                <a href="/admin/customers?page={{nextPage}}&search={{searchQuery}}" class="page-link">Next »</a>
            {{/if}}
        </div>
        {{/if}}
    </div>
</div>

<div  class="admin-toast-container"></div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
   function confirmToggle(button, name, isBlocked) {
    const action = isBlocked ? 'unblock' : 'block';
    
    Swal.fire({
        title: 'Are you sure?',
        text: `Do you really want to ${action} ${name}?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isBlocked ? '#28a745' : '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: `Yes, ${action}!`,
 
        width: '320px',             
        padding: '1rem',           
        customClass: {
            popup: 'small-swal-popup',
            title: 'small-swal-title',
            htmlContainer: 'small-swal-text'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            button.closest('form').submit();
        }
    });
}
</script>

