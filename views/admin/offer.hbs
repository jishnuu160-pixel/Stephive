<div class="stephive-offers-scope">
    <div class="offers-page-layout">
        
        <main class="offers-main-content">
            <h1 class="offers-main-title">Set Promotions & Offers</h1>

            <div class="offers-dual-grid">
                
                <div class="setup-panel-card">
                    <div class="panel-header header-amber">
                        <div class="panel-icon bg-amber text-amber"><i class="fa-solid fa-tags"></i></div>
                        <div class="panel-header-text">
                            <h2>Product Offer Setup</h2>
                            <p>Target a specific individual inventory item</p>
                        </div>
                    </div>
                    
                  {{#if productError}}
                 <div class="alert alert-danger" style="display: block !important; background-color: #fee2e2; color: #991b1b; padding: 10px 15px; margin: 15px; border-radius: 6px; font-size: 0.875rem;">
                  <i class="fa-solid fa-circle-exclamation"></i> {{productError}}
                 </div>
                  {{/if}}
                    
                    <form action="/admin/offers/apply-product" method="POST" class="panel-form">
                        <div class="panel-form-group">
                            <label>Select Target Product</label>
                            <select name="targetProduct">
                                <option value="" disabled selected>Choose a product...</option>
                                {{#each allProducts}}
                                    <option value="{{this._id}}">{{this.productName}} (ID: {{this.productId}}) - (₹{{this.regularPrice}})</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="panel-form-group">
                            <label>Discount Value (%)</label>
                            <input type="number" name="discountValue" min="1" max="99">
                        </div>

                        <div class="panel-form-group">
                            <label>Start Date</label>
                            <input type="date" name="startDate">
                        </div>

                        <div class="panel-form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="expiryDate">
                        </div>

                        <button type="submit" class="panel-btn btn-apply">Apply Offer</button>
                    </form>

                    <div class="active-tracker-section">
                        <h3>Active Product Discounts</h3>
                        <div class="panel-scroll-box">
                            {{#if productOffers.length}}
                                {{#each productOffers}}
                                <div class="tracker-item">
                                    <div class="tracker-info">
                                        <span class="tracker-name">{{this.productName}}</span>
                                        <span class="tracker-meta text-muted" style="font-size: 10px; display: block;">
                                            Expires: {{formattedDate this.offer.expiryDate}}
                                        </span>
                                        <span class="tracker-badge color-amber">{{this.offer.discountValue}}% OFF</span>
                                    </div>
                                    <form action="/admin/offers/remove-product/{{this._id}}" method="POST">
                                        <button type="submit" class="panel-btn btn-delete">Remove</button>
                                    </form>
                                </div>
                                {{/each}}
                            {{else}}
                                <p class="tracker-empty">No current active product offers</p>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <div class="setup-panel-card">
                    <div class="panel-header header-emerald">
                        <div class="panel-icon bg-emerald text-emerald"><i class="fa-solid fa-folder-open"></i></div>
                        <div class="panel-header-text">
                            <h2>Category Offer Setup</h2>
                            <p>Apply store-wide promotional rates</p>
                        </div>
                    </div>
                    
                    {{#if categoryError}}
                        <div class="alert alert-danger" style="background-color: #fee2e2; color: #991b1b; padding: 10px 15px; margin: 15px; border-radius: 6px; font-size: 0.875rem;">
                            <i class="fa-solid fa-circle-exclamation"></i> {{categoryError}}
                        </div>
                    {{/if}}

                    <form action="/admin/offers/apply-category" method="POST" class="panel-form" id="categoryOfferForm">
                        <div class="panel-form-group">
                            <label>Select Target Subcategory</label>
                            <select name="subCategoryName" id="targetSubCategory" >
                                <option value="" disabled selected>Choose a subcategory...</option>
                                {{#each subCategories}}
                                    <option value="{{this.name}}" data-parent-name="{{this.parentCategory.name}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="panel-form-group dynamic-hidden" id="parentCategoryWrapper">
                            <label>Affected Parent Departments</label>
                            <div id="parentCategoryDisplayTags" class="checkbox-pill-group"></div>
                        </div>

                        <div class="panel-form-group">
                            <label>Discount Rate (%)</label>
                            <input type="number" name="discountValue" min="1" max="99" >
                        </div>

                        <div class="panel-form-group">
                            <label>Start Date</label>
                            <input type="date" name="startDate" >
                        </div>

                        <div class="panel-form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="expiryDate" >
                        </div>

                        <button type="submit" class="panel-btn btn-apply">Apply Category Offer</button>
                    </form>

                    <div class="active-tracker-section">
                        <h3>Active Category Discounts</h3>
                        <div class="panel-scroll-box">
                            {{#if categoryOffers.length}}
                                {{#each categoryOffers}}
                                <div class="tracker-item">
                                    <div class="tracker-info">
                                        <span class="tracker-name">
                                            {{this.name}}
                                            {{#if this.parentCategory.name}}
                                                <small class="tracker-parent-tag">({{this.parentCategory.name}})</small>
                                            {{/if}}
                                            <small class="tracker-level-tag">(Subcategory Group)</small>
                                        </span>
                                 {{#if this.offer.expiryDate}}
    <span class="tracker-meta text-muted" style="font-size: 10px; display: block;">
        Expires: {{formattedDate this.offer.expiryDate}}
    </span>
{{/if}}
                                        <span class="tracker-badge color-emerald">{{this.offer.discountValue}}% OFF</span>
                                    </div>
                                    <form action="/admin/offers/remove-category/{{this._id}}" method="POST">
                                        <button type="submit" class="panel-btn btn-delete">Remove</button>
                                    </form>
                                </div>
                                {{/each}}
                            {{else}}
                                <p class="tracker-empty">No current active category offers</p>
                            {{/if}}
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        function showInlineError(cardIndex, message) {
            const cards = document.querySelectorAll('.setup-panel-card');
            if (!cards[cardIndex]) return;
            
            const targetHeader = cards[cardIndex].querySelector('.panel-header');
            const alertId = cardIndex === 0 ? 'clientProductAlert' : 'clientCategoryAlert';
            
            const existingAlert = document.getElementById(alertId);
            if (existingAlert) existingAlert.remove();

            const alertDiv = document.createElement('div');
            alertDiv.id = alertId;
            alertDiv.className = 'alert alert-danger';
            alertDiv.style.cssText = 'display: block !important; background-color: #fee2e2; color: #991b1b; padding: 10px 15px; margin: 15px; border-radius: 6px; font-size: 0.875rem;';
            alertDiv.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${message}`;
            targetHeader.insertAdjacentElement('afterend', alertDiv);
        }

        const urlParams = new URLSearchParams(window.location.search);
        const productError = urlParams.get('productError');
        if (productError) showInlineError(0, decodeURIComponent(productError));

        const categoryError = urlParams.get('categoryError');
        if (categoryError) showInlineError(1, decodeURIComponent(categoryError));

        const productForm = document.querySelector('form[action*="apply-product"]');
        if (productForm) {
            productForm.addEventListener("submit", function (e) {
                const targetProduct = productForm.querySelector('[name="targetProduct"]').value;
                const discountValue = productForm.querySelector('[name="discountValue"]').value;
                const startDate = productForm.querySelector('[name="startDate"]').value;
                const expiryDate = productForm.querySelector('[name="expiryDate"]').value;

                if (!targetProduct || !discountValue || !startDate || !expiryDate) {
                    e.preventDefault();
                    showInlineError(0, "Please fill in all required fields for the product offer.");
                }
            });
        }

        const subSelect = document.getElementById("targetSubCategory");
        const parentWrapper = document.getElementById("parentCategoryWrapper");
        const tagsContainer = document.getElementById("parentCategoryDisplayTags");
        const offerForm = document.getElementById("categoryOfferForm");

        if (subSelect) {
            const originalOptions = Array.from(subSelect.options).map(opt => ({
                value: opt.value,
                text: opt.textContent.trim(),
                parentName: opt.getAttribute("data-parent-name")
            }));

            const seenNames = new Set();
            for (let i = subSelect.options.length - 1; i >= 0; i--) {
                const val = subSelect.options[i].value;
                if (val !== "") {
                    if (seenNames.has(val)) {
                        subSelect.remove(i);
                    } else {
                        seenNames.add(val);
                    }
                }
            }

            const isMongoId = (str) => /^[0-9a-fA-F]{24}$/.test(str);

            subSelect.addEventListener("change", function () {
                const chosenName = this.value;
                tagsContainer.innerHTML = ""; 

                if (!chosenName) {
                    parentWrapper.classList.add("dynamic-hidden");
                    return;
                }

                const matchedDepartments = [];
                originalOptions.forEach(opt => {
                    if (opt.value === chosenName && opt.parentName) {
                        const trimmedParent = opt.parentName.trim();
                        if (!isMongoId(trimmedParent) && trimmedParent !== "" && trimmedParent !== "Department" && trimmedParent !== "undefined") {
                            if (!matchedDepartments.includes(trimmedParent)) {
                                matchedDepartments.push(trimmedParent);
                            }
                        }
                    }
                });

                if (matchedDepartments.length > 0) {
                    matchedDepartments.forEach((dept) => {
                        const labelNode = document.createElement("label");
                        labelNode.className = "checkbox-pill-label";

                        const checkboxInput = document.createElement("input");
                        checkboxInput.type = "checkbox";
                        checkboxInput.name = "targetParentCategories";
                        checkboxInput.value = dept;
                        checkboxInput.checked = true;

                        const textNode = document.createTextNode(dept);

                        labelNode.appendChild(checkboxInput);
                        labelNode.appendChild(textNode);
                        tagsContainer.appendChild(labelNode);
                    });
                    parentWrapper.classList.remove("dynamic-hidden");
                } else {
                    parentWrapper.classList.add("dynamic-hidden");
                }
            });
        }

        if (offerForm) {
            offerForm.addEventListener("submit", function (e) {
                const subCategoryName = offerForm.querySelector('[name="subCategoryName"]').value;
                const discountValue = offerForm.querySelector('[name="discountValue"]').value;
                const startDate = offerForm.querySelector('[name="startDate"]').value;
                const expiryDate = offerForm.querySelector('[name="expiryDate"]').value;

                if (!subCategoryName || !discountValue || !startDate || !expiryDate) {
                    e.preventDefault();
                    showInlineError(1, "Please fill in all required fields for the category offer.");
                    return;
                }

                if (!parentWrapper.classList.contains("dynamic-hidden")) {
                    const checkedBoxes = tagsContainer.querySelectorAll('input[type="checkbox"]:checked');
                    if (checkedBoxes.length === 0) {
                        e.preventDefault();
                        showInlineError(1, "Please check at least one parent category department to apply this offer.");
                    }
                }
            });
        }
    });
</script>