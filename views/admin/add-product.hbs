<div class="customers-page">
    <div class="table-card">

        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
            <h2>Add Product</h2>
            <a href="/admin/products" class="btn-modal-cancel">✕</a>
        </div>

        <form action="/admin/products/add" method="POST" enctype="multipart/form-data" class="modal-form-body">

            <!-- Row 1 -->
            <div class="form-row split-row4">
                <div class="form-group">
                    <label>Shoe Name</label>
                    <input type="text" name="productName" placeholder="Curv Shoe" >
                </div>

                <div class="form-group">
                    <label>Brand</label>
                    <input type="text" name="brand" placeholder="Curv">
                </div>

                <div class="form-group">
                    <label>Base Price</label>
                    <input type="number" name="regularPrice" placeholder="5999">
                </div>

                
            </div>

            <!-- Description -->
            <div class="form-group">
                <label>Description</label>
                <input type="text" name="description" placeholder="Comfortable everyday sneaker">
            </div>

            <!-- Categories -->
            <div class="form-row split-row">
                <div class="form-group">
                    <label>Parent Category</label>
                   <select id="parentCategorySelect" name="parentCategory">
                     <option value="">Select Parent Category</option>
                       {{#each parentCategories}}
                     <option value="{{this._id}}">
                        {{this.name}}
                     </option>
                        {{/each}}
                   </select>
                </div>

                <div class="form-group">
                    <label>Category Name</label>
                    <select id="subcategorySelect" name="category">
                     <option value="">Select Subcategory</option>
                    </select>
                </div>
            </div>

            <!-- Variants -->
            <div class="variants-section">
                <label class="section-main-label">Variants</label>

                <div id="variantsContainer" class="variants-grid-wrapper"></div>



                <button type="button" class="btn-add-variant-group" onclick="addColorVariantBlock()">
                    + Add another color variant
                </button>
            </div>

            <!-- Product Specs -->
            <div class="form-row split-row4">
                

                <div class="form-group">
                    <label>Material</label>
                    <input type="text" name="material" placeholder="Leather">
                </div>

                <div class="form-group">
                    <label>Closure Type</label>
                    <input type="text" name="closureType" placeholder="Lace up">
                </div>

                <div class="form-group">
                    <label>Sole Type</label>
                    <input type="text" name="soleType" placeholder="Rubber">
                </div>
                <div class="form-group">
                <label>Weight</label>
                <input type="text" name="weight" placeholder="300g">
                </div>
            </div>

             <div class="form-row split-row4">
                
                <div class="form-group">
                    <label>Country of Origin</label>
                    <input type="text" name="countryOfOrigin" placeholder="India">
                </div>
            </div>

            <!-- Images -->
            <div class="form-group">
                <label>Product Images</label>

               <div class="image-drag-dropzone" id="uploadBox">

    <input 
        type="file" 
        name="productImages"
        id="productImagesInput"
        multiple
        accept="image/*"
        style="display:none"
        onchange="handleFiles(this.files)"
    >

    <div class="dropzone-inner-ui">
        <div class="camera-icon">📷</div>

        <p class="main-drop-text">
            Click to upload images
        </p>

        <p class="sub-drop-text">
            JPG, PNG up to 5MB
        </p>
    </div>

</div>

<div id="imagesPreviewGallery"></div>

             
            </div>

            <!-- Footer -->
            <div class="modal-action-footer">
                <a href="/admin/products" class="btn-modal-cancel">Cancel</a>
                <button type="submit" class="btn-modal-save">Save</button>
            </div>

        </form>

    </div>
</div>


{{!-- variant --}}
     <div id="variantTemplate" style="display:none;">
     <div class="variant-card">

     <div class="form-group">

   <input
      type="text"
      name="colorNames[]"
      placeholder="Color Name"
   >

   <div class="color-picker">

      <input type="color" name="colorHex[]">

      <span class="label"></span>

      <input
         type="hidden"
         name="colorName[]"
         class="color-name"
      >

   </div>

</div>

      <div class="sizes-container">
         <label>Sizes & Stock</label>

         <div class="size-row">
           <input type="number" name="sizes[]" placeholder="Size">
           <input type="number" name="stocks[]" placeholder="Stock">
            <button type="button" class="remove-size">X</button>
         </div>

         <button type="button" class="add-size">+ Add size</button>
      </div>

      <button type="button" class="remove-variant">Remove Variant</button>

   </div>
</div>

<script>

let selectedFiles = [];

    document.getElementById("parentCategorySelect")
.addEventListener("change", async function () {

   const parentId = this.value;

   const subSelect =
      document.getElementById("subcategorySelect");

   subSelect.innerHTML =
      `<option value="">Loading...</option>`;

   if (!parentId) {
      subSelect.innerHTML =
         `<option value="">Select Subcategory</option>`;
      return;
   }

   const res =
      await fetch(`/admin/categories/${parentId}/subcategories`);

   const data = await res.json();

   subSelect.innerHTML =
      `<option value="">Select Subcategory</option>`;

   data.subcategories.forEach(cat => {
      const option = document.createElement("option");
      option.value = cat._id;
      option.textContent = cat.name;
      subSelect.appendChild(option);
   });

});

//add variant
function addColorVariantBlock() {

   const template =
      document.querySelector("#variantTemplate .variant-card");

   const clone =
      template.cloneNode(true);
      

   document
      .getElementById("variantsContainer")
      .appendChild(clone);

      bindColorPickers(clone);

}

//remove variant
document.addEventListener("click", function (e) {

   if (e.target.classList.contains("remove-variant")) {
      e.target.closest(".variant-card").remove();
   }

});

document.querySelector('.modal-form-body')
.addEventListener('submit', function (e) {

   e.preventDefault();

   const productName =
      document.querySelector('[name="productName"]').value.trim();

   const brand =
      document.querySelector('[name="brand"]').value.trim();

   const description =
      document.querySelector('[name="description"]').value.trim();

   const category =
      document.querySelector('[name="category"]').value;

   const price =
      document.querySelector('[name="regularPrice"]').value;

   function showToast(message) {

      Toastify({
         text: message,
         duration: 3000,
         gravity: "top",
         position: "right",
         stopOnFocus: true,
         style: {
            background: "#ef4444",
            borderRadius: "8px"
         }
      }).showToast();

   }

   if (!productName) {
      showToast("Product name is required");
      return;
   }

   if (!brand) {
      showToast("Brand is required");
      return;
   }

   if (!description) {
      showToast("Description is required");
      return;
   }

   if (!category) {
      showToast("Please select category");
      return;
   }

   if (!price || Number(price) <= 0) {
      showToast("Enter valid price");
      return;
   }

   // ✅ submit only if valid
   this.submit();

});

//add size row
document.addEventListener("click", function (e) {

   if (e.target.classList.contains("add-size")) {

      const container =
         e.target.closest(".sizes-container");

      const newRow =
         document.createElement("div");

      newRow.classList.add("size-row");

      newRow.innerHTML = `
         <input type="number" name="size[]" placeholder="Size">
         <input type="number" name="stock[]" placeholder="Stock">
         <button type="button" class="remove-size">X</button>
      `;

      container.insertBefore(newRow, e.target);

   }

   if (e.target.classList.contains("remove-size")) {
      e.target.parentElement.remove();
   }

});

function bindColorPickers(scope = document) {

   scope.querySelectorAll('.color-picker').forEach(wrapper => {

      const input =
         wrapper.querySelector('input[type="color"]');

      const label =
         wrapper.querySelector('.label');

      const hiddenInput =
         wrapper.querySelector('.color-name');

      function update() {

         const hex = input.value;

         label.textContent =
            hex.toUpperCase();

         label.style.color = hex;

         hiddenInput.value = hex;
      }

      input.addEventListener('input', update);

      update();

   });

}

bindColorPickers();

addColorVariantBlock();


document
.getElementById("uploadBox")
.addEventListener("click", function () {

   document
   .getElementById("productImagesInput")
   .click();

});


function updateFileInput() {
   const input = document.getElementById("productImagesInput");

   const dataTransfer = new DataTransfer();

   selectedFiles.forEach(file => dataTransfer.items.add(file));

   input.files = dataTransfer.files;
}


function handleFiles(files) {

   const newFiles = Array.from(files);

   // append instead of replace (THIS is the key fix)
   selectedFiles = [...selectedFiles, ...newFiles];

   updateFileInput();
   renderImages();
}



function renderImages() {

   const preview = document.getElementById("imagesPreviewGallery");
   preview.innerHTML = "";

   selectedFiles.forEach((file, index) => {

      const reader = new FileReader();

      reader.onload = (e) => {

         const wrapper = document.createElement("div");
         wrapper.style.position = "relative";
         wrapper.style.display = "inline-block";
         wrapper.style.margin = "10px";

         const img = document.createElement("img");
         img.src = e.target.result;
         img.style.width = "100px";
         img.style.height = "100px";
         img.style.objectFit = "cover";
         img.style.borderRadius = "10px";

         const btn = document.createElement("button");
         btn.innerText = "×";
         btn.type = "button";

         btn.style.position = "absolute";
         btn.style.top = "0";
         btn.style.right = "0";
         btn.style.background = "red";
         btn.style.color = "white";
         btn.style.border = "none";
         btn.style.borderRadius = "50%";
         btn.style.width = "20px";
         btn.style.height = "20px";
         btn.style.cursor = "pointer";

         btn.onclick = () => {
            selectedFiles.splice(index, 1);
            updateFileInput();
            renderImages();
         };

         wrapper.appendChild(img);
         wrapper.appendChild(btn);
         preview.appendChild(wrapper);
      };

      reader.readAsDataURL(file);
   });
}
</script>
