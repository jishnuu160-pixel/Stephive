<div class="admin-dashboard-wrapper">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="dashboard-container">
        <aside class="sidebar-wrapper" id="sidebarWrapper">
            {{> admin-sidebar}}
        </aside>

        <main class="prod-main-content">
            <div class="prod-table-card">
                <div class="prod-card-header">
                    <h2>Products</h2>
                    
                    <div class="prod-header-actions">
                        <div class="prod-search-wrapper">
                            <form action="/admin/products" method="GET" class="prod-search-form">
                                <div class="prod-search-inner-wrapper">
                                    <i class="fas fa-search"></i>
                                    <input type="text" name="search" placeholder="Search Products" value="{{searchQuery}}" class="prod-search-input" oninput="autoSearch(this)">
                                    {{#if searchQuery}}
                                        <a href="/admin/products" class="prod-search-clear-btn" title="Clear Search">
                                            <i class="fas fa-times-circle"></i>
                                        </a>
                                    {{/if}}
                                </div>
                            </form>
                        </div>

                        <a href="/admin/products/add" class="prod-btn-add">Add Product</a>
                    </div>
                </div>

                <div class="prod-table-responsive">
                    <table class="prod-table">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th> 
                                <th>Quantity</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each products}} 
                            <tr>
                                <td>{{add @root.startIndex @index 1}}</td>
                                <td>
                                    <div class="prod-info-cell">
                                        {{#if this.variants.[0].images.[0]}}
                                            <img src="{{this.variants.[0].images.[0]}}" alt="{{this.productName}}" class="prod-thumb">
                                        {{else}}
                                            <div class="prod-thumb-placeholder">
                                                <i class="fas fa-image"></i>
                                            </div>
                                        {{/if}}
                                        <strong>{{this.productName}}</strong>
                                    </div>
                                </td>
                                <td>
                                    <div class="prod-category-cell">
                                        {{#if this.Category}}
                                            {{#if this.Category.parentCategory}}
                                                <span class="prod-parent-cat">{{this.Category.parentCategory.name}}</span>
                                                <strong class="prod-sub-cat">{{this.Category.name}}</strong>
                                            {{else}}
                                                <strong class="prod-sub-cat">{{this.Category.name}}</strong>
                                            {{/if}}
                                        {{else if this.category}}
                                            {{#if this.category.parentCategory}}
                                                <span class="prod-parent-cat">{{this.category.parentCategory.name}}</span>
                                                <strong class="prod-sub-cat">{{this.category.name}}</strong>
                                            {{else}}
                                                <strong class="prod-sub-cat">{{this.category.name}}</strong>
                                            {{/if}}
                                        {{else}}
                                            <span class="prod-uncategorized">Uncategorized</span>
                                        {{/if}}
                                    </div>
                                </td>
                                <td>₹{{this.regularPrice}}</td>
                                <td>{{this.displayStock}}</td>
                                <td>
                                    {{#if this.isListed}}
                                        <span class="prod-status-badge prod-status-listed">Listed</span>
                                    {{else}}
                                        <span class="prod-status-badge prod-status-unlisted">Unlisted</span>
                                    {{/if}}
                                </td>
                                <td class="text-center">
                                    <div class="prod-action-buttons">
                                        <a href="/admin/products/edit/{{this._id}}" class="prod-btn-edit">Edit</a>
                                        <form action="/admin/products/toggle-status/{{this._id}}" method="POST" class="prod-action-form">
                                            <button 
                                                type="button"
                                                class="prod-btn-toggle {{#if this.isListed}}active{{else}}inactive{{/if}}"
                                                data-listed="{{this.isListed}}"
                                                data-name="{{this.productName}}"
                                                onclick="confirmProductToggle(this)">
                                                {{#if this.isListed}}Unlist{{else}}List{{/if}}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="7" class="prod-no-data-cell">No products found in the database.</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                {{#if products.length}}
                <div class="pagination">
                    {{#if pagination.hasPrevPage}}
                        <a href="/admin/products?page={{pagination.prevPage}}&limit={{pagination.limit}}&search={{@root.searchQuery}}" class="page-link">&laquo; Prev</a>
                    {{/if}}
                    
                    <span class="page-info">Page {{pagination.page}} of {{pagination.totalPages}}</span>
                    
                    {{#if pagination.hasNextPage}}
                        <a href="/admin/products?page={{pagination.nextPage}}&limit={{pagination.limit}}&search={{@root.searchQuery}}" class="page-link">Next &raquo;</a>
                    {{else}}
                        <span class="page-link disabled">Next &raquo;</span>
                    {{/if}}
                </div>
                {{/if}}
            </div>
        </main>
    </div>
</div>

<script>
let searchTimeout = null;

function autoSearch(input) {
    clearTimeout(searchTimeout);

    searchTimeout = setTimeout(() => {
        input.form.submit();
    }, 500);
}

function confirmProductToggle(button) {
    const isListed = button.getAttribute('data-listed') === 'true';
    const itemName = button.getAttribute('data-name');
    const actionText = isListed ? 'Unlist' : 'List';
    
    Swal.fire({
        title: 'Are you sure?',
        text: `Do you really want to ${actionText.toLowerCase()} ${itemName}?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isListed ? '#dc2626' : '#16a34a', 
        cancelButtonColor: '#6b7280',
        confirmButtonText: `Yes, ${actionText} it!`,
        width: '320px',             
        padding: '12px',
        customClass: {
            popup: 'small-swal-popup',
            title: 'small-swal-title',
            htmlContainer: 'small-swal-text'
        }
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.close(); 
            button.closest('form').submit();
        }
    });
}

let colorIndex = 0;

function addColorVariantBlock() {
    const container = document.getElementById('variantsContainer');
    if(!container) return;
    
    const variantId = colorIndex++;
    const card = document.createElement('div');
    card.className = 'variant-card';
    card.id = `variantCard-${variantId}`;
    
    card.innerHTML = `
        <div class="variant-card-header">
            <div class="color-input-wrapper">
                <input type="color" name="variants[${variantId}][colorHex]" value="#1a202c" class="color-picker-circle" oninput="this.style.backgroundColor = this.value">
                <input type="text" name="variants[${variantId}][colorName]" placeholder="Color Name" value="Black" class="color-name-input">
            </div>
            <button type="button" class="btn-remove-card" onclick="removeColorBlock(${variantId})">Remove</button>
        </div>
        <p class="size-row-title">Sizes & stock:</p>
        <div id="sizesContainer-${variantId}" class="sizes-stock-container"></div>
        <button type="button" class="btn-add-size-row" onclick="addSizeRow(${variantId})">+ Add size</button>
    `;
    
    container.appendChild(card);
    addSizeRow(variantId);
}

function removeColorBlock(id) {
    const card = document.getElementById(`variantCard-${id}`);
    if (card) card.remove();
}

function addSizeRow(variantId) {
    const container = document.getElementById(`sizesContainer-${variantId}`);
    if(!container) return;
    
    const rowCount = container.children.length;
    const row = document.createElement('div');
    row.className = 'size-entry-row';
    
    row.innerHTML = `
        <span>Size</span>
        <input type="number" name="variants[${variantId}][sizes][${rowCount}][size]" class="size-input-small" placeholder="8" min="1">
        <span>Stock</span>
        <input type="number" name="variants[${variantId}][sizes][${rowCount}][stock]" class="stock-input-small" placeholder="10" min="0">
        <button type="button" class="btn-remove-size-row" onclick="this.parentElement.remove()">&times;</button>
    `;
    
    container.appendChild(row);
}

let selectedImagesFileList = []; 

function previewSelectedImages(inputElement) {
    const previewGallery = document.getElementById('imagesPreviewGallery');
    if (!previewGallery) return;

    const incomingFiles = Array.from(inputElement.files);
    
    if (selectedImagesFileList.length + incomingFiles.length > 4) {
        Swal.fire({
            icon: 'error',
            title: 'Upload Limit Exceeded',
            text: 'You can upload a maximum of 4 product images.',
            confirmButtonColor: '#e6a800'
        });
        inputElement.value = ""; 
        return;
    }

    incomingFiles.forEach(file => {
        selectedImagesFileList.push(file);
        
        const reader = new FileReader();
        reader.onload = function(e) {
            const containerCard = document.createElement('div');
            containerCard.className = 'preview-image-container';
            
            const trackingIndex = selectedImagesFileList.length - 1;
            containerCard.setAttribute('data-image-index', trackingIndex);

            containerCard.innerHTML = `
                <img src="${e.target.result}" alt="Preview item">
                <button type="button" class="preview-remove-badge" onclick="removePreviewImageElement(${trackingIndex})">&times;</button>
            `;
            previewGallery.appendChild(containerCard);
        };
        reader.readAsDataURL(file);
    });

    syncInputFilesDataTransfer(inputElement);
}

function removePreviewImageElement(indexToRemove) {
    const inputElement = document.getElementById('productImagesInput');
    const previewGallery = document.getElementById('imagesPreviewGallery');
    
    selectedImagesFileList.splice(indexToRemove, 1);
    
    if (previewGallery) {
        previewGallery.innerHTML = "";
        
        selectedImagesFileList.forEach((file, newIndex) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const containerCard = document.createElement('div');
                containerCard.className = 'preview-image-container';
                containerCard.setAttribute('data-image-index', newIndex);
                containerCard.innerHTML = `
                    <img src="${e.target.result}" alt="Preview item">
                    <button type="button" class="preview-remove-badge" onclick="removePreviewImageElement(${newIndex})">&times;</button>
                `;
                previewGallery.appendChild(containerCard);
            };
            reader.readAsDataURL(file);
        });
    }

    syncInputFilesDataTransfer(inputElement);
}

function syncInputFilesDataTransfer(inputField) {
    if (!inputField) return;
    const dataTransferContext = new DataTransfer();
    selectedImagesFileList.forEach(file => dataTransferContext.items.add(file));
    inputField.files = dataTransferContext.files;
}

const allSubcategories = [];
{{#each @root.subcategories}}
allSubcategories.push({
    name: "{{this.name}}",
    parent: "{{this.parentCategory}}"
});
{{/each}}

document.addEventListener("DOMContentLoaded", () => {
    if(document.getElementById('variantsContainer')){
        addColorVariantBlock(); 
        addColorVariantBlock(); 
        
        const secondColorInput = document.querySelector(`#variantCard-1 .color-picker-circle`);
        const secondColorName = document.querySelector(`#variantCard-1 .color-name-input`);
        if(secondColorInput && secondColorName) {
             secondColorInput.value = "#ffffff";
             secondColorName.value = "White";
             secondColorInput.style.backgroundColor = "#ffffff";
        }
    }

    const parentSelect = document.getElementById("parentCategorySelect");
    const subSelect = document.getElementById("subcategorySelect");

    if (parentSelect && subSelect) {
        parentSelect.addEventListener("change", function() {
            const selectedParentId = this.value.trim();
            subSelect.innerHTML = '<option value="">Select Subcategory</option>';
            if (!selectedParentId) return;

            const matches = allSubcategories.filter(sub => String(sub.parent).trim() === String(selectedParentId));
            matches.forEach(sub => {
                const opt = document.createElement("option");
                opt.value = sub.name;
                opt.textContent = sub.name;
                subSelect.appendChild(opt);
            });
        });
    }
});
</script>