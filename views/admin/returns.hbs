<div class="customers-page">
    <div class="table-card">

        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2>Return Requests</h2>

            <div class="header-actions" style="display: flex; align-items: center; gap: 15px; width: 100%; max-width: 500px; justify-content: flex-end;">

                <div class="search-wrapper" style="flex-grow: 1; margin: 0;">
                    <form action="/admin/returns" method="GET" style="display:flex; align-items:center; width:100%; margin:0;">
                        <i class="fas fa-search"></i>

                        <input
                            type="text"
                            name="search"
                            placeholder="Search Return ID or Order ID"
                            value="{{searchQuery}}">

                        {{#if searchQuery}}
                            <a href="/admin/returns" class="search-clear-btn">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {{/if}}
                    </form>
                </div>

            </div>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Return ID</th>
                    <th>Order ID</th>
                    <th>Request Type</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                {{#each returns}}

                <tr>

                    <td>{{add @root.startIndex @index 1}}</td>

                    <td class="badgeBold">{{this.returnId}}</td>

                    <td class="badgeBold">{{this.orderId}}</td>

                    <td>
                        <span class="badge {{#ifEquals this.returnType 'Return'}}bg-primary{{else}}bg-warning{{/ifEquals}}">
                            {{this.returnType}}
                        </span>
                    </td>

                    <td>
                        <span class="badge
                            {{#ifEquals this.returnStatus 'Pending'}}bg-warning{{/ifEquals}}
                            {{#ifEquals this.returnStatus 'Approved'}}bg-success{{/ifEquals}}
                            {{#ifEquals this.returnStatus 'Rejected'}}bg-danger{{/ifEquals}}
                            {{#ifEquals this.returnStatus 'Completed'}}bg-info{{/ifEquals}}">
                            {{this.returnStatus}}
                        </span>
                    </td>

                    <td>
                       <a href="/admin/returns/{{this.returnId}}" class="btn-edit-small">View</a>
       
                    </td>

                </tr>

                {{else}}

                <tr>
                    <td colspan="9" style="text-align:center;padding:20px;color:#cbd5e1;">
                        No return requests found.
                    </td>
                </tr>

                {{/each}}

            </tbody>
        </table>

        {{#if returns.length}}
        <div class="pagination">

            {{#if pagination.hasPrevPage}}
                <a href="/admin/returns?page={{pagination.prevPage}}&limit={{pagination.limit}}&search={{searchQuery}}" class="page-link">
                    « Prev
                </a>
            {{/if}}

            <span class="page-info">
                Page {{pagination.page}} of {{pagination.totalPages}}
            </span>

            {{#if pagination.hasNextPage}}
                <a href="/admin/returns?page={{pagination.nextPage}}&limit={{pagination.limit}}&search={{searchQuery}}" class="page-link">
                    Next »
                </a>
            {{/if}}

        </div>
        {{/if}}

    </div>
</div>
<script>
async function updateStatus(id, status) {
    const res = await fetch(`/admin/returns/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
    });
    if (res.ok) window.location.reload();
}
</script>