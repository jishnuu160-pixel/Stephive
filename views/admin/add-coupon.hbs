<div class="admin-dashboard-wrapper">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="dashboard-container">
        <aside class="sidebar-wrapper" id="sidebarWrapper">
            {{> admin-sidebar}}
        </aside>
<div class="coupon-container">
    <div class="coupon-header">
        <h2>add Coupon</h2>
        <span class="close-icon">&times;</span>
    </div>

    <form action="/admin/coupons/add" method="POST" class="coupon-form">
        <div class="row">
            <div class="col">
                <label>Coupon NAME</label>
                <input type="text" name="name" placeholder="SummerSale" >
                 {{#if errors.name}}
        <small class="error">{{errors.name}}</small>
    {{/if}}
            </div>
            <div class="col">
                <label>Coupon CODE</label>
                <input type="text" name="couponCode" placeholder="SUMMER121" >
                 {{#if errors.couponCode}}
        <small class="error">{{errors.couponCode}}</small>
    {{/if}}
            </div>
        </div>

        <div class="section-divider">Discount</div>
        <label>DISCOUNT TYPE</label>
        <div class="radio-group">
            <label class="radio-card">
                <input type="radio" name="discountType" value="percentage" checked> Percentage
            </label>
            <label class="radio-card">
                <input type="radio" name="discountType" value="fixed"> Flat Amount
            </label>
        </div>

        <div class="row">
            <div class="col"><label>DISCOUNT VALUE</label><input type="number" name="discountValue" placeholder="eg: 10" >{{#if errors.discountValue}}
        <small class="error">{{errors.discountValue}}</small>
    {{/if}}</div>
          <div class="col" id="maxDiscountContainer"><label>MAX DISCOUNT</label> <input type="number" name="maxDiscountAmount" placeholder="eg: 500">{{#if errors.maxDiscountAmount}}
        <small class="error">{{errors.maxDiscountAmount}}</small>
    {{/if}}</div>
        </div>
        <div class="row">
            <div class="col"><label>MIN PURCHASE AMOUNT</label><input type="number" name="min_orderAmount" placeholder="eg: 500" > {{#if errors.min_orderAmount}}
        <small class="error">{{errors.min_orderAmount}}</small>
    {{/if}}</div>
        </div>

        <div class="section-divider">Expiry & usage</div>
        <div class="row">
            <div class="col"><label>EXPIRY DATE</label><input type="date" name="expiryDate" >  {{#if errors.expiryDate}}
        <small class="error">{{errors.expiryDate}}</small>
    {{/if}}</div>
            <div class="col"><label>MAX USE COUNT</label><input type="number" name="maxUseCount" placeholder="eg: 100"> {{#if errors.maxUseCount}}
        <small class="error">{{errors.maxUseCount}}</small>
    {{/if}}</div>
        </div>

        <div class="footer-actions">
            <a href="/admin/coupons" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save">save Coupon</button>
        </div>
    </form>
</div>
</div>
</div>

<script>
const percentage = document.querySelector('input[value="percentage"]');
const fixed = document.querySelector('input[value="fixed"]');
const maxDiscountContainer = document.getElementById("maxDiscountContainer");

function toggleMaxDiscount() {
    if (percentage.checked) {
        maxDiscountContainer.style.display = "block";
    } else {
        maxDiscountContainer.style.display = "none";
    }
}

percentage.addEventListener("change", toggleMaxDiscount);
fixed.addEventListener("change", toggleMaxDiscount);

toggleMaxDiscount();

const expiryDateInput = document.querySelector('input[name="expiryDate"]');

const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);
const minDate = tomorrow.toISOString().split('T')[0];

expiryDateInput.setAttribute('min', minDate);
</script>