<!-- Auto-close offcanvas script on mobile navigation click -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const offcanvasElement = document.getElementById('mobileAdminSidebarModal');
        if (offcanvasElement && typeof bootstrap !== 'undefined') {
            const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasElement) || new bootstrap.Offcanvas(offcanvasElement);
            const navLinks = offcanvasElement.querySelectorAll('.admin-nav-link');
            navLinks.forEach(link => {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        bsOffcanvas.hide();
                    }
                });
            });
        }
    });
</script>