<!-- Mobile Admin Sidebar Modal (Offcanvas Drawer) -->
<div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="mobileAdminSidebarModal" aria-labelledby="mobileAdminSidebarModalLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mobileAdminSidebarModalLabel">Admin Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <aside class="admin-sidebar-unique border-0 w-100">
            <div class="admin-sidebar-user-header">
                <div class="admin-avatar-circle-small">
                    <i class="fas fa-user-shield admin-user-icon admin-sidebar-avatar"></i>
                </div>
                <div class="admin-user-meta">
                    <h4>Administrator</h4>
                    <span class="admin-premium-tag">SYSTEM ADMIN</span>
                </div>
            </div>

            <nav class="admin-sidebar-links">
                <a href="/admin/dashboard" class="admin-nav-link {{#if (eq activePage 'dashboard')}}active{{/if}}">
                    <i class="fas fa-home admin-sidebar-icon"></i> <span>Dashboard</span>
                </a>
                <a href="/admin/products" class="admin-nav-link {{#if (eq activePage 'products')}}active{{/if}}">
                    <i class="fas fa-box admin-sidebar-icon"></i> <span>Product List</span>
                </a>
                <a href="/admin/orders" class="admin-nav-link {{#if (eq activePage 'orders')}}active{{/if}}">
                    <i class="fas fa-shopping-cart admin-sidebar-icon"></i> <span>Order Management</span>
                </a>
                <a href="/admin/customers" class="admin-nav-link {{#if (eq activePage 'customers')}}active{{/if}}">
                    <i class="fas fa-users admin-sidebar-icon"></i> <span>Users</span>
                </a>
                <a href="/admin/categories" class="admin-nav-link {{#if (eq activePage 'categories')}}active{{/if}}">
                    <i class="fas fa-layer-group admin-sidebar-icon"></i> <span>Categories</span>
                </a>
                <a href="/admin/coupons" class="admin-nav-link {{#if (eq activePage 'coupons')}}active{{/if}}">
                    <i class="fas fa-ticket-alt admin-sidebar-icon"></i> <span>Coupon</span>
                </a>
                <a href="/admin/offer" class="admin-nav-link {{#if (eq activePage 'offer')}}active{{/if}}">
                    <i class="fas fa-percent admin-sidebar-icon"></i> <span>Offer</span>
                </a>
                <a href="/admin/salesReport" class="admin-nav-link {{#if (eq activePage 'sales')}}active{{/if}}">
                    <i class="fas fa-chart-line admin-sidebar-icon"></i> <span>Sales</span>
                </a>
                <a href="/admin/brands" class="admin-nav-link {{#if (eq activePage 'brands')}}active{{/if}}">
                    <i class="fas fa-tags admin-sidebar-icon"></i> <span>Brand</span>
                </a>
                <a href="/admin/returns" class="admin-nav-link {{#if (eq activePage 'return')}}active{{/if}}">
                    <i class="fas fa-undo admin-sidebar-icon"></i> <span>Return</span>
                </a>
                <a href="/admin/logout" class="admin-nav-link logout-link">
                    <i class="fas fa-sign-out-alt admin-sidebar-icon"></i> <span class="logout">Logout</span>
                </a>
            </nav>
        </aside>
    </div>
</div>

