<div class="customers-page">
    <div class="table-card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2>Categories</h2>
            
            <div class="header-actions" style="display: flex; align-items: center; gap: 15px; width: 100%; max-width: 600px; justify-content: flex-end;">
                
                <div class="search-wrapper" style="flex-grow: 1; margin: 0;">
                    <form action="/admin/categories" method="GET" style="display: flex; align-items: center; width: 100%; margin: 0;">
                        <i class="fas fa-search"></i>
                        <input type="text" name="search" placeholder="Search Categories" value="{{searchQuery}}">
                        {{#if searchQuery}}
                            <a href="/admin/categories" class="search-clear-btn">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {{/if}}
                    </form>
                </div>

                <button type="button" class="btn-cat" onclick="showModal('addCategoryModal')" style="white-space: nowrap;">Add category</button>
            </div>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Parent</th> 
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each categories}}
                <tr>
                    <td>{{add @root.startIndex @index 1}}</td>
                    <td><strong>{{this.name}}</strong></td>
                    <td>{{this.description}}</td>
                    <td style="color: rgb(45, 42, 42); font-weight: 700;">{{this.parentCategory.name}}</td>
                    <td>
                        {{#if this.isListed}}
                                    <span class="status-badge status-listed">Listed</span>
                                {{else}}
                                    <span class="status-badge status-unlisted">Unlisted</span>
                        {{/if}}
                    </td>
                    <td>
                        <div style="display: flex; gap: 8px; text-decoration: none;">
                           <button type="button" class="btn-edit-small" onclick="openEditModal(event, '{{this._id}}', '{{this.name}}', '{{this.description}}', '{{this.parentCategory._id}}', '{{this.childCategory}}', '{{this.offer.discountValue}}')">
                                Edit
                           </button>

                            <form action="/admin/categories/toggle-status/{{this._id}}" method="POST" style="margin: 0;">
                                <button 
                                    type="button"
                                    class="btn-unlist-small {{#if this.isListed}}active{{else}}inactive{{/if}}" 
                                    onclick="confirmToggle(this, {{this.isListed}})">
                                    {{#if this.isListed}}Unlist{{else}}List{{/if}}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{/each}} 
            </tbody>
        </table>

        {{#if categories.length}}
        <div class="pagination">
            {{#if hasPrevPage}}
                <a href="/admin/categories?page={{prevPage}}&search={{searchQuery}}" class="page-link">« Prev</a>
            {{/if}}

            <span class="page-info">Page {{currentPage}} of {{totalPages}}</span>

            {{#if hasNextPage}}
                <a href="/admin/categories?page={{nextPage}}&search={{searchQuery}}" class="page-link">Next »</a>
            {{/if}}
        </div>
        {{/if}}
    </div>
</div>
<div class="admin-toast-container"></div>

<div id="addCategoryModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h4 class="modal-title">Add Category</h4>
            <button type="button" class="modal-close-btn" onclick="closeCategoryModal()">&times;</button>
        </div>
        <form id="addCategoryForm" onsubmit="submitForm(event, '/admin/categories/add', 'addErrorContainer')">
            <div id="addErrorContainer" class="error-container"></div>
            
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Category Name</label>
                    <input type="text" name="categoryName" placeholder="e.g., Running, Casual, Boots" class="form-input">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input type="text" name="description" placeholder="Footwear for athletic activities" class="form-input">
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <!-- Added 'checked' attribute here -->
                        <input type="checkbox" id="isParentCheckboxAdd" checked onchange="toggleParentField(this.checked, 'parentCategoryWrapperAdd', 'addParentSelect')">
                        <span class="checkbox-text">Set as Parent Category</span>
                    </label>
                </div>

                <!-- Added style="display: none;" so it's hidden initially when checked -->
                <div id="parentCategoryWrapperAdd" class="parent-wrapper-add" style="display: none;">
                    <div class="parent-inner-grid">
                        <div class="form-group">
                            <label class="form-label">Parent Category</label>
                           <select id="addParentSelect" name="parentCategory" class="form-select cursor-pointer">
                             {{#each @root.parentCategories}}
                              <option value="{{this._id}}">{{this.name}}</option>
                             {{/each}}
                           </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeCategoryModal()">Cancel</button>
                <button type="submit" class="btn-submit-add">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<div id="editCategoryModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h4 class="modal-title">Edit Category</h4>
            <button type="button" class="modal-close-btn" onclick="closeEditModal()">&times;</button>
        </div>
        
        <form id="editCategoryForm" onsubmit="submitForm(event, event.target.action, 'editErrorContainer')">
            <div id="editErrorContainer" class="error-container"></div>
            
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Category Name</label>
                    <input type="text" id="editCategoryName" name="categoryName" placeholder="e.g., Running, Casual, Boots" class="form-input">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input type="text" id="editDescription" name="description" placeholder="Footwear for athletic activities" class="form-input">
                </div>
                
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="isParentCheckbox" onchange="toggleParentField(this.checked, 'parentCategoryWrapper', 'editParentCategory')">
                        <span class="checkbox-text">Set as Parent Category</span>
                    </label>
                </div>

               <div id="parentCategoryWrapper" class="parent-wrapper">
               <div class="form-group">
                  <label class="form-label">Parent Category</label>
                <select id="editParentCategory" name="parentCategory" class="form-select">
                {{#each @root.parentCategories}}
                <option value="{{this._id}}">{{this.name}}</option>
                {{/each}}
                </select>
              </div>
             </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-submit">Update Category</button>
            </div>
        </form>
    </div>
</div>


<script>
    // --- 1. MODAL CONTROLS ---
    const showModal = (id) => {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'flex';
    };

    const closeCategoryModal = () => {
        document.getElementById('addCategoryModal').style.display = 'none';
    };

    const closeEditModal = () => {
        document.getElementById('editCategoryModal').style.display = 'none';
    };

    // --- 2. UNIFIED FORM SUBMISSION ---
    async function submitForm(event, url, errorContainerId) {
        event.preventDefault();
        const form = event.target;
        const errorContainer = document.getElementById(errorContainerId);
        const data = Object.fromEntries(new FormData(form).entries());

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok) {
                const modal = form.closest('[id$="Modal"]');
                if (modal) modal.style.display = 'none';
                
                form.reset();
                showToast(result.message || 'Operation successful!');
                setTimeout(() => location.reload(), 2000);
            } else {
                errorContainer.textContent = result.message || 'Action failed.';
                errorContainer.style.display = 'block';
            }
        } catch (error) {
            errorContainer.textContent = 'Connection error. Please try again.';
            errorContainer.style.display = 'block';
        }
    }

    // --- 3. DYNAMIC UI LOGIC ---
   function openEditModal(event, id, name, description, parentId, childCat, discount) {
        if (event) event.stopPropagation();
        
        const form = document.getElementById('editCategoryForm');
        form.action = `/admin/categories/edit/${id}`;
        
        document.getElementById('editCategoryName').value = name !== 'undefined' ? name : '';
        document.getElementById('editDescription').value = description !== 'undefined' ? description : '';

        const isMainParent = (!parentId || parentId === "undefined" || parentId === "null" || parentId === "");
        
        const checkbox = document.getElementById('isParentCheckbox');
        checkbox.checked = isMainParent;
        
        toggleParentField(isMainParent, 'parentCategoryWrapper', 'editParentCategory');
        
        if (!isMainParent) {
            document.getElementById('editParentCategory').value = parentId;
        }
        
        showModal('editCategoryModal');
    }

    function toggleParentField(isParent, wrapperId, selectId) {
        const wrapper = document.getElementById(wrapperId);
        const select = document.getElementById(selectId);
        
        
        wrapper.style.display = isParent ? 'none' : 'block';
        if (isParent && select) select.value = "";
    }

    // --- 4. GLOBAL EVENT LISTENERS & HELPERS ---
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('form').forEach(form => {
            const errorContainer = form.querySelector('[id$="ErrorContainer"]');
            if (errorContainer) {
                form.addEventListener('input', () => errorContainer.style.display = 'none');
            }
        });
    });

    function showToast(message, icon = 'success') {
        Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 3000,
            didOpen: (t) => { t.style.background = '#5da9ab'; t.style.color = '#ffffff'; }
        }).fire({ icon, title: message });
    }

    async function confirmToggle(button) {
        const form = button.closest('form');
        const isListed = button.classList.contains('active');
        const actionText = isListed ? 'Unlist' : 'List';

        const result = await Swal.fire({
            title: 'Are you sure?',
            text: `Do you want to ${actionText.toLowerCase()} this category?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: isListed ? '#d33' : '#28a745',
            confirmButtonText: `Yes, ${actionText}!`,
            customClass: {
                popup: 'small-swal-popup',
                title: 'small-swal-title',
                htmlContainer: 'small-swal-text'
            }
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const data = await response.json();
                if (data.success) {
                    showToast(data.message);
                    setTimeout(() => location.reload(), 2000);
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'An unexpected error occurred.', 'error');
            }
        }
    }
</script>