<section class="sale-banner-container">
  <div class="sale-gradient-box">
    <div class="banner-content">
        <h3>Step Into Ultimate Comfort</h3>
        <p>Explore our premium collection of handcrafted footwear designed for every journey.</p>
    </div>
    <div class="banner-info-badge">
        <span class="info-dot"></span> New Arrivals
    </div>
  </div>
</section>



  <section class="best-sellers">
        <h3>Latest</h3>
        <div class="best-sellers-shelf-grid">
            {{#each bestSellers}}
               {{> product-card}}
            {{else}}
                <p>No products available right now.</p>
            {{/each}}
        </div>      
    </section>

